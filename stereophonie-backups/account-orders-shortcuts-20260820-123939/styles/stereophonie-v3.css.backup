  background: rgba(255, 255, 255, .54) !important;
}

html body
.st-account-retail__module-content
.st-account-field-shell--phone {
  grid-template-columns: minmax(150px, 185px) minmax(0, 1fr) !important;
}

html body
.st-account-retail__module-content
.st-account-field-shell--phone
> select {
  border-right: 1px solid rgba(0, 0, 0, .08) !important;
}

html body
.st-account-retail__module-content
.st-account-stock-card {
  overflow: hidden !important;
  border: 1px solid rgba(0, 0, 0, .09) !important;
  border-radius: 22px !important;
  background: #fff !important;
  box-shadow: 0 8px 28px rgba(0, 0, 0, .025) !important;
}

html body
.st-account-retail__module-content
.st-account-stock-card__status {
  min-height: 88px !important;
  background: #fafafa !important;
}

html body
.st-account-retail
.st-account-stock-switch-form {
  width: 52px !important;
  min-width: 52px !important;
  height: 32px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
  flex: 0 0 52px !important;
  line-height: 0 !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch {
  position: relative !important;
  box-sizing: border-box !important;
  width: 52px !important;
  min-width: 52px !important;
  max-width: 52px !important;
  height: 32px !important;
  min-height: 32px !important;
  max-height: 32px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
  flex: 0 0 52px !important;
  overflow: hidden !important;
  border: 0 !important;
  border-radius: 999px !important;
  appearance: none !important;
  -webkit-appearance: none !important;
  background: #d2d2d7 !important;
  color: transparent !important;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .055) !important;
  filter: none !important;
  line-height: 0 !important;
  cursor: pointer !important;
  transform: none !important;
  transition:
    background-color 220ms cubic-bezier(.22, .61, .36, 1),
    box-shadow 220ms cubic-bezier(.22, .61, .36, 1) !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch[aria-checked="true"] {
  background: #f5b335 !important;
  box-shadow:
    inset 0 0 0 1px rgba(168, 108, 0, .08),
    0 2px 8px rgba(245, 179, 53, .17) !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch[aria-checked="false"] {
  background: #d2d2d7 !important;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .055) !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch:hover {
  filter: none !important;
  transform: none !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch:focus-visible {
  outline: none !important;
  box-shadow:
    0 0 0 3px rgba(245, 179, 53, .24),
    inset 0 0 0 1px rgba(0, 0, 0, .055) !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch
> .st-account-stock-switch__thumb {
  position: absolute !important;
  top: 3px !important;
  left: 3px !important;
  width: 26px !important;
  min-width: 26px !important;
  height: 26px !important;
  min-height: 26px !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
  border: 0 !important;
  border-radius: 50% !important;
  background: #fff !important;
  box-shadow:
    0 2px 5px rgba(0, 0, 0, .2),
    0 0 1px rgba(0, 0, 0, .12) !important;
  pointer-events: none !important;
  transform: none !important;
  will-change: left !important;
  transition:
    left 250ms cubic-bezier(.22, .61, .36, 1) !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch[aria-checked="true"]
> .st-account-stock-switch__thumb {
  left: 23px !important;
  transform: none !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch[aria-checked="false"]
> .st-account-stock-switch__thumb {
  left: 3px !important;
  transform: none !important;
}

html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch::before,
html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch::after,
html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch
> .st-account-stock-switch__thumb::before,
html body
.st-account-retail
.st-account-stock-switch-form
> button.st-account-stock-switch
> .st-account-stock-switch__thumb::after {
  content: none !important;
  display: none !important;
}

html body
.st-account-retail__module-content
:is(
  .st-account-address-form,
  .st-account-address-card,
  .st-account-address-empty
) {
  overflow: hidden !important;
