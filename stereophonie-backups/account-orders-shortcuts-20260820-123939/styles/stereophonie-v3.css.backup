/* === ST PRODUCT LIGHTBOX V2 REAL START === */

[data-st-product-lightbox="true"] {
  position: fixed !important;
  inset: 0 !important;
  z-index: 999999 !important;

  width: 100vw !important;
  height: 100dvh !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background: rgba(250, 250, 251, .985) !important;

  backdrop-filter: blur(18px) saturate(105%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(105%) !important;

  animation:
    stLbEnter 220ms cubic-bezier(.22,.61,.36,1) both !important;
}

/* Main image */
[data-st-product-lightbox="true"] img {
  position: absolute !important;
  top: 50% !important;
  left: 50% !important;

  width: auto !important;
  height: auto !important;

  max-width: min(66vw, 900px) !important;
  max-height: min(72dvh, 760px) !important;

  object-fit: contain !important;

  transform: translate(-50%, -50%) !important;

  filter:
    drop-shadow(0 28px 42px rgba(20,20,22,.07)) !important;

  animation:
    stLbImageIn 280ms cubic-bezier(.22,.61,.36,1) both !important;
}

/* Product title */
[data-st-product-lightbox="true"] h2,
[data-st-product-lightbox="true"] h3 {
  position: fixed !important;
  top: 31px !important;
  left: 34px !important;

  z-index: 50 !important;

  margin: 0 !important;

  color: #1d1d1f !important;

  font-size: 14px !important;
  line-height: 1.25 !important;
  font-weight: 600 !important;
  letter-spacing: -.015em !important;
}

/* Image counter */
[data-st-product-lightbox="true"]
:is(
  [class*="counter"],
  [class*="count"],
  [class*="pagination"]
) {
  position: fixed !important;
  top: 59px !important;
  left: 34px !important;

  z-index: 52 !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  min-width: 54px !important;
  height: 28px !important;

  padding: 0 10px !important;

  border: 1px solid rgba(29,29,31,.07) !important;
  border-radius: 999px !important;

  background: rgba(255,255,255,.9) !important;

  color: rgba(29,29,31,.60) !important;

  box-shadow: 0 5px 18px rgba(0,0,0,.035) !important;

  font-size: 10px !important;
  line-height: 1 !important;
  font-weight: 600 !important;
  letter-spacing: .045em !important;
}

/* Close */
[data-st-product-lightbox="true"]
button:is(
  [aria-label*="close" i],
  [title*="close" i]
) {
  position: fixed !important;
  top: 27px !important;
  right: 30px !important;

  z-index: 80 !important;

  width: 42px !important;
  height: 42px !important;

  display: grid !important;
  place-items: center !important;

  padding: 0 !important;

  border: 1px solid rgba(29,29,31,.065) !important;
  border-radius: 50% !important;

  background: rgba(255,255,255,.95) !important;

  color: #29292c !important;

  box-shadow: 0 7px 24px rgba(29,29,31,.06) !important;

  transform: none !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="close" i],
  [title*="close" i]
):hover {
  background: #fff !important;
  border-color: rgba(245,179,53,.32) !important;
  box-shadow:
    0 7px 24px rgba(29,29,31,.06),
    0 0 0 5px rgba(245,179,53,.06) !important;
}

/* Previous */
[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i]
) {
  position: fixed !important;
  top: 50% !important;
  left: 6vw !important;

  transform: translateY(-50%) !important;
}

/* Next */
[data-st-product-lightbox="true"]
button[aria-label*="next" i] {
  position: fixed !important;
  top: 50% !important;
  right: 6vw !important;

  transform: translateY(-50%) !important;
}

/* Shared arrow design */
[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i],
  [aria-label*="next" i]
) {
  z-index: 60 !important;

  width: 44px !important;
  height: 44px !important;

  display: grid !important;
  place-items: center !important;

  padding: 0 !important;

  border: 1px solid rgba(29,29,31,.055) !important;
  border-radius: 50% !important;

  background: rgba(255,255,255,.93) !important;

  color: #29292c !important;

  box-shadow: 0 7px 24px rgba(29,29,31,.055) !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i],
  [aria-label*="next" i]
):hover {
  background: #fff !important;
  border-color: rgba(245,179,53,.30) !important;

  box-shadow:
    0 8px 26px rgba(29,29,31,.065),
    0 0 0 4px rgba(245,179,53,.05) !important;
}

/* Remove fullscreen thumbnails */
[data-st-product-lightbox="true"]
:is(
  [class*="thumbnail"],
  [class*="thumbs"]
) {
  display: none !important;
}

/* Success feedback: mustard + BLACK text */
.st-purchase-v6__message.is-success,
.st-purchase-v6__message--success,
:is(
  [class*="toast"].is-success,
  [class*="toast"][class*="success"],
  [class*="notification"].is-success,
  [class*="notification"][class*="success"]
) {
  color: #1d1d1f !important;
  background: #fff9ed !important;
  border-color: rgba(245,179,53,.52) !important;
}

.st-purchase-v6__message.is-success *,
.st-purchase-v6__message--success *,
:is(
  [class*="toast"].is-success,
  [class*="toast"][class*="success"],
  [class*="notification"].is-success,
  [class*="notification"][class*="success"]
) * {
  color: #1d1d1f !important;
  stroke: currentColor !important;
}

/* Animations */
@keyframes stLbEnter {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes stLbImageIn {
  from {
    opacity: 0;
    transform: translate(-50%, calc(-50% + 8px)) scale(.985);
  }

  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@media (max-width: 767px) {
  [data-st-product-lightbox="true"] img {
    max-width: 88vw !important;
    max-height: 68dvh !important;
  }

  [data-st-product-lightbox="true"] h2,
  [data-st-product-lightbox="true"] h3 {
    top: 20px !important;
    left: 18px !important;
  }

  [data-st-product-lightbox="true"]
  :is(
    [class*="counter"],
    [class*="count"],
    [class*="pagination"]
  ) {
    top: 48px !important;
    left: 18px !important;
  }

  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="close" i],
    [title*="close" i]
  ) {
    top: 16px !important;
    right: 16px !important;
  }

  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="previous" i],
    [aria-label*="prev" i]
  ) {
    left: 14px !important;
  }

  [data-st-product-lightbox="true"]
  button[aria-label*="next" i] {
    right: 14px !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-st-product-lightbox="true"],
  [data-st-product-lightbox="true"] img {
    animation: none !important;
  }
}

/* === ST PRODUCT LIGHTBOX V2 REAL END === */

/* === ST MINIMAL LIGHTBOX V3 START === */


/* =========================================================
   MINIMAL PRODUCT FULLSCREEN VIEWER

   Layout:
   - clean fullscreen canvas
   - centered product
   - title below image
   - counter below title
   - subtle navigation
   - no top-left metadata
   ========================================================= */


/* ---------------------------------------------------------
   1. FULLSCREEN FOUNDATION
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] {
  position: fixed !important;
  inset: 0 !important;

  z-index: 999999 !important;

  width: 100vw !important;
  height: 100dvh !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden !important;

  background:
    rgba(250, 250, 251, 0.985) !important;

  backdrop-filter:
    blur(18px)
    saturate(108%) !important;

  -webkit-backdrop-filter:
    blur(18px)
    saturate(108%) !important;

  color: #1d1d1f !important;

  isolation: isolate !important;

  animation:
    stMinimalViewerEnter
    260ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}


/* ---------------------------------------------------------
   2. REMOVE OLD TOP-LEFT ARCHITECTURE

   The existing lightbox header is preserved because it
   contains the useful product name/counter.

   We simply move the entire header underneath the image.
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] > header {
  position: fixed !important;

  left: 50% !important;
  bottom: clamp(26px, 4.8vh, 54px) !important;
  top: auto !important;
  right: auto !important;

  z-index: 80 !important;

  width: auto !important;
  max-width: min(760px, calc(100vw - 160px)) !important;

  margin: 0 !important;
  padding: 0 !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;

  gap: 7px !important;

  transform:
    translateX(-50%) !important;

  text-align: center !important;

  background: transparent !important;

  border: 0 !important;

  box-shadow: none !important;

  pointer-events: none !important;
}


/*
 * Kill old decorative dots/lines that belonged to the
 * previous top-left metadata architecture.
 */
[data-st-product-lightbox="true"] > header i,
[data-st-product-lightbox="true"] > header::before,
[data-st-product-lightbox="true"] > header::after {
  display: none !important;
  content: none !important;
}


/* ---------------------------------------------------------
   3. PRODUCT NAME
   --------------------------------------------------------- */

/*
 * Product-name text in the lightbox header receives the
 * strongest visual hierarchy.
 */

[data-st-product-lightbox="true"] > header
:is(
  h1,
  h2,
  h3,
  strong,
  b
) {
  order: 1 !important;

  display: block !important;

  margin: 0 !important;
  padding: 0 !important;

  color: #1d1d1f !important;

  font-size:
    clamp(14px, 1.05vw, 17px) !important;

  line-height: 1.2 !important;

  font-weight: 600 !important;

  letter-spacing:
    -0.025em !important;

  text-transform: none !important;

  background: transparent !important;

  border: 0 !important;

  box-shadow: none !important;
}


/*
 * Some versions of the gallery put the title inside a
 * simple <span>. We style non-counter text accordingly.
 */
[data-st-product-lightbox="true"] > header
span:not(
  [class*="counter"]
):not(
  [class*="count"]
):not(
  [class*="index"]
) {
  color: #1d1d1f !important;
}


/* ---------------------------------------------------------
   4. PHOTO COUNTER
   --------------------------------------------------------- */

/*
 * Counter becomes a tiny, quiet second line under the name.
 */

[data-st-product-lightbox="true"] > header
:is(
  [class*="counter"],
  [class*="count"],
  [class*="index"]
) {
  order: 2 !important;

  position: static !important;

  display: block !important;

  width: auto !important;
  min-width: 0 !important;
  height: auto !important;

  margin: 0 !important;
  padding: 0 !important;

  color:
    rgba(29, 29, 31, .46) !important;

  background: transparent !important;

  border: 0 !important;

  border-radius: 0 !important;

  box-shadow: none !important;

  font-size: 11px !important;

  line-height: 1.2 !important;

  font-weight: 500 !important;

  letter-spacing:
    .035em !important;
}


/* ---------------------------------------------------------
   5. FALLBACK FOR CURRENT HEADER STRUCTURE

   Your screenshot proves the old counter and product name
   are currently rendered as the first two textual items.

   These rules ensure the first line becomes the counter and
   the second becomes the product name, but visually reorder
   them so NAME comes first and COUNTER underneath.
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] > header > div {
  display: contents !important;
}


[data-st-product-lightbox="true"] > header > :first-child {
  order: 2 !important;
}


[data-st-product-lightbox="true"] > header > :nth-child(2) {
  order: 1 !important;
}


/*
 * Small/plain first item = counter
 */
[data-st-product-lightbox="true"] > header > :first-child {
  color:
    rgba(29,29,31,.46) !important;

  font-size: 11px !important;

  line-height: 1.2 !important;

  font-weight: 500 !important;

  letter-spacing:
    .035em !important;

  margin: 0 !important;
}


/*
 * Second item = product name
 */
[data-st-product-lightbox="true"] > header > :nth-child(2) {
  color: #1d1d1f !important;

  font-size:
    clamp(14px, 1vw, 17px) !important;

  line-height: 1.2 !important;

  font-weight: 600 !important;

  letter-spacing:
    -.025em !important;

  margin: 0 !important;
}


/* ---------------------------------------------------------
   6. PRODUCT IMAGE
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] img {
  position: absolute !important;

  top: 47% !important;
  left: 50% !important;

  width: auto !important;
  height: auto !important;

  max-width:
    min(65vw, 880px) !important;

  max-height:
    min(68dvh, 720px) !important;

  object-fit: contain !important;

  object-position: center !important;

  margin: 0 !important;

  transform:
    translate(-50%, -50%) !important;

  filter:
    drop-shadow(
      0 28px 55px
      rgba(20,20,22,.065)
    ) !important;

  animation:
    stMinimalViewerImageEnter
    340ms
    cubic-bezier(.22,.61,.36,1)
    both !important;

  user-select: none !important;

  -webkit-user-drag: none !important;
}


/* ---------------------------------------------------------
   7. CLOSE BUTTON
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="close" i],
  [title*="close" i]
) {
  position: fixed !important;

  top: 28px !important;
  right: 30px !important;

  z-index: 100 !important;

  width: 42px !important;
  height: 42px !important;

  display: grid !important;
  place-items: center !important;

  padding: 0 !important;

  color: #303033 !important;

  background:
    rgba(255,255,255,.90) !important;

  border:
    1px solid
    rgba(29,29,31,.07) !important;

  border-radius: 50% !important;

  box-shadow:
    0 8px 26px
    rgba(29,29,31,.055) !important;

  transform: none !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}


[data-st-product-lightbox="true"]
button:is(
  [aria-label*="close" i],
  [title*="close" i]
):hover {
  transform: none !important;

  background: #fff !important;

  border-color:
    rgba(245,179,53,.36) !important;

  box-shadow:
    0 8px 26px rgba(29,29,31,.06),
    0 0 0 5px rgba(245,179,53,.065) !important;
}


/* ---------------------------------------------------------
   8. PREVIOUS / NEXT
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i],
  [aria-label*="next" i]
) {
  position: fixed !important;

  top: 47% !important;

  z-index: 90 !important;

  width: 42px !important;
  height: 42px !important;

  display: grid !important;
  place-items: center !important;

  padding: 0 !important;

  color:
    rgba(29,29,31,.78) !important;

  background:
    rgba(255,255,255,.88) !important;

  border:
    1px solid
    rgba(29,29,31,.055) !important;

  border-radius:
    50% !important;

  box-shadow:
    0 8px 24px
    rgba(29,29,31,.05) !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}


[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i]
) {
  left:
    clamp(26px, 6vw, 92px) !important;

  transform:
    translateY(-50%) !important;
}


[data-st-product-lightbox="true"]
button[aria-label*="next" i] {
  right:
    clamp(26px, 6vw, 92px) !important;

  transform:
    translateY(-50%) !important;
}


[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i],
  [aria-label*="next" i]
):hover {
  background: #fff !important;

  border-color:
    rgba(245,179,53,.28) !important;

  box-shadow:
    0 8px 24px rgba(29,29,31,.06),
    0 0 0 4px rgba(245,179,53,.05) !important;
}


/*
 * Absolutely forbid the arrows from jumping when hovered.
 */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="previous" i],
  [aria-label*="prev" i]
):hover {
  transform:
    translateY(-50%) !important;
}


[data-st-product-lightbox="true"]
button[aria-label*="next" i]:hover {
  transform:
    translateY(-50%) !important;
}


/* ---------------------------------------------------------
   9. REMOVE THUMBNAILS INSIDE FULLSCREEN MODE
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
:is(
  [class*="thumb"],
  [class*="thumbnail"]
) {
  display: none !important;
}


/* ---------------------------------------------------------
   10. ENTRANCE ANIMATION
   --------------------------------------------------------- */

@keyframes stMinimalViewerEnter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}


@keyframes stMinimalViewerImageEnter {
  from {
    opacity: 0;

    transform:
      translate(
        -50%,
        calc(-50% + 10px)
      )
      scale(.985);
  }

  to {
    opacity: 1;

    transform:
      translate(-50%, -50%)
      scale(1);
  }
}


/* ---------------------------------------------------------
   11. MOBILE
   --------------------------------------------------------- */

@media (max-width: 767px) {

  [data-st-product-lightbox="true"] img {
    top: 45% !important;

    max-width:
      87vw !important;

    max-height:
      62dvh !important;
  }


  [data-st-product-lightbox="true"] > header {
    bottom: 30px !important;

    max-width:
      calc(100vw - 70px) !important;
  }


  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="close" i],
    [title*="close" i]
  ) {
    top: 16px !important;
    right: 16px !important;
  }


  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="previous" i],
    [aria-label*="prev" i]
  ) {
    left: 14px !important;
  }


  [data-st-product-lightbox="true"]
  button[aria-label*="next" i] {
    right: 14px !important;
  }
}


/* ---------------------------------------------------------
   12. ACCESSIBILITY
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  [data-st-product-lightbox="true"],
  [data-st-product-lightbox="true"] img {
    animation: none !important;
  }

}


/* === ST MINIMAL LIGHTBOX V3 END === */

/* === ST MODERN PRODUCT GALLERY START === */

/*
 * Stereophonie product gallery.
 *
 * Deliberately uses a new namespace so archived product-gallery
 * CSS cannot control this component.
 *
 * No fullscreen viewer.
 * No thumbnails.
 * No image arrows.
 * No View Larger button.
 */

.st-pg-modern {
  --st-gallery-mustard: #f5b335;
  --st-gallery-ink: #1d1d1f;
  --st-gallery-muted: #b8b8bd;
  --st-gallery-bg: #f5f5f7;
  --st-gallery-ease: cubic-bezier(.22, .61, .36, 1);

  width: 100%;
  min-width: 0;

  outline: none;
}

.st-pg-modern__viewport {
  position: relative;

  width: 100%;
  min-height: clamp(520px, 62vw, 720px);

  display: grid;
  place-items: center;

  overflow: hidden;

  border-radius: 30px;

  background:
    linear-gradient(
      180deg,
      #f7f7f9 0%,
      var(--st-gallery-bg) 100%
    );

  isolation: isolate;
}

.st-pg-modern__stage {
  width: 100%;
  height: 100%;
  min-height: inherit;

  display: grid;
  place-items: center;

  padding:
    clamp(44px, 6vw, 84px)
    clamp(28px, 6vw, 80px)
    clamp(94px, 10vw, 124px);

  animation:
    stModernGalleryImageIn
    420ms
    var(--st-gallery-ease)
    both;
}

.st-pg-modern__image {
  display: block;

  width: auto;
  height: auto;

  max-width: min(72%, 680px);
  max-height: clamp(390px, 50vw, 570px);

  object-fit: contain;

  user-select: none;
  -webkit-user-drag: none;

  transform: translateZ(0);

  filter:
    drop-shadow(
      0 24px 40px
      rgba(0, 0, 0, .045)
    );
}

/* --------------------------------------------------------
   APPLE-INSPIRED CENTERED IMAGE SELECTOR
   -------------------------------------------------------- */

.st-pg-modern__pagination {
  position: absolute;

  left: 50%;
  bottom: 26px;

  transform: translateX(-50%);

  z-index: 4;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 44px;

  padding: 8px 13px;

  border:
    1px solid
    rgba(0, 0, 0, .055);

  border-radius: 999px;

  background:
    rgba(255, 255, 255, .82);

  box-shadow:
    0 10px 30px
    rgba(0, 0, 0, .055);

  -webkit-backdrop-filter:
    blur(18px);

  backdrop-filter:
    blur(18px);
}

.st-pg-modern__dot {
  appearance: none;

  width: 16px;
  height: 28px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  margin: 0;
  padding: 0;

  border: 0;

  border-radius: 999px;

  background: transparent;

  cursor: pointer;

  outline: none;

  transition:
    width 320ms var(--st-gallery-ease),
    opacity 220ms ease,
    background-color 220ms ease;
}

.st-pg-modern__dot > span {
  display: block;

  width: 7px;
  height: 7px;

  border-radius: 999px;

  background:
    var(--st-gallery-muted);

  transition:
    width 320ms var(--st-gallery-ease),
    height 320ms var(--st-gallery-ease),
    background-color 260ms ease,
    box-shadow 260ms ease,
    transform 260ms var(--st-gallery-ease);
}

.st-pg-modern__dot.is-active {
  width: 48px;
}

.st-pg-modern__dot.is-active > span {
  width: 40px;
  height: 7px;

  background:
    var(--st-gallery-mustard);

  box-shadow:
    0 0 0 1px
      rgba(245, 179, 53, .08),
    0 4px 12px
      rgba(245, 179, 53, .18);
}

.st-pg-modern__dot:not(.is-active):hover > span {
  background:
    #8f8f95;

  transform:
    scale(1.12);
}

.st-pg-modern__dot:focus-visible {
  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .20);
}

/* --------------------------------------------------------
   IMAGE CHANGE
   -------------------------------------------------------- */

@keyframes stModernGalleryImageIn {
  0% {
    opacity: 0;
    transform:
      translate3d(12px, 0, 0)
      scale(.992);
  }

  100% {
    opacity: 1;
    transform:
      translate3d(0, 0, 0)
      scale(1);
  }
}

/* --------------------------------------------------------
   EMPTY STATE
   -------------------------------------------------------- */

.st-pg-modern--empty {
  min-height: 520px;

  display: grid;
  place-items: center;

  border-radius: 30px;

  background:
    var(--st-gallery-bg);

  color:
    #8a8a8f;

  font-size: 14px;
}

/* --------------------------------------------------------
   MOBILE
   -------------------------------------------------------- */

@media (max-width: 900px) {
  .st-pg-modern__viewport {
    min-height:
      min(132vw, 610px);

    border-radius: 24px;
  }

  .st-pg-modern__stage {
    padding:
      34px
      20px
      90px;
  }

  .st-pg-modern__image {
    max-width: 84%;
    max-height: 470px;
  }

  .st-pg-modern__pagination {
    bottom: 20px;

    min-height: 42px;

    padding:
      7px 11px;
  }
}

@media (max-width: 560px) {
  .st-pg-modern__viewport {
    min-height:
      min(138vw, 540px);

    border-radius: 20px;
  }

  .st-pg-modern__image {
    max-width: 90%;
    max-height: 400px;
  }

  .st-pg-modern__dot.is-active {
    width: 42px;
  }

  .st-pg-modern__dot.is-active > span {
    width: 34px;
  }
}

/*
 * We intentionally keep this one micro-animation.
 * It is an in-gallery image change, not a route/page transition.
 */
@media (prefers-reduced-motion: reduce) {
  .st-pg-modern__stage {
    animation: none;
  }

  .st-pg-modern__dot,
  .st-pg-modern__dot > span {
    transition: none;
  }
}

/* === ST MODERN PRODUCT GALLERY END === */


/* === ST PREMIUM CAROUSEL MOTION START === */

/* ========================================================
   PREMIUM IMAGE TRANSITION
   ======================================================== */

.st-pg-modern__stage {
  position: relative !important;

  overflow: hidden !important;

  animation: none !important;
}

.st-pg-modern__stage .st-pg-modern__image {
  position: absolute !important;

  inset: 0 !important;

  margin: auto !important;

  will-change:
    transform,
    opacity,
    filter;

  backface-visibility:
    hidden;

  -webkit-backface-visibility:
    hidden;

  transform-origin:
    50% 50%;
}

/*
 * Normal resting image.
 */
.st-pg-modern__image--incoming {
  opacity: 1;

  transform:
    translate3d(0, 0, 0)
    scale(1);
}

/*
 * NEW image arriving from the right.
 */
.st-pg-modern__image--incoming.is-transitioning.is-next {
  animation:
    stPgPremiumEnterNext
    520ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}

/*
 * NEW image arriving from the left.
 */
.st-pg-modern__image--incoming.is-transitioning.is-previous {
  animation:
    stPgPremiumEnterPrevious
    520ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}

/*
 * OLD image leaving toward the left.
 */
.st-pg-modern__image--outgoing.is-next {
  animation:
    stPgPremiumExitNext
    520ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}

/*
 * OLD image leaving toward the right.
 */
.st-pg-modern__image--outgoing.is-previous {
  animation:
    stPgPremiumExitPrevious
    520ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}

@keyframes stPgPremiumEnterNext {
  0% {
    opacity: 0;

    transform:
      translate3d(44px, 0, 0)
      scale(.985);

    filter:
      blur(2px);
  }

  55% {
    opacity: 1;
  }

  100% {
    opacity: 1;

    transform:
      translate3d(0, 0, 0)
      scale(1);

    filter:
      blur(0);
  }
}

@keyframes stPgPremiumExitNext {
  0% {
    opacity: 1;

    transform:
      translate3d(0, 0, 0)
      scale(1);
  }

  100% {
    opacity: 0;

    transform:
      translate3d(-34px, 0, 0)
      scale(.99);
  }
}

@keyframes stPgPremiumEnterPrevious {
  0% {
    opacity: 0;

    transform:
      translate3d(-44px, 0, 0)
      scale(.985);

    filter:
      blur(2px);
  }

  55% {
    opacity: 1;
  }

  100% {
    opacity: 1;

    transform:
      translate3d(0, 0, 0)
      scale(1);

    filter:
      blur(0);
  }
}

@keyframes stPgPremiumExitPrevious {
  0% {
    opacity: 1;

    transform:
      translate3d(0, 0, 0)
      scale(1);
  }

  100% {
    opacity: 0;

    transform:
      translate3d(34px, 0, 0)
      scale(.99);
  }
}


/* ========================================================
   TRAVELLING APPLE-INSPIRED PAGINATION
   ======================================================== */

/*
 * Each position is 23px:
 *
 * 15px button + 8px gap.
 *
 * The mustard capsule moves physically from one position
 * to another rather than each dot morphing independently.
 */

.st-pg-modern__pagination {
  --st-dot-width: 15px;
  --st-dot-gap: 8px;
  --st-dot-step:
    calc(
      var(--st-dot-width)
      + var(--st-dot-gap)
    );

  position: absolute !important;

  display: flex !important;

  gap:
    var(--st-dot-gap) !important;

  padding:
    8px 13px !important;

  overflow: visible !important;
}

/*
 * Real moving mustard selection capsule.
 */
.st-pg-modern__active-track {
  position: absolute;

  top: 50%;
  left: 13px;

  width: 15px;
  height: 7px;

  border-radius: 999px;

  background:
    #f5b335;

  box-shadow:
    0 4px 14px
      rgba(245, 179, 53, .24);

  pointer-events: none;

  z-index: 0;

  transform:
    translate3d(
      calc(
        var(--st-gallery-index)
        * var(--st-dot-step)
      ),
      -50%,
      0
    );

  transition:
    transform
      440ms
      cubic-bezier(.22, .61, .36, 1),
    width
      320ms
      cubic-bezier(.22, .61, .36, 1),
    box-shadow
      300ms
      ease;

  will-change:
    transform;
}

/*
 * Active selector stretches slightly during motion,
 * making it feel more fluid rather than mechanical.
 */
.st-pg-modern__pagination:active
.st-pg-modern__active-track {
  width: 19px;
}

/*
 * Buttons stay fixed in place.
 */
.st-pg-modern__dot,
.st-pg-modern__dot.is-active {
  position: relative;

  width:
    var(--st-dot-width) !important;

  height: 28px !important;

  z-index: 1;

  transition:
    opacity 220ms ease !important;
}

/*
 * All real dots remain small gray points.
 * The moving mustard layer sits over the active position.
 */
.st-pg-modern__dot > span,
.st-pg-modern__dot.is-active > span {
  width: 7px !important;
  height: 7px !important;

  background:
    #b8b8bd !important;

  box-shadow:
    none !important;

  transform:
    none !important;

  transition:
    background-color 260ms ease,
    opacity 260ms ease,
    transform 260ms
      cubic-bezier(.22, .61, .36, 1) !important;
}

/*
 * Hide the gray dot currently under the mustard capsule.
 */
.st-pg-modern__dot[aria-current="true"] > span {
  opacity: 0;
}

/*
 * Elegant pointer feedback without moving layout.
 */
.st-pg-modern__dot:not([aria-current="true"]):hover > span {
  background:
    #8a8a8f !important;

  transform:
    scale(1.18) !important;
}


/* ========================================================
   MICRO POLISH
   ======================================================== */

.st-pg-modern__viewport {
  contain:
    layout paint;

  transform:
    translateZ(0);
}

.st-pg-modern__image {
  transition:
    none !important;
}


/* ========================================================
   REDUCED MOTION
   ======================================================== */

@media (prefers-reduced-motion: reduce) {
  .st-pg-modern__image--incoming,
  .st-pg-modern__image--outgoing {
    animation:
      none !important;
  }

  .st-pg-modern__active-track {
    transition:
      none !important;
  }
}

/* === ST PREMIUM CAROUSEL MOTION END === */


/* === ST CENTERED PRODUCT SUCCESS TOAST START === */

/*
 * Product-page feedback notification.
 *
 * Important:
 * - bottom CENTER, never bottom-right
 * - black text
 * - mustard success identity
 * - no green inherited from older versions
 */

[data-st-product-message="success"] {
  position: fixed !important;

  left: 50% !important;
  right: auto !important;

  top: auto !important;
  bottom: 24px !important;

  width: max-content !important;
  min-width: 0 !important;

  max-width:
    min(
      620px,
      calc(100vw - 40px)
    ) !important;

  margin: 0 !important;

  padding:
    14px 20px !important;

  display: flex !important;

  align-items: center !important;
  justify-content: center !important;

  gap: 11px !important;

  color:
    #1d1d1f !important;

  background:
    rgba(255, 249, 232, .97) !important;

  border:
    1px solid
    rgba(245, 179, 53, .72) !important;

  border-radius:
    14px !important;

  box-shadow:
    0 12px 34px
      rgba(29, 29, 31, .10),
    0 3px 10px
      rgba(245, 179, 53, .10) !important;

  transform:
    translate3d(-50%, 0, 0) !important;

  font-size:
    14px !important;

  font-weight:
    500 !important;

  line-height:
    1.35 !important;

  text-align:
    center !important;

  white-space:
    normal !important;

  z-index:
    2147483000 !important;

  -webkit-font-smoothing:
    antialiased;

  animation:
    stProductToastEnter
    260ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}


/* --------------------------------------------------------
   FORCE SUCCESS TEXT TO BLACK
   -------------------------------------------------------- */

[data-st-product-message="success"],
[data-st-product-message="success"] *,
[data-st-product-message="success"] p,
[data-st-product-message="success"] span,
[data-st-product-message="success"] strong {
  color:
    #1d1d1f !important;

  -webkit-text-fill-color:
    #1d1d1f !important;
}


/* --------------------------------------------------------
   REMOVE OLD GREEN SUCCESS ICON COLOR
   -------------------------------------------------------- */

[data-st-product-message="success"] svg {
  color:
    #1d1d1f !important;

  stroke:
    currentColor !important;
}

[data-st-product-message="success"] svg path,
[data-st-product-message="success"] svg circle,
[data-st-product-message="success"] svg polyline,
[data-st-product-message="success"] svg line {
  stroke:
    currentColor !important;
}


/* If an older implementation uses a colored indicator/dot. */

[data-st-product-message="success"] i,
[data-st-product-message="success"]::before {
  color:
    #1d1d1f !important;

  border-color:
    #f5b335 !important;
}


/* --------------------------------------------------------
   SUBTLE ENTRANCE
   -------------------------------------------------------- */

@keyframes stProductToastEnter {
  0% {
    opacity: 0;

    transform:
      translate3d(
        -50%,
        8px,
        0
      );
  }

  100% {
    opacity: 1;

    transform:
      translate3d(
        -50%,
        0,
        0
      );
  }
}


/* --------------------------------------------------------
   MOBILE
   -------------------------------------------------------- */

@media (max-width: 700px) {
  [data-st-product-message="success"] {
    bottom:
      18px !important;

    width:
      calc(100vw - 28px) !important;

    max-width:
      calc(100vw - 28px) !important;

    padding:
      13px 16px !important;

    font-size:
      13px !important;

    border-radius:
      12px !important;
  }
}


/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  [data-st-product-message="success"] {
    animation:
      none !important;
  }
}

/* === ST CENTERED PRODUCT SUCCESS TOAST END === */

/* === ST REAL PDP COMPACT FINAL START === */

/*
   ==========================================================
   STEREOPHONIE
   CANONICAL PRODUCT PAGE HERO / GALLERY LAYER

   Targets the ACTUAL live product page architecture:
   .st-product-v5
   .st-product-v5__intro
   .st-product-v5__intro-meta
   .st-product-v5__price
   .st-product-v5__availability
   .st-product-v5__gallery
   .st-pg-modern
   .st-pg-modern__viewport
   .st-pg-modern__stage
   .st-pg-modern__image

   This deliberately appears at the END of the stylesheet so
   old product-page generations cannot take visual authority.
   ==========================================================
*/


/* ----------------------------------------------------------
   1. PRODUCT PAGE FOUNDATION
   ---------------------------------------------------------- */

.st-product-v5 {
  background:
    #ffffff !important;

  color:
    #1d1d1f !important;
}


.st-product-v5__shell {
  width:
    min(
      calc(100% - 48px),
      1120px
    ) !important;

  margin-inline:
    auto !important;
}


/* ----------------------------------------------------------
   2. BREADCRUMB
   Less empty vertical space above the actual product.
   ---------------------------------------------------------- */

.st-product-v5__breadcrumb {
  padding:
    20px 0 14px !important;

  margin:
    0 !important;

  font-size:
    11px !important;

  line-height:
    1.4 !important;

  color:
    #86868b !important;
}


/* ----------------------------------------------------------
   3. LIVE PRODUCT INTRO
   THIS is the active title architecture.
   ---------------------------------------------------------- */

.st-product-v5__intro {
  display:
    grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    auto !important;

  align-items:
    end !important;

  gap:
    40px !important;

  padding:
    24px 0 25px !important;

  margin:
    0 !important;

  border-bottom:
    1px solid
    rgba(29, 29, 31, .08) !important;
}


/* Brand / category eyebrow */

.st-product-v5__category {
  display:
    block !important;

  margin:
    0 0 11px !important;

  color:
    #86868b !important;

  font-size:
    12px !important;

  line-height:
    1.35 !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;
}


/* ACTUAL active product name */

.st-product-v5__intro h1 {
  max-width:
    720px !important;

  margin:
    0 !important;

  color:
    #1d1d1f !important;

  font-size:
    clamp(
      36px,
      3.2vw,
      48px
    ) !important;

  line-height:
    .98 !important;

  font-weight:
    650 !important;

  letter-spacing:
    -.047em !important;
}


/* ----------------------------------------------------------
   4. PRICE + AVAILABILITY
   Smaller, cleaner and subordinate to product name.
   ---------------------------------------------------------- */

.st-product-v5__intro-meta {
  min-width:
    170px !important;

  display:
    flex !important;

  flex-direction:
    column !important;

  align-items:
    flex-end !important;

  justify-content:
    flex-end !important;

  gap:
    13px !important;

  padding-bottom:
    2px !important;

  text-align:
    right !important;
}


.st-product-v5__price {
  display:
    flex !important;

  align-items:
    baseline !important;

  justify-content:
    flex-end !important;

  gap:
    9px !important;

  margin:
    0 !important;
}


.st-product-v5__price strong {
  color:
    #1d1d1f !important;

  font-size:
    clamp(
      25px,
      2.05vw,
      31px
    ) !important;

  line-height:
    1 !important;

  font-weight:
    650 !important;

  letter-spacing:
    -.035em !important;
}


.st-product-v5__price del {
  color:
    #86868b !important;

  font-size:
    13px !important;

  line-height:
    1 !important;
}


.st-product-v5__availability {
  display:
    inline-flex !important;

  align-items:
    center !important;

  justify-content:
    flex-end !important;

  gap:
    7px !important;

  margin:
    0 !important;

  color:
    #9a6700 !important;

  font-size:
    11px !important;

  line-height:
    1.3 !important;

  font-weight:
    500 !important;
}


.st-product-v5__availability i {
  width:
    6px !important;

  height:
    6px !important;

  flex:
    0 0 6px !important;

  border-radius:
    999px !important;

  background:
    #f5b335 !important;

  border:
    0 !important;

  box-shadow:
    0 0 0 4px
    rgba(245, 179, 53, .11) !important;
}


/* ----------------------------------------------------------
   5. GALLERY WRAPPER
   Smaller overall product-photo section.
   ---------------------------------------------------------- */

.st-product-v5__gallery {
  margin:
    28px 0 0 !important;

  padding:
    0 !important;
}


.st-product-v5__gallery .st-pg-modern {
  width:
    100% !important;

  margin:
    0 !important;
}


/*
   IMPORTANT:
   The ACTUAL external gallery height comes from viewport.
   Previous attempts styled only stage, which allowed the
   viewport's old min-height to keep the section enormous.
*/

.st-product-v5__gallery
.st-pg-modern__viewport {
  position:
    relative !important;

  width:
    100% !important;

  height:
    520px !important;

  min-height:
    0 !important;

  max-height:
    520px !important;

  overflow:
    hidden !important;

  border-radius:
    28px !important;

  background:
    #f5f5f7 !important;

  contain:
    layout paint !important;
}


/* The animated internal stage follows the viewport exactly. */

.st-product-v5__gallery
.st-pg-modern__stage {
  width:
    100% !important;

  height:
    100% !important;

  min-height:
    0 !important;

  max-height:
    none !important;

  padding:
    28px 34px 62px !important;

  display:
    grid !important;

  place-items:
    center !important;

  overflow:
    hidden !important;

  border-radius:
    inherit !important;
}


/* ----------------------------------------------------------
   6. PRODUCT IMAGE
   Keep carousel transform ownership untouched.
   ---------------------------------------------------------- */

.st-product-v5__gallery
.st-pg-modern__image {
  width:
    auto !important;

  height:
    auto !important;

  max-width:
    min(
      55%,
      490px
    ) !important;

  max-height:
    390px !important;

  object-fit:
    contain !important;

  margin:
    auto !important;

  background:
    transparent !important;
}


/* ----------------------------------------------------------
   7. APPLE-STYLE IMAGE SELECTOR
   Preserve all carousel logic and animation.
   ---------------------------------------------------------- */

.st-product-v5__gallery
.st-pg-modern__pagination {
  left:
    50% !important;

  right:
    auto !important;

  bottom:
    18px !important;

  z-index:
    5 !important;
}


/* ----------------------------------------------------------
   8. LARGE DESKTOP
   Do not let big displays inflate the hero again.
   ---------------------------------------------------------- */

@media (min-width: 1280px) {

  .st-product-v5__gallery
  .st-pg-modern__viewport {
    height:
      520px !important;

    max-height:
      520px !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__image {
    max-width:
      470px !important;

    max-height:
      380px !important;
  }

}


/* ----------------------------------------------------------
   9. TABLET
   ---------------------------------------------------------- */

@media (
  min-width: 769px
)
and (
  max-width: 1024px
) {

  .st-product-v5__shell {
    width:
      min(
        calc(100% - 36px),
        1120px
      ) !important;
  }


  .st-product-v5__intro {
    gap:
      24px !important;
  }


  .st-product-v5__intro h1 {
    font-size:
      clamp(
        33px,
        4.4vw,
        43px
      ) !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__viewport {
    height:
      470px !important;

    max-height:
      470px !important;

    border-radius:
      24px !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__image {
    max-width:
      min(
        62%,
        440px
      ) !important;

    max-height:
      350px !important;
  }

}


/* ----------------------------------------------------------
   10. MOBILE
   Responsive and intentionally less aggressive.
   ---------------------------------------------------------- */

@media (max-width: 768px) {

  .st-product-v5__shell {
    width:
      calc(100% - 28px) !important;
  }


  .st-product-v5__breadcrumb {
    padding:
      16px 0 12px !important;
  }


  .st-product-v5__intro {
    grid-template-columns:
      1fr !important;

    align-items:
      start !important;

    gap:
      18px !important;

    padding:
      18px 0 21px !important;
  }


  .st-product-v5__intro h1 {
    font-size:
      clamp(
        32px,
        10vw,
        42px
      ) !important;
  }


  .st-product-v5__intro-meta {
    min-width:
      0 !important;

    width:
      100% !important;

    align-items:
      flex-start !important;

    text-align:
      left !important;

    gap:
      10px !important;
  }


  .st-product-v5__price {
    justify-content:
      flex-start !important;
  }


  .st-product-v5__availability {
    justify-content:
      flex-start !important;
  }


  .st-product-v5__gallery {
    margin-top:
      20px !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__viewport {
    height:
      min(
        118vw,
        500px
      ) !important;

    min-height:
      360px !important;

    max-height:
      500px !important;

    border-radius:
      21px !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__stage {
    padding:
      22px 18px 58px !important;
  }


  .st-product-v5__gallery
  .st-pg-modern__image {
    max-width:
      84% !important;

    max-height:
      72% !important;
  }

}


/* === ST REAL PDP COMPACT FINAL END === */

/* === ST APPLE HEADER MOTION V3 START === */

/*
   =========================================================
   STEREOPHONIE — HEADER REVEAL SYSTEM

   Motion model:
   CLOSED
       panel lives directly under header, vertically clipped

   OPEN
       clip grows downward
       panel settles down a few pixels
       opacity becomes fully visible

   CATEGORY SWITCH
       outer panel remains physically stable
       only inner content changes softly

   CLOSE
       exact reverse:
       panel retracts upward into header

   No bounce.
   No large scaling.
   No gaming-style movement.
   =========================================================
*/

:root {
  --st-header-open-duration: 390ms;
  --st-header-close-duration: 420ms;

  --st-header-reveal-ease:
    cubic-bezier(.22, .61, .36, 1);

  --st-header-close-ease:
    cubic-bezier(.32, 0, .18, 1);
}


/* =========================================================
   1. MEGA MENU ROOT
   ========================================================= */

.st3-header .st3-mega {
  /*
   * clip-path is what creates the actual top-to-bottom
   * reveal instead of making the panel merely "fade".
   */

  transform-origin:
    top center !important;

  overflow:
    hidden !important;

  will-change:
    clip-path,
    opacity,
    transform !important;

  backface-visibility:
    hidden !important;

  -webkit-backface-visibility:
    hidden !important;

  /*
   * Starting position — tucked slightly into the header.
   */

  opacity:
    0 !important;

  clip-path:
    inset(0 0 100% 0) !important;

  transform:
    translate3d(0, -12px, 0) !important;

  transition:
    clip-path
      var(--st-header-close-duration)
      var(--st-header-close-ease),
    transform
      var(--st-header-close-duration)
      var(--st-header-close-ease),
    opacity
      260ms
      ease,
    visibility
      0s
      linear
      var(--st-header-close-duration)
      !important;
}


/* =========================================================
   2. OPEN
   Panel visibly unfolds DOWN from the header.
   ========================================================= */

.st3-header .st3-mega.st3-mega--open {
  visibility:
    visible !important;

  pointer-events:
    auto !important;

  opacity:
    1 !important;

  clip-path:
    inset(0 0 0 0) !important;

  transform:
    translate3d(0, 0, 0) !important;

  transition:
    clip-path
      var(--st-header-open-duration)
      var(--st-header-reveal-ease),
    transform
      var(--st-header-open-duration)
      var(--st-header-reveal-ease),
    opacity
      260ms
      ease,
    visibility
      0s
      linear
      0s
      !important;
}


/* =========================================================
   3. CLOSING
   Keep it rendered while it retracts UP into the header.
   ========================================================= */

.st3-header .st3-mega.st3-mega--closing {
  visibility:
    visible !important;

  pointer-events:
    none !important;

  opacity:
    0 !important;

  clip-path:
    inset(0 0 100% 0) !important;

  transform:
    translate3d(0, -12px, 0) !important;

  transition:
    clip-path
      var(--st-header-close-duration)
      var(--st-header-close-ease),
    transform
      var(--st-header-close-duration)
      var(--st-header-close-ease),
    opacity
      300ms
      ease,
    visibility
      0s
      linear
      var(--st-header-close-duration)
      !important;
}


/* =========================================================
   4. CLOSED
   Completely inert after retract animation completes.
   ========================================================= */

.st3-header .st3-mega.st3-mega--closed {
  visibility:
    hidden !important;

  pointer-events:
    none !important;

  opacity:
    0 !important;

  clip-path:
    inset(0 0 100% 0) !important;

  transform:
    translate3d(0, -12px, 0) !important;
}


/* =========================================================
   5. INNER CONTENT
   Do NOT reanimate the whole panel when moving:
   Phones → Smart Watches → Fitness Watches.
   ========================================================= */

.st3-mega__inner {
  transform:
    translate3d(0, 0, 0);

  will-change:
    opacity,
    transform;
}


/*
 * When the complete menu first opens, content settles
 * softly after the panel starts revealing.
 */

.st3-mega--open
.st3-mega__inner {
  animation:
    st3AppleMegaContentEnter
    330ms
    55ms
    cubic-bezier(.16, 1, .3, 1)
    both !important;
}


@keyframes st3AppleMegaContentEnter {
  0% {
    opacity:
      0;

    transform:
      translate3d(0, -7px, 0);
  }

  100% {
    opacity:
      1;

    transform:
      translate3d(0, 0, 0);
  }
}


/* =========================================================
   6. CATEGORY CONTENT SWITCHING
   Outer panel does not collapse.
   Only content shifts subtly.
   ========================================================= */

.st3-mega__inner--switch {
  animation:
    st3AppleCategorySwitch
    250ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}


@keyframes st3AppleCategorySwitch {
  0% {
    opacity:
      .35;

    transform:
      translate3d(0, 5px, 0);
  }

  100% {
    opacity:
      1;

    transform:
      translate3d(0, 0, 0);
  }
}


/*
 * Closing content does not run another elaborate animation.
 * It simply follows the retracting container.
 */

.st3-mega--closing
.st3-mega__inner {
  animation:
    none !important;

  opacity:
    .82 !important;

  transform:
    translate3d(0, -3px, 0) !important;

  transition:
    opacity 260ms ease,
    transform 340ms
      var(--st-header-close-ease)
      !important;
}


/* =========================================================
   7. BACKGROUND SCRIM
   Synchronised with the panel.
   ========================================================= */

.st3-header__scrim,
.st3-header__scrim--v3 {
  transition:
    opacity
      320ms
      ease,
    visibility
      0s
      linear
      420ms
      !important;
}


.st3-header__scrim--open {
  visibility:
    visible !important;

  transition:
    opacity
      340ms
      ease,
    visibility
      0s
      linear
      0s
      !important;
}


.st3-header__scrim--closing {
  visibility:
    visible !important;

  pointer-events:
    none !important;

  opacity:
    0 !important;

  transition:
    opacity
      360ms
      ease,
    visibility
      0s
      linear
      420ms
      !important;
}


/* =========================================================
   8. HEADER CATEGORY LABELS
   ========================================================= */

.st3-header__nav-item {
  transition:
    color 190ms ease,
    opacity 190ms ease,
    background-color 190ms ease
    !important;
}


/* =========================================================
   9. LINKS INSIDE MEGA MENU
   Small visual response only. No jumping.
   ========================================================= */

.st3-mega__primary-link,
.st3-mega__secondary-link {
  transition:
    color 190ms ease,
    opacity 190ms ease,
    background-color 190ms ease
    !important;
}


/*
 * Slightly soften inactive links when another one is hovered.
 * Gives navigation a cleaner hierarchy.
 */

@media (hover: hover) {

  .st3-mega__links:hover
  .st3-mega__primary-link:not(:hover),

  .st3-mega__secondary-links:hover
  .st3-mega__secondary-link:not(:hover) {
    opacity:
      .58;
  }


  .st3-mega__primary-link:hover,
  .st3-mega__secondary-link:hover {
    opacity:
      1;

    color:
      #1d1d1f;
  }

}


/* =========================================================
   10. ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .st3-header .st3-mega,
  .st3-header .st3-mega *,
  .st3-header__scrim,
  .st3-header__scrim--v3 {
    animation:
      none !important;

    transition:
      none !important;
  }

}

/* === ST APPLE HEADER MOTION V3 END === */






/* === ST CLEAN INTERACTION MOTION V1 START === */

/*
   =========================================================
   STEREOPHONIE — CLEAN MICRO INTERACTIONS

   Philosophy:
   - short
   - responsive
   - no bounce
   - no large movement
   - no page transition
   - no loader animation
   =========================================================
*/

:root {
  --st-ui-fast: 150ms;
  --st-ui-normal: 210ms;
  --st-ui-panel: 240ms;

  --st-ui-ease:
    cubic-bezier(.22, .61, .36, 1);

  --st-ui-ease-out:
    cubic-bezier(.16, 1, .3, 1);
}


/* =========================================================
   1. AI ASSISTANT PANEL
   ========================================================= */

/*
 * The assistant <aside> stays mounted at all times,
 * which means we can animate both directions properly.
 */

.st3-ai-panel {
  opacity:
    0 !important;

  visibility:
    hidden !important;

  pointer-events:
    none !important;

  transform:
    translate3d(0, 10px, 0)
    scale(.985) !important;

  transform-origin:
    bottom right !important;

  transition:
    opacity
      var(--st-ui-panel)
      var(--st-ui-ease),
    transform
      var(--st-ui-panel)
      var(--st-ui-ease-out),
    visibility
      0s linear
      var(--st-ui-panel)
      !important;

  will-change:
    opacity,
    transform;
}


.st3-ai-panel.st3-ai-panel--open {
  opacity:
    1 !important;

  visibility:
    visible !important;

  pointer-events:
    auto !important;

  transform:
    translate3d(0, 0, 0)
    scale(1) !important;

  transition:
    opacity
      var(--st-ui-panel)
      var(--st-ui-ease),
    transform
      var(--st-ui-panel)
      var(--st-ui-ease-out),
    visibility
      0s linear
      0s
      !important;
}


/*
 * Inner content settles very slightly after the surface.
 */

.st3-ai-panel__top,
.st3-ai-panel__messages,
.st3-ai-composer,
.st3-ai-disclaimer {
  transition:
    opacity 190ms var(--st-ui-ease),
    transform 210ms var(--st-ui-ease-out)
    !important;
}


.st3-ai-panel:not(.st3-ai-panel--open)
:is(
  .st3-ai-panel__top,
  .st3-ai-panel__messages,
  .st3-ai-composer,
  .st3-ai-disclaimer
) {
  opacity:
    .72;

  transform:
    translate3d(0, 3px, 0);
}


.st3-ai-panel.st3-ai-panel--open
:is(
  .st3-ai-panel__top,
  .st3-ai-panel__messages,
  .st3-ai-composer,
  .st3-ai-disclaimer
) {
  opacity:
    1;

  transform:
    translate3d(0, 0, 0);
}


/*
 * IMPORTANT:
 * Do not touch transform/animation on the launcher itself.
 * Its existing mustard breathing + float remain authoritative.
 */

.st3-ai-launcher {
  transition:
    border-color var(--st-ui-fast) ease,
    background-color var(--st-ui-fast) ease,
    box-shadow var(--st-ui-fast) ease,
    filter var(--st-ui-fast) ease
    !important;
}


.st3-ai-launcher:active {
  filter:
    brightness(.975);
}


/* =========================================================
   2. PRICE RANGE — REAL OPEN + CLOSE
   ========================================================= */

.st-filter-v4__price-backdrop {
  opacity:
    1 !important;

  visibility:
    visible !important;

  transition:
    opacity 180ms ease
    !important;
}


.st-filter-v4__price-backdrop.is-closing {
  opacity:
    0 !important;

  pointer-events:
    none !important;
}


.st-filter-v4__price-popover {
  transform-origin:
    top left !important;

  will-change:
    opacity,
    transform;

  transition:
    opacity
      var(--st-ui-panel)
      var(--st-ui-ease),
    transform
      var(--st-ui-panel)
      var(--st-ui-ease-out),
    box-shadow
      var(--st-ui-normal)
      ease
      !important;
}


.st-filter-v4__price-popover.is-open {
  opacity:
    1 !important;

  visibility:
    visible !important;

  pointer-events:
    auto !important;

  transform:
    translate3d(0, 0, 0)
    scale(1) !important;
}


.st-filter-v4__price-popover.is-closing {
  opacity:
    0 !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  transform:
    translate3d(0, -5px, 0)
    scale(.988) !important;
}


/* =========================================================
   3. CATEGORY / BRAND / SORT CONTROLS
   ========================================================= */

/*
 * Native select menus are controlled by Safari/macOS.
 * We animate the storefront control itself cleanly.
 */

.st-filter-v4__select,
.st-filter-v4__sort {
  transition:
    background-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    border-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    color
      var(--st-ui-normal)
      var(--st-ui-ease),
    box-shadow
      var(--st-ui-normal)
      var(--st-ui-ease)
      !important;
}


.st-filter-v4__select:hover,
.st-filter-v4__sort:hover {
  border-color:
    rgba(29, 29, 31, .22) !important;
}


.st-filter-v4__select:focus-within,
.st-filter-v4__sort:focus-within {
  border-color:
    rgba(245, 179, 53, .72) !important;

  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .10)
    !important;
}


/*
 * Chevron receives subtle feedback.
 */

.st-filter-v4__select > svg,
.st-filter-v4__sort > svg {
  transition:
    opacity 180ms ease,
    color 180ms ease,
    transform 210ms var(--st-ui-ease)
    !important;
}


.st-filter-v4__select:focus-within > svg,
.st-filter-v4__sort:focus-within > svg {
  color:
    #a86b00;

  transform:
    translate3d(0, 1px, 0);
}


/* =========================================================
   4. FILTER PILLS
   ========================================================= */

.st-filter-v4__pill,
.st-filter-v4__search-button,
.st-filter-v4__price-title button,
.st-filter-v4__price-actions button {
  transition:
    background-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    border-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    color
      var(--st-ui-normal)
      var(--st-ui-ease),
    box-shadow
      var(--st-ui-normal)
      var(--st-ui-ease),
    filter
      var(--st-ui-fast)
      ease
      !important;
}


/*
 * No jumping.
 */

.st-filter-v4__pill:hover,
.st-filter-v4__pill:active,
.st-filter-v4__search-button:hover,
.st-filter-v4__search-button:active,
.st-filter-v4__price-title button:hover,
.st-filter-v4__price-title button:active,
.st-filter-v4__price-actions button:hover,
.st-filter-v4__price-actions button:active {
  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


.st-filter-v4__pill:active,
.st-filter-v4__search-button:active,
.st-filter-v4__price-actions button:active {
  filter:
    brightness(.975);
}


/* =========================================================
   5. HEADER BUTTON / LINK FEEDBACK
   ========================================================= */

/*
 * This does NOT replace your new header reveal animation.
 * It only refines the individual controls.
 */

.st3-header__nav-item,
.st3-header__icon {
  transition:
    background-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    color
      var(--st-ui-normal)
      var(--st-ui-ease),
    opacity
      var(--st-ui-normal)
      var(--st-ui-ease),
    box-shadow
      var(--st-ui-normal)
      var(--st-ui-ease)
      !important;
}


/* =========================================================
   6. PRODUCT / STOREFRONT BUTTON FEEDBACK
   ========================================================= */

/*
 * Color/shadow feedback only.
 * We deliberately DO NOT globally translate buttons.
 */

.st-retail-card button,
.st-product-v5 button,
.st-purchase-v6 button,
.st3-ai-panel button {
  transition:
    background-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    border-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    color
      var(--st-ui-normal)
      var(--st-ui-ease),
    box-shadow
      var(--st-ui-normal)
      var(--st-ui-ease),
    opacity
      var(--st-ui-fast)
      ease,
    filter
      var(--st-ui-fast)
      ease
      !important;
}


/*
 * Do NOT disturb:
 * - wishlist/new-badge breathing
 * - AI breathing
 * - product carousel movement
 */

.st-retail-card button:active,
.st-product-v5 button:active,
.st-purchase-v6 button:active,
.st3-ai-panel button:active {
  filter:
    brightness(.975);
}


/* =========================================================
   7. INPUT FOCUS
   ========================================================= */

.st-filter-v4 input,
.st3-ai-composer input {
  transition:
    border-color
      var(--st-ui-normal)
      var(--st-ui-ease),
    box-shadow
      var(--st-ui-normal)
      var(--st-ui-ease),
    background-color
      var(--st-ui-normal)
      var(--st-ui-ease)
      !important;
}


/* =========================================================
   8. ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .st3-ai-panel,
  .st3-ai-panel *,
  .st-filter-v4__price-popover,
  .st-filter-v4__price-backdrop,
  .st-filter-v4__select,
  .st-filter-v4__sort,
  .st-filter-v4__pill,
  .st-filter-v4__search-button {
    transition:
      none !important;
  }

}

/* === ST CLEAN INTERACTION MOTION V1 END === */

/* === ST SHOP CLEAN MOTION FINAL START === */

/*
   =========================================================
   STEREOPHONIE SHOP — PREMIUM MICRO MOTION

   Motion language:
   - responsive
   - subtle
   - no bounce
   - no layout movement
   - no heavy blur animation
   - no gaming-style scaling
   =========================================================
*/

:root {
  --st-shop-motion-fast:
    150ms;

  --st-shop-motion-normal:
    210ms;

  --st-shop-motion-panel:
    240ms;

  --st-shop-motion-ease:
    cubic-bezier(.22, .61, .36, 1);

  --st-shop-motion-ease-out:
    cubic-bezier(.16, 1, .3, 1);

  --st-shop-mustard:
    #f5b335;

  --st-shop-mustard-soft:
    rgba(245, 179, 53, .10);

  --st-shop-ink:
    #1d1d1f;
}


/* =========================================================
   1. PRICE BUTTON
   ========================================================= */

.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill {
  transition:
    background-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    border-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    box-shadow
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease)
      !important;

  transform:
    none !important;

  translate:
    none !important;
}


.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill:hover {
  box-shadow:
    0 5px 16px
    rgba(0, 0, 0, .055)
    !important;
}


.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill:active {
  filter:
    brightness(.975);

  transform:
    none !important;
}


/* Chevron gets a tiny visual response. */

.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill > svg:last-child {
  transition:
    transform
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      ease
      !important;
}


.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill[aria-expanded="true"]
> svg:last-child {
  transform:
    rotate(180deg) !important;
}


/* =========================================================
   2. PRICE RANGE POPOVER
   ========================================================= */

/*
 * OPEN state.
 */

.st-retail-shop
.st-filter-v4__price-popover.is-open {
  opacity:
    1 !important;

  visibility:
    visible !important;

  pointer-events:
    auto !important;

  transform:
    translate3d(0, 0, 0)
    scale(1) !important;

  transition:
    opacity
      var(--st-shop-motion-panel)
      var(--st-shop-motion-ease),
    transform
      var(--st-shop-motion-panel)
      var(--st-shop-motion-ease-out),
    box-shadow
      var(--st-shop-motion-normal)
      ease
      !important;
}


/*
 * CLOSING state.
 *
 * If priceMounted exists, React keeps this element alive long
 * enough to visibly animate to this state.
 */

.st-retail-shop
.st-filter-v4__price-popover.is-closing {
  opacity:
    0 !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  transform:
    translate3d(0, -7px, 0)
    scale(.987) !important;

  transition:
    opacity
      var(--st-shop-motion-panel)
      var(--st-shop-motion-ease),
    transform
      var(--st-shop-motion-panel)
      var(--st-shop-motion-ease)
      !important;
}


/*
 * Compatibility with the version that mounts the panel
 * directly without state classes.
 */

.st-retail-shop
.st-filter-v4__price-popover:not(.is-closing) {
  transform-origin:
    top left !important;

  will-change:
    opacity,
    transform;
}


/*
 * Outside-click layer fades instead of flashing.
 */

.st-retail-shop
.st-filter-v4__price-backdrop {
  transition:
    opacity
      190ms
      ease
      !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-open {
  opacity:
    1 !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-closing {
  opacity:
    0 !important;

  pointer-events:
    none !important;
}


/* =========================================================
   3. CATEGORY + BRAND
   ========================================================= */

/*
 * These are native Safari/macOS selects.
 *
 * We animate the storefront shell, not Apple's operating-
 * system dropdown window.
 */

.st-retail-shop
.st-filter-v4__select {
  transition:
    background-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    border-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    box-shadow
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease)
      !important;

  transform:
    none !important;
}


.st-retail-shop
.st-filter-v4__select:hover {
  border-color:
    rgba(29, 29, 31, .24)
    !important;

  box-shadow:
    0 4px 14px
    rgba(0, 0, 0, .035)
    !important;
}


.st-retail-shop
.st-filter-v4__select:focus-within {
  border-color:
    rgba(245, 179, 53, .70)
    !important;

  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .10)
    !important;
}


/*
 * Chevron motion.
 */

.st-retail-shop
.st-filter-v4__select > svg {
  transition:
    transform
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      ease,
    opacity
      var(--st-shop-motion-normal)
      ease
      !important;
}


.st-retail-shop
.st-filter-v4__select:focus-within > svg {
  color:
    #a86b00 !important;

  transform:
    translate3d(0, 1px, 0)
    !important;
}


/* Native select itself must stay instant/responsive. */

.st-retail-shop
.st-filter-v4__select select {
  cursor:
    pointer;

  transition:
    color
      var(--st-shop-motion-normal)
      ease
      !important;
}


/* =========================================================
   4. SORT
   ========================================================= */

.st-retail-shop
.st-filter-v4__sort {
  transition:
    background-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    border-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    box-shadow
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease)
      !important;

  transform:
    none !important;
}


.st-retail-shop
.st-filter-v4__sort:hover {
  border-color:
    rgba(29, 29, 31, .24)
    !important;

  box-shadow:
    0 4px 14px
    rgba(0, 0, 0, .035)
    !important;
}


.st-retail-shop
.st-filter-v4__sort:focus-within {
  border-color:
    rgba(245, 179, 53, .70)
    !important;

  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .10)
    !important;
}


.st-retail-shop
.st-filter-v4__sort > svg {
  transition:
    color
      var(--st-shop-motion-normal)
      ease,
    transform
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease)
      !important;
}


.st-retail-shop
.st-filter-v4__sort:focus-within > svg {
  color:
    #a86b00 !important;

  transform:
    translate3d(0, 1px, 0)
    !important;
}


/* =========================================================
   5. IN STOCK
   ========================================================= */

/*
 * Smooth transition between:
 *
 * OFF
 * white pill / dark text / mustard dot
 *
 * ON
 * black pill / white text / mustard dot
 */

.st-retail-shop
.st-filter-v4__pill {
  transition:
    background-color
      230ms
      var(--st-shop-motion-ease),
    border-color
      230ms
      var(--st-shop-motion-ease),
    color
      230ms
      var(--st-shop-motion-ease),
    box-shadow
      230ms
      var(--st-shop-motion-ease),
    filter
      var(--st-shop-motion-fast)
      ease
      !important;

  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


.st-retail-shop
.st-filter-v4__pill:hover {
  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


.st-retail-shop
.st-filter-v4__pill:active {
  filter:
    brightness(.975);
}


.st-retail-shop
.st-filter-v4__pill.is-active {
  background:
    var(--st-shop-ink) !important;

  border-color:
    var(--st-shop-ink) !important;

  color:
    #fff !important;

  box-shadow:
    0 7px 20px
    rgba(0, 0, 0, .075)
    !important;
}


/*
 * Mustard dot smoothly breathes into the active state,
 * but does NOT bounce or change layout.
 */

.st-retail-shop
.st-filter-v4__stock-dot {
  background:
    var(--st-shop-mustard) !important;

  transition:
    background-color
      230ms
      var(--st-shop-motion-ease),
    box-shadow
      230ms
      var(--st-shop-motion-ease),
    opacity
      230ms
      var(--st-shop-motion-ease)
      !important;
}


.st-retail-shop
.st-filter-v4__pill.is-active
.st-filter-v4__stock-dot {
  background:
    var(--st-shop-mustard) !important;

  box-shadow:
    0 0 0 4px
    rgba(245, 179, 53, .12)
    !important;
}


/* =========================================================
   6. PRICE PANEL INTERNAL CONTROLS
   ========================================================= */

.st-retail-shop
.st-filter-v4__price-title button,

.st-retail-shop
.st-filter-v4__price-actions button,

.st-retail-shop
.st-filter-v4__price-fields input {
  transition:
    background-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    border-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    box-shadow
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    filter
      var(--st-shop-motion-fast)
      ease
      !important;
}


.st-retail-shop
.st-filter-v4__price-title button:hover,

.st-retail-shop
.st-filter-v4__price-title button:active,

.st-retail-shop
.st-filter-v4__price-actions button:hover,

.st-retail-shop
.st-filter-v4__price-actions button:active {
  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


/* =========================================================
   7. SEARCH
   ========================================================= */

.st-retail-shop
.st-filter-v4__search,

.st-retail-shop
.st-filter-v4__search-button {
  transition:
    background-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    border-color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    color
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease),
    box-shadow
      var(--st-shop-motion-normal)
      var(--st-shop-motion-ease)
      !important;
}


.st-retail-shop
.st-filter-v4__search:focus-within {
  border-color:
    rgba(245, 179, 53, .62)
    !important;

  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .08)
    !important;
}


/* =========================================================
   8. NO LAYOUT-JUMPING FILTER ANIMATIONS
   ========================================================= */

.st-retail-shop
:is(
  .st-filter-v4__pill,
  .st-filter-v4__select,
  .st-filter-v4__sort,
  .st-filter-v4__search-button
):hover,

.st-retail-shop
:is(
  .st-filter-v4__pill,
  .st-filter-v4__select,
  .st-filter-v4__sort,
  .st-filter-v4__search-button
):active {
  translate:
    none !important;

  transform:
    none !important;

  scale:
    1 !important;
}


/* =========================================================
   9. ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .st-retail-shop
  .st-filter-v4 * {
    transition-duration:
      0.01ms !important;

    animation-duration:
      0.01ms !important;

    animation-iteration-count:
      1 !important;
  }

}

/* === ST SHOP CLEAN MOTION FINAL END === */

/* === ST PRICE RANGE AI MOTION START === */

/*
   =========================================================
   PRICE RANGE — AI-STYLE OPEN / CLOSE

   OPEN:
   slightly above + faint
       ↓
   settles into place + fully visible

   CLOSE:
   fully visible
       ↑
   lifts slightly + fades away

   Restrained.
   No bounce.
   No large zoom.
   =========================================================
*/


/* ---------------------------------------------------------
   PRICE TRIGGER
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill {
  transition:
    background-color 190ms cubic-bezier(.22,.61,.36,1),
    border-color 190ms cubic-bezier(.22,.61,.36,1),
    color 190ms cubic-bezier(.22,.61,.36,1),
    box-shadow 190ms cubic-bezier(.22,.61,.36,1)
    !important;

  transform:
    none !important;

  translate:
    none !important;
}


/*
 * Chevron rotates gently while open.
 */

.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill > svg:last-child {
  transition:
    transform 240ms
    cubic-bezier(.22,.61,.36,1)
    !important;
}


.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill[aria-expanded="true"]
> svg:last-child {
  transform:
    rotate(180deg) !important;
}


/* ---------------------------------------------------------
   BACKDROP
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-backdrop {
  position:
    fixed !important;

  inset:
    0 !important;

  z-index:
    90 !important;

  border:
    0 !important;

  background:
    transparent !important;

  backdrop-filter:
    none !important;

  -webkit-backdrop-filter:
    none !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-open {
  opacity:
    1 !important;

  pointer-events:
    auto !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-closing {
  opacity:
    0 !important;

  pointer-events:
    none !important;

  animation:
    stPriceBackdropOut
    220ms
    ease
    both !important;
}


/* ---------------------------------------------------------
   PRICE PANEL BASE
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover {
  z-index:
    100 !important;

  transform-origin:
    top left !important;

  will-change:
    opacity,
    transform !important;

  backface-visibility:
    hidden;

  -webkit-backface-visibility:
    hidden;

  /*
   * Prevent old generic transitions from interfering
   * with our keyframe states.
   */
  transition:
    box-shadow 180ms ease
    !important;
}


/* ---------------------------------------------------------
   OPEN
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover.is-open {
  visibility:
    visible !important;

  pointer-events:
    auto !important;

  animation:
    stPriceAiOpen
    285ms
    cubic-bezier(.16, 1, .3, 1)
    both !important;
}


/* ---------------------------------------------------------
   CLOSE
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover.is-closing {
  visibility:
    visible !important;

  pointer-events:
    none !important;

  animation:
    stPriceAiClose
    250ms
    cubic-bezier(.4, 0, .2, 1)
    both !important;
}


/* ---------------------------------------------------------
   OPEN KEYFRAME
   --------------------------------------------------------- */

@keyframes stPriceAiOpen {

  0% {
    opacity:
      0;

    transform:
      translate3d(0, -10px, 0)
      scale(.975);
  }

  55% {
    opacity:
      .92;
  }

  100% {
    opacity:
      1;

    transform:
      translate3d(0, 0, 0)
      scale(1);
  }

}


/* ---------------------------------------------------------
   CLOSE KEYFRAME
   Exact reverse feeling.
   --------------------------------------------------------- */

@keyframes stPriceAiClose {

  0% {
    opacity:
      1;

    transform:
      translate3d(0, 0, 0)
      scale(1);
  }

  100% {
    opacity:
      0;

    transform:
      translate3d(0, -8px, 0)
      scale(.982);
  }

}


@keyframes stPriceBackdropOut {

  from {
    opacity:
      1;
  }

  to {
    opacity:
      0;
  }

}


/* ---------------------------------------------------------
   INTERNAL CONTROLS
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-title button,

.st-retail-shop
.st-filter-v4__price-actions button {
  transition:
    background-color 170ms ease,
    border-color 170ms ease,
    color 170ms ease,
    box-shadow 170ms ease
    !important;

  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


.st-retail-shop
.st-filter-v4__price-title button:hover,

.st-retail-shop
.st-filter-v4__price-title button:active,

.st-retail-shop
.st-filter-v4__price-actions button:hover,

.st-retail-shop
.st-filter-v4__price-actions button:active {
  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


/* ---------------------------------------------------------
   INPUT FOCUS
   --------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-fields input {
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease,
    background-color 180ms ease
    !important;
}


/* ---------------------------------------------------------
   REDUCED MOTION
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  .st-retail-shop
  .st-filter-v4__price-popover,

  .st-retail-shop
  .st-filter-v4__price-backdrop {
    animation:
      none !important;
  }

}

/* === ST PRICE RANGE AI MOTION END === */

/* === ST PRICE REAL OPENING FIX START === */

/*
   ==========================================================
   PRICE RANGE — GUARANTEED ENTERING -> OPEN ANIMATION

   React now gives us three real visual states:

   is-entering
       invisible / slightly raised

   is-open
       fully visible / settled

   is-closing
       fades and lifts away

   No keyframe is required for opening.
   A transition between two browser-painted states is more
   reliable here.
   ==========================================================
*/


/* ----------------------------------------------------------
   BASE
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover {
  transform-origin:
    top left !important;

  will-change:
    opacity,
    transform !important;

  transition:
    opacity
      290ms
      cubic-bezier(.22, .61, .36, 1),
    transform
      320ms
      cubic-bezier(.16, 1, .3, 1),
    box-shadow
      190ms
      ease
      !important;

  animation:
    none !important;
}


/* ----------------------------------------------------------
   ENTERING
   This state is now physically painted BEFORE is-open.
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover.is-entering {
  opacity:
    0 !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  transform:
    translate3d(0, -12px, 0)
    scale(.972) !important;
}


/* ----------------------------------------------------------
   OPEN
   Browser transitions from ENTERING -> here.
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover.is-open {
  opacity:
    1 !important;

  visibility:
    visible !important;

  pointer-events:
    auto !important;

  transform:
    translate3d(0, 0, 0)
    scale(1) !important;

  animation:
    none !important;
}


/* ----------------------------------------------------------
   CLOSE
   Keep the working closing behavior.
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-popover.is-closing {
  opacity:
    0 !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  transform:
    translate3d(0, -9px, 0)
    scale(.982) !important;

  transition:
    opacity
      250ms
      cubic-bezier(.4, 0, .2, 1),
    transform
      270ms
      cubic-bezier(.4, 0, .2, 1)
      !important;

  animation:
    none !important;
}


/* ----------------------------------------------------------
   OUTSIDE-CLICK BACKDROP
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-backdrop {
  background:
    transparent !important;

  backdrop-filter:
    none !important;

  -webkit-backdrop-filter:
    none !important;

  transition:
    opacity 240ms ease
    !important;

  animation:
    none !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-entering {
  opacity:
    0 !important;

  pointer-events:
    none !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-open {
  opacity:
    1 !important;

  pointer-events:
    auto !important;
}


.st-retail-shop
.st-filter-v4__price-backdrop.is-closing {
  opacity:
    0 !important;

  pointer-events:
    none !important;
}


/* ----------------------------------------------------------
   PRICE CHEVRON
   ---------------------------------------------------------- */

.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill > svg:last-child {
  transition:
    transform 280ms
    cubic-bezier(.22, .61, .36, 1)
    !important;
}


.st-retail-shop
.st-filter-v4__price-wrap
.st-filter-v4__pill[aria-expanded="true"]
> svg:last-child {
  transform:
    rotate(180deg) !important;
}


/* ----------------------------------------------------------
   REDUCED MOTION
   ---------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  .st-retail-shop
  .st-filter-v4__price-popover,

  .st-retail-shop
  .st-filter-v4__price-backdrop {
    transition:
      none !important;
  }

}

/* === ST PRICE REAL OPENING FIX END === */

/* =========================================================
   SHOP PAGE — FINAL TOP GAP FIX
   Scope: Shop page only
   ========================================================= */

.st-retail-shop.st-retail-shop-v4 {
  padding-top: 0 !important;
}

.st-retail-shop.st-retail-shop-v4
.st-v2-shop-body {
  padding-top: 18px !important;
}

.st-retail-shop.st-retail-shop-v4
.st-v2-container {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

.st-retail-shop.st-retail-shop-v4
.st-v2-shop-results__head {
  margin-top: 0 !important;
}

/* Mobile keeps a little breathing room */
@media (max-width: 720px) {
  .st-retail-shop.st-retail-shop-v4
  .st-v2-shop-body {
    padding-top: 18px !important;
  }
}

/* === END SHOP PAGE FINAL TOP GAP FIX === */


/* === ST REAL SHOP TOP GAP FIX START === */

/*
 * ACTIVE SHOP ROOT:
 *
 * <main class="
 *   st3-shop-v4
 *   st-retail-shop
 *   st-retail-shop-v4
 * ">
 *
 * We intentionally target the CURRENT V4 architecture rather
 * than the obsolete .st-v2-shop-body wrapper.
 */


/* ---------------------------------------------------------
   1. ACTUAL SHOP PAGE ROOT
   --------------------------------------------------------- */

main.st3-shop-v4.st-retail-shop.st-retail-shop-v4 {
  padding-top: 26px !important;
  margin-top: 0 !important;
}


/* ---------------------------------------------------------
   2. REMOVE OLD TOP SPACING FROM THE FIRST V4 WRAPPER
   --------------------------------------------------------- */

main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
> :first-child {
  padding-top: 0 !important;
  margin-top: 0 !important;
}


/*
 * Some historical versions placed one additional wrapper
 * between the <main> and heading.
 */

main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
> :first-child
> :first-child {
  margin-top: 0 !important;
}


/* ---------------------------------------------------------
   3. CURRENT SHOP HEADING AREA
   --------------------------------------------------------- */

main.st3-shop-v4
:is(
  .st3-shop-v4__header,
  .st3-shop-v4__heading,
  .st3-shop-v4__intro,
  .st3-shop-v4__top,
  .st3-shop-v4__hero,
  .st-v2-shop-results__head
) {
  margin-top: 0 !important;
  padding-top: 0 !important;
}


/* ---------------------------------------------------------
   4. DO NOT LET LEGACY SHOP HERO SPACERS RESERVE HEIGHT
   --------------------------------------------------------- */

main.st3-shop-v4
:is(
  .st3-shop-hero,
  .st-v2-shop-hero,
  .st3-shop-intro
) {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}


/* ---------------------------------------------------------
   5. RESPONSIVE
   --------------------------------------------------------- */

@media (max-width: 720px) {
  main.st3-shop-v4.st-retail-shop.st-retail-shop-v4 {
    padding-top: 20px !important;
  }
}

/* === ST REAL SHOP TOP GAP FIX END === */


/* === ST SHOP GAP ACTUAL CONTENT FIX START === */

/*
 * ACTIVE PAGE:
 * <main class="st3-shop-v4 st-retail-shop st-retail-shop-v4">
 *
 * IMPORTANT:
 * Earlier fixes targeted padding on the outer shop wrappers.
 * The visible whitespace is being reserved by the active V4
 * content wrapper itself.
 *
 * We therefore move ONLY the first real Shop-content block upward
 * and reclaim the exact same space from normal document flow.
 *
 * Header is untouched.
 * Other pages are untouched.
 */


/* ---------------------------------------------------------
   DESKTOP / LAPTOP
   --------------------------------------------------------- */

body main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
> :first-child {
  position: relative !important;

  transform:
    translate3d(0, -92px, 0) !important;

  margin-bottom:
    -92px !important;
}


/*
 * Prevent historical first-child spacing from adding more
 * whitespace on top of our corrected position.
 */

body main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
> :first-child {
  padding-top:
    0 !important;
}


/* ---------------------------------------------------------
   KEEP SHOP HEADING ITSELF CLEAN
   --------------------------------------------------------- */

body main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
> :first-child
:is(
  section,
  div
):first-child {
  margin-top:
    0 !important;
}


/* ---------------------------------------------------------
   TABLET
   --------------------------------------------------------- */

@media (min-width: 721px) and (max-width: 1024px) {

  body main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
  > :first-child {
    transform:
      translate3d(0, -72px, 0) !important;

    margin-bottom:
      -72px !important;
  }

}


/* ---------------------------------------------------------
   MOBILE
   Keep a natural amount of breathing room.
   --------------------------------------------------------- */

@media (max-width: 720px) {

  body main.st3-shop-v4.st-retail-shop.st-retail-shop-v4
  > :first-child {
    transform:
      translate3d(0, -42px, 0) !important;

    margin-bottom:
      -42px !important;
  }

}

/* === ST SHOP GAP ACTUAL CONTENT FIX END === */

/* === ST DUAL AI WHATSAPP EXACT START === */


/* =========================================================
   STEREOPHONIE — DUAL FLOATING LAUNCHER

   AI      <-> WhatsApp every five seconds

   Existing pulse DOM is preserved.
   New shimmer uses its own real DOM element.
   ========================================================= */


/* ---------------------------------------------------------
   FOUNDATION
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"] {
  isolation:
    isolate !important;

  overflow:
    visible !important;
}


/* ---------------------------------------------------------
   SHIMMER SURFACE
   --------------------------------------------------------- */

button.st3-ai-launcher
.st3-ai-launcher__shimmer {
  position:
    absolute !important;

  inset:
    3px !important;

  z-index:
    3 !important;

  overflow:
    hidden !important;

  border-radius:
    999px !important;

  pointer-events:
    none !important;
}


button.st3-ai-launcher
.st3-ai-launcher__shimmer::before {
  content:
    "" !important;

  position:
    absolute !important;

  top:
    -35% !important;

  bottom:
    -35% !important;

  left:
    -75% !important;

  width:
    42% !important;

  background:
    linear-gradient(
      90deg,
      rgba(245, 179, 53, 0) 0%,
      rgba(245, 179, 53, .07) 24%,
      rgba(245, 179, 53, .34) 50%,
      rgba(255, 219, 144, .23) 64%,
      rgba(245, 179, 53, 0) 100%
    ) !important;

  transform:
    skewX(-19deg);

  filter:
    blur(.8px);

  opacity:
    0;

  animation:
    stDualMustardShimmer
    3.6s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


@keyframes stDualMustardShimmer {

  0%,
  20% {
    left:
      -75%;

    opacity:
      0;
  }

  31% {
    opacity:
      .95;
  }

  52% {
    left:
      135%;

    opacity:
      .72;
  }

  62%,
  100% {
    left:
      135%;

    opacity:
      0;
  }

}


/* ---------------------------------------------------------
   ICON LAYER
   --------------------------------------------------------- */

button.st3-ai-launcher
.st3-ai-launcher__icon {
  z-index:
    5 !important;

  color:
    #1d1d1f !important;
}


button.st3-ai-launcher
.st3-ai-launcher__icon--swap {
  animation:
    stDualIconSwapIn
    360ms
    cubic-bezier(.16, 1, .3, 1)
    both !important;
}


@keyframes stDualIconSwapIn {

  0% {
    opacity:
      0;

    transform:
      scale(.78);
  }

  62% {
    opacity:
      1;

    transform:
      scale(1.04);
  }

  100% {
    opacity:
      1;

    transform:
      scale(1);
  }

}


/* ---------------------------------------------------------
   WHATSAPP — STRICTLY STEREOPHONIE COLORS
   --------------------------------------------------------- */

button.st3-ai-launcher
[data-st-whatsapp-icon="true"] {
  display:
    block !important;

  width:
    24px !important;

  height:
    24px !important;

  margin:
    0 !important;

  color:
    #1d1d1f !important;
}


button.st3-ai-launcher--whatsapp {
  background:
    #fff !important;

  color:
    #1d1d1f !important;

  border-color:
    rgba(29,29,31,.10) !important;
}


/*
 * Make sure historical green WhatsApp styles can never leak in.
 */

button.st3-ai-launcher--whatsapp
[data-st-whatsapp-icon="true"],
button.st3-ai-launcher--whatsapp
[data-st-whatsapp-icon="true"] * {
  color:
    #1d1d1f !important;
}


/* ---------------------------------------------------------
   KEEP THE EXISTING MUSTARD BREATHING GLOW IN BOTH MODES
   --------------------------------------------------------- */

button.st3-ai-launcher--ai
.st3-ai-launcher__pulse,

button.st3-ai-launcher--whatsapp
.st3-ai-launcher__pulse {
  display:
    block !important;

  visibility:
    visible !important;
}


/*
 * Critical:
 * Do not give the pulse children a new animation name here.
 * The existing final breathing system elsewhere in this file
 * remains authoritative.
 */


/* ---------------------------------------------------------
   SMOOTH MODE SWITCH
   --------------------------------------------------------- */

button.st3-ai-launcher--ai,
button.st3-ai-launcher--whatsapp {
  transition:
    background-color 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease,
    color 220ms ease
    !important;
}


/* ---------------------------------------------------------
   PREMIUM HOVER
   --------------------------------------------------------- */

@media (hover: hover) {

  button.st3-ai-launcher:hover
  .st3-ai-launcher__shimmer::before {
    animation-duration:
      2.9s !important;
  }

}


/* ---------------------------------------------------------
   OPEN AI PANEL
   Keep shimmer more restrained while user is chatting.
   --------------------------------------------------------- */

button.st3-ai-launcher--open
.st3-ai-launcher__shimmer::before {
  animation-duration:
    4.8s !important;

  opacity:
    .55;
}


/* ---------------------------------------------------------
   ACCESSIBILITY
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  button.st3-ai-launcher
  .st3-ai-launcher__shimmer::before,

  button.st3-ai-launcher
  .st3-ai-launcher__icon--swap {
    animation:
      none !important;
  }

}

/* === ST DUAL AI WHATSAPP EXACT END === */

/* === ST PREMIUM DUAL LAUNCHER V2 START === */

/* =========================================================
   STEREOPHONIE
   PREMIUM AI ↔ WHATSAPP FLOATING LAUNCHER

   Goals:
   - one white circular button
   - professional WhatsApp mark
   - true AI/WhatsApp crossfade
   - subtle scale + blur
   - visible mustard shimmer
   - retain existing breathing halo
   - no WhatsApp green
   ========================================================= */


/* ---------------------------------------------------------
   1. REAL LAUNCHER
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"] {
  isolation: isolate !important;

  /*
   * Keep outside breathing aura visible.
   */
  overflow: visible !important;
}


/* ---------------------------------------------------------
   2. WHITE CIRCLE / ICON SURFACE
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon {
  position: absolute !important;

  inset: 0 !important;

  z-index: 10 !important;

  display: grid !important;

  place-items: center !important;

  overflow: hidden !important;

  border-radius: 999px !important;

  background:
    rgba(255,255,255,.985) !important;

  color:
    #1d1d1f !important;

  transform:
    translateZ(0) !important;

  isolation:
    isolate !important;
}


/* ---------------------------------------------------------
   3. MUSTARD SHIMMER
   IMPORTANT:
   This sits DIRECTLY inside the white visual circle.
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::before {
  content:
    "" !important;

  display:
    block !important;

  position:
    absolute !important;

  z-index:
    1 !important;

  top:
    -18% !important;

  bottom:
    -18% !important;

  left:
    -70% !important;

  width:
    48% !important;

  border-radius:
    999px !important;

  pointer-events:
    none !important;

  opacity:
    0;

  background:
    linear-gradient(
      103deg,
      rgba(245,179,53,0) 0%,
      rgba(245,179,53,.02) 18%,
      rgba(245,179,53,.18) 38%,
      rgba(255,214,126,.48) 50%,
      rgba(245,179,53,.20) 62%,
      rgba(245,179,53,.03) 82%,
      rgba(245,179,53,0) 100%
    ) !important;

  filter:
    blur(1.5px);

  transform:
    skewX(-17deg);

  will-change:
    left,
    opacity;

  animation:
    stLauncherPremiumShimmer
    3.15s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stLauncherPremiumShimmer {

  0% {
    left:
      -70%;

    opacity:
      0;
  }

  14% {
    opacity:
      0;
  }

  25% {
    opacity:
      .92;
  }

  48% {
    left:
      128%;

    opacity:
      .78;
  }

  57% {
    left:
      128%;

    opacity:
      0;
  }

  100% {
    left:
      128%;

    opacity:
      0;
  }

}


/* ---------------------------------------------------------
   4. VERY SOFT MUSTARD INNER LIGHT
   Helps shimmer remain visible without making button yellow.
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::after {
  content:
    "" !important;

  display:
    block !important;

  position:
    absolute !important;

  inset:
    1px !important;

  z-index:
    0 !important;

  border-radius:
    inherit !important;

  pointer-events:
    none !important;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(245,179,53,.045) 0%,
      rgba(245,179,53,.018) 46%,
      rgba(245,179,53,0) 76%
    ) !important;

  opacity:
    .85 !important;
}


/* ---------------------------------------------------------
   5. ICON LAYERS
   All icons stay mounted.
   This is what creates the real crossfade.
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer {
  position:
    absolute !important;

  inset:
    0 !important;

  z-index:
    3 !important;

  display:
    grid !important;

  place-items:
    center !important;

  pointer-events:
    none !important;

  opacity:
    0;

  transform:
    scale(.86);

  filter:
    blur(2.4px);

  will-change:
    opacity,
    transform,
    filter;

  transition:
    opacity 480ms
      cubic-bezier(.22,.61,.36,1),
    transform 560ms
      cubic-bezier(.16,1,.3,1),
    filter 420ms
      cubic-bezier(.22,.61,.36,1)
      !important;
}


/* ---------------------------------------------------------
   6. ACTIVE AI ICON
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon.is-ai
.st3-ai-launcher__icon-layer--ai {
  opacity:
    1 !important;

  transform:
    scale(1) !important;

  filter:
    blur(0) !important;
}


/* ---------------------------------------------------------
   7. ACTIVE WHATSAPP ICON
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon.is-whatsapp
.st3-ai-launcher__icon-layer--whatsapp {
  opacity:
    1 !important;

  transform:
    scale(1) !important;

  filter:
    blur(0) !important;
}


/* ---------------------------------------------------------
   8. ACTIVE CLOSE ICON
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon.is-open
.st3-ai-launcher__icon-layer--close {
  opacity:
    1 !important;

  transform:
    scale(1) !important;

  filter:
    blur(0) !important;
}


/* ---------------------------------------------------------
   9. SVG NORMALIZATION
   Prevent previous CSS versions from changing icon sizing.
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer svg {
  position:
    static !important;

  inset:
    auto !important;

  display:
    block !important;

  margin:
    0 !important;

  color:
    #1d1d1f !important;

  transform:
    none !important;

  translate:
    none !important;

  scale:
    1 !important;
}


/* Robot */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--ai svg {
  width:
    25px !important;

  height:
    25px !important;

  stroke-width:
    1.6 !important;
}


/* WhatsApp
   Slightly larger because its silhouette has more negative space.
*/

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--whatsapp svg {
  width:
    27px !important;

  height:
    27px !important;

  fill:
    #1d1d1f !important;

  stroke:
    none !important;
}


/*
 * Absolutely no green.
 */

button.st3-ai-launcher[data-st-ai-launcher="true"]
[data-st-whatsapp-icon="true"],
button.st3-ai-launcher[data-st-ai-launcher="true"]
[data-st-whatsapp-icon="true"] * {
  color:
    #1d1d1f !important;

  fill:
    #1d1d1f !important;
}


/* Close */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--close svg {
  width:
    22px !important;

  height:
    22px !important;
}


/* ---------------------------------------------------------
   10. MODE CROSSFADE TIMING
   Prevent any historical animation from replacing this system.
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--ai,

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--whatsapp,

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer--close {
  animation:
    none !important;
}


/* ---------------------------------------------------------
   11. BUTTON HOVER
   Clean, restrained, no bouncing.
   --------------------------------------------------------- */

@media (hover: hover) {

  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__icon {
    box-shadow:
      inset 0 0 0 1px rgba(245,179,53,.11) !important;
  }


  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__icon::before {
    animation-duration:
      2.55s !important;
  }

}


/* ---------------------------------------------------------
   12. KEEP EXISTING OUTER MUSTARD BREATHING HALO
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--outer,

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--inner {
  display:
    block !important;

  visibility:
    visible !important;
}


/* ---------------------------------------------------------
   13. SAFARI GPU POLISH
   --------------------------------------------------------- */

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon,

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer,

button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::before {
  -webkit-backface-visibility:
    hidden;

  backface-visibility:
    hidden;
}


/* ---------------------------------------------------------
   14. REDUCED MOTION
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__icon-layer {
    transition:
      none !important;
  }

  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__icon::before {
    animation:
      none !important;

    opacity:
      .16 !important;

    left:
      28% !important;
  }

}

/* === ST PREMIUM DUAL LAUNCHER V2 END === */

/* === ST LAUNCHER LIGHT EFFECTS FINAL START === */

/* =========================================================
   STEREOPHONIE
   FINAL LAUNCHER ATTRACTION LIGHT SYSTEM

   This layer intentionally overrides all historical
   launcher glow / shimmer rules.

   - persistent breathing mustard aura
   - soft inner glow
   - visible mustard shimmer
   - no extra visible ring
   - works in AI and WhatsApp mode
   ========================================================= */


/* ---------------------------------------------------------
   1. REAL BUTTON STACKING CONTEXT
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"] {
  position:
    fixed !important;

  isolation:
    isolate !important;

  overflow:
    visible !important;

  contain:
    none !important;

  filter:
    none !important;

  box-shadow:
    none !important;
}


/*
 * Historical pseudo-elements must stay disabled.
 * We use the REAL pulse DOM elements instead.
 */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]::before,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]::after {
  content:
    none !important;

  display:
    none !important;
}


/* ---------------------------------------------------------
   2. REAL OUTER BREATHING AURA
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--outer {
  display:
    block !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  position:
    absolute !important;

  z-index:
    -2 !important;

  top:
    50% !important;

  left:
    50% !important;

  width:
    112px !important;

  height:
    112px !important;

  margin:
    0 !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  opacity:
    1 !important;

  background:
    radial-gradient(
      circle,
      rgba(245,179,53,.43) 0%,
      rgba(245,179,53,.31) 18%,
      rgba(245,179,53,.18) 37%,
      rgba(245,179,53,.085) 54%,
      rgba(245,179,53,.025) 68%,
      rgba(245,179,53,0) 79%
    ) !important;

  box-shadow:
    none !important;

  filter:
    blur(7px) !important;

  transform-origin:
    50% 50% !important;

  will-change:
    transform,
    opacity,
    filter !important;

  animation:
    stLauncherOuterBreathFinal
    2.9s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stLauncherOuterBreathFinal {

  0%,
  100% {
    opacity:
      .18;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.78);

    filter:
      blur(8px);
  }

  43% {
    opacity:
      .76;

    transform:
      translate3d(-50%, -50%, 0)
      scale(1.08);

    filter:
      blur(10px);
  }

  62% {
    opacity:
      .48;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.97);

    filter:
      blur(9px);
  }

}


/* ---------------------------------------------------------
   3. INNER MUSTARD BREATH
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--inner {
  display:
    block !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;

  position:
    absolute !important;

  z-index:
    -1 !important;

  top:
    50% !important;

  left:
    50% !important;

  width:
    82px !important;

  height:
    82px !important;

  margin:
    0 !important;

  border:
    1px solid
    rgba(245,179,53,.13) !important;

  border-radius:
    999px !important;

  opacity:
    1 !important;

  background:
    radial-gradient(
      circle,
      rgba(255,224,159,.22) 0%,
      rgba(245,179,53,.16) 35%,
      rgba(245,179,53,.065) 58%,
      rgba(245,179,53,0) 76%
    ) !important;

  box-shadow:
    0 0 22px
    rgba(245,179,53,.13) !important;

  filter:
    blur(3px) !important;

  transform-origin:
    50% 50% !important;

  will-change:
    transform,
    opacity !important;

  animation:
    stLauncherInnerBreathFinal
    2.9s
    .16s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stLauncherInnerBreathFinal {

  0%,
  100% {
    opacity:
      .20;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.90);
  }

  46% {
    opacity:
      .64;

    transform:
      translate3d(-50%, -50%, 0)
      scale(1.06);
  }

}


/* ---------------------------------------------------------
   4. WHITE BUTTON SURFACE
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon {
  position:
    absolute !important;

  inset:
    0 !important;

  z-index:
    3 !important;

  overflow:
    hidden !important;

  border-radius:
    999px !important;

  isolation:
    isolate !important;

  background:
    rgba(255,255,255,.985) !important;

  box-shadow:
    0 8px 28px rgba(29,29,31,.075),
    inset 0 0 0 1px rgba(29,29,31,.075) !important;
}


/* ---------------------------------------------------------
   5. STRONGER VISIBLE MUSTARD SHIMMER
   This passes ACROSS the white circle.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::before {
  content:
    "" !important;

  display:
    block !important;

  position:
    absolute !important;

  z-index:
    4 !important;

  top:
    -25% !important;

  bottom:
    -25% !important;

  left:
    -85% !important;

  width:
    56% !important;

  height:
    auto !important;

  pointer-events:
    none !important;

  opacity:
    0;

  border-radius:
    999px !important;

  background:
    linear-gradient(
      108deg,
      rgba(245,179,53,0) 0%,
      rgba(245,179,53,.025) 16%,
      rgba(245,179,53,.20) 34%,
      rgba(255,216,130,.62) 49%,
      rgba(245,179,53,.27) 63%,
      rgba(245,179,53,.05) 82%,
      rgba(245,179,53,0) 100%
    ) !important;

  filter:
    blur(1px) !important;

  transform:
    skewX(-18deg) !important;

  mix-blend-mode:
    multiply !important;

  will-change:
    left,
    opacity !important;

  animation:
    stLauncherShimmerFinal
    3.55s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stLauncherShimmerFinal {

  0% {
    left:
      -85%;

    opacity:
      0;
  }

  18% {
    left:
      -85%;

    opacity:
      0;
  }

  26% {
    opacity:
      .92;
  }

  49% {
    left:
      134%;

    opacity:
      .84;
  }

  58% {
    left:
      134%;

    opacity:
      0;
  }

  100% {
    left:
      134%;

    opacity:
      0;
  }

}


/* ---------------------------------------------------------
   6. VERY SUBTLE MUSTARD SURFACE BREATH
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::after {
  content:
    "" !important;

  display:
    block !important;

  position:
    absolute !important;

  z-index:
    1 !important;

  inset:
    0 !important;

  pointer-events:
    none !important;

  border-radius:
    inherit !important;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(245,179,53,.085) 0%,
      rgba(245,179,53,.03) 46%,
      rgba(245,179,53,0) 72%
    ) !important;

  opacity:
    .18 !important;

  animation:
    stLauncherSurfaceBreathFinal
    2.9s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stLauncherSurfaceBreathFinal {

  0%,
  100% {
    opacity:
      .10;
  }

  45% {
    opacity:
      .42;
  }

}


/* ---------------------------------------------------------
   7. ICONS MUST STAY ABOVE THE SHIMMER
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer {
  z-index:
    6 !important;
}


/*
 * Give the icon itself a very subtle light pickup when the
 * shimmer passes. This prevents the shimmer from feeling
 * completely disconnected from the logo.
 */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer svg {
  filter:
    drop-shadow(
      0 0 0
      rgba(245,179,53,0)
    );

  transition:
    filter 260ms ease !important;
}


/* ---------------------------------------------------------
   8. KEEP LIGHT ACTIVE IN BOTH MODES
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
.st3-ai-launcher__pulse--outer,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:focus-visible
.st3-ai-launcher__pulse--outer,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:active
.st3-ai-launcher__pulse--outer {
  animation:
    stLauncherOuterBreathFinal
    2.9s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
.st3-ai-launcher__pulse--inner,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:focus-visible
.st3-ai-launcher__pulse--inner,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]:active
.st3-ai-launcher__pulse--inner {
  animation:
    stLauncherInnerBreathFinal
    2.9s
    .16s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


/* ---------------------------------------------------------
   9. CHAT OPEN STATE
   Keep the aura restrained, but don't let legacy rules kill it.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"].st3-ai-launcher--open
.st3-ai-launcher__pulse--outer {
  animation:
    none !important;

  opacity:
    .12 !important;

  transform:
    translate3d(-50%,-50%,0)
    scale(.92) !important;
}


html body
button.st3-ai-launcher[data-st-ai-launcher="true"].st3-ai-launcher--open
.st3-ai-launcher__pulse--inner {
  animation:
    none !important;

  opacity:
    .10 !important;

  transform:
    translate3d(-50%,-50%,0)
    scale(.95) !important;
}


/* ---------------------------------------------------------
   10. HOVER — SLIGHTLY MORE NOTICEABLE
   --------------------------------------------------------- */

@media (hover: hover) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__icon {
    box-shadow:
      0 10px 32px rgba(29,29,31,.09),
      0 0 0 1px rgba(245,179,53,.16),
      inset 0 0 0 1px rgba(245,179,53,.10)
      !important;
  }

}


/* ---------------------------------------------------------
   11. MOBILE — RETAIN EFFECT, SLIGHTLY TIGHTER
   --------------------------------------------------------- */

@media (max-width: 700px) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--outer {
    width:
      100px !important;

    height:
      100px !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--inner {
    width:
      76px !important;

    height:
      76px !important;
  }

}


/* ---------------------------------------------------------
   12. ACCESSIBILITY
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--outer,

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--inner,

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__icon::before,

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__icon::after {
    animation:
      none !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--outer {
    opacity:
      .28 !important;

    transform:
      translate3d(-50%,-50%,0)
      scale(.96) !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__pulse--inner {
    opacity:
      .22 !important;

    transform:
      translate3d(-50%,-50%,0)
      scale(1) !important;
  }

}

/* === ST LAUNCHER LIGHT EFFECTS FINAL END === */

/* === ST REAL LAUNCHER LIGHT V1 START === */

/* =========================================================
   STEREOPHONIE — REAL FLOATING LAUNCHER LIGHT

   IMPORTANT:
   Previous pseudo-element / pulse experiments are disabled.

   The new system uses:
   1. .st3-ai-launcher__aura-live
   2. .st3-ai-launcher__shimmer-live

   Both are REAL DOM elements.
   ========================================================= */


/* ---------------------------------------------------------
   A. LAUNCHER ROOT
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"] {
  isolation: isolate !important;

  overflow: visible !important;

  contain: none !important;

  /*
   * Never let an old rule turn the entire launcher into
   * a clipping mask.
   */
  clip-path: none !important;

  -webkit-mask-image: none !important;
  mask-image: none !important;
}


/* ---------------------------------------------------------
   B. DISABLE THE OLD DISPLACED GLOW SYSTEM
   This is the mustard patch visible BELOW your button
   in the screenshot.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--outer,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__pulse--inner {
  display: none !important;

  visibility: hidden !important;

  opacity: 0 !important;

  animation: none !important;

  transform: none !important;

  filter: none !important;

  box-shadow: none !important;
}


/* ---------------------------------------------------------
   C. REAL CENTERED BREATHING AURA

   No negative z-index.
   No margins.
   No top/left offset tricks.

   It is geometrically centered on the launcher.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__aura-live {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 104px !important;
  height: 104px !important;

  z-index: 1 !important;

  display: block !important;
  visibility: visible !important;

  margin: 0 !important;
  padding: 0 !important;

  pointer-events: none !important;

  border: 0 !important;
  border-radius: 999px !important;

  opacity: .34;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(246,181,54,.46) 0%,
      rgba(246,181,54,.32) 20%,
      rgba(246,181,54,.20) 38%,
      rgba(246,181,54,.10) 52%,
      rgba(246,181,54,.035) 67%,
      rgba(246,181,54,0) 79%
    ) !important;

  filter:
    blur(7px) !important;

  transform:
    translate3d(-50%, -50%, 0)
    scale(.78);

  transform-origin:
    center center !important;

  will-change:
    opacity,
    transform,
    filter;

  animation:
    stRealLauncherBreathe
    2.85s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stRealLauncherBreathe {

  0%,
  100% {
    opacity: .20;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.78);

    filter:
      blur(7px);
  }

  42% {
    opacity: .78;

    transform:
      translate3d(-50%, -50%, 0)
      scale(1.06);

    filter:
      blur(10px);
  }

  63% {
    opacity: .48;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.95);

    filter:
      blur(8px);
  }

}


/* ---------------------------------------------------------
   D. WHITE CIRCULAR VISUAL SURFACE

   Keep this above the aura.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon {
  z-index: 3 !important;

  overflow: hidden !important;

  isolation: isolate !important;

  border-radius: 999px !important;

  background:
    rgba(255,255,255,.985) !important;

  box-shadow:
    0 7px 24px rgba(29,29,31,.075),
    inset 0 0 0 1px rgba(29,29,31,.08)
    !important;
}


/* ---------------------------------------------------------
   E. REAL SHIMMER ELEMENT

   This is NOT a pseudo-element.

   It is exactly the same circular size as the launcher and
   is clipped to a circle by its own border radius.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__shimmer-live {
  position: absolute !important;

  inset: 0 !important;

  z-index: 12 !important;

  display: block !important;
  visibility: visible !important;

  overflow: hidden !important;

  pointer-events: none !important;

  border-radius: 999px !important;

  opacity: 1 !important;

  /*
   * Gradient is deliberately wider than the circle.
   */
  background:
    linear-gradient(
      112deg,
      rgba(246,181,54,0) 16%,
      rgba(246,181,54,.02) 29%,
      rgba(246,181,54,.16) 40%,
      rgba(255,216,126,.52) 48%,
      rgba(246,181,54,.29) 54%,
      rgba(246,181,54,.06) 63%,
      rgba(246,181,54,0) 75%
    ) !important;

  background-size:
    260% 100% !important;

  background-position:
    145% 0;

  background-repeat:
    no-repeat !important;

  mix-blend-mode:
    multiply;

  will-change:
    background-position,
    opacity;

  animation:
    stRealLauncherShimmer
    3.45s
    cubic-bezier(.4,0,.2,1)
    infinite !important;
}


@keyframes stRealLauncherShimmer {

  0% {
    background-position:
      145% 0;

    opacity:
      0;
  }

  15% {
    background-position:
      145% 0;

    opacity:
      0;
  }

  23% {
    opacity:
      .92;
  }

  51% {
    background-position:
      -145% 0;

    opacity:
      .86;
  }

  59% {
    background-position:
      -145% 0;

    opacity:
      0;
  }

  100% {
    background-position:
      -145% 0;

    opacity:
      0;
  }

}


/* ---------------------------------------------------------
   F. ICONS

   Keep icon visible while shimmer passes over it.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon-layer {
  z-index: 6 !important;
}


/*
 * The real shimmer is z-index 12, so its light passes across
 * both the white surface AND the black AI/WhatsApp mark.
 *
 * It remains subtle because of multiply + translucent mustard.
 */


/* ---------------------------------------------------------
   G. REMOVE OLD PSEUDO SHIMMERS COMPLETELY

   Prevent a previous version from competing with the new
   real DOM shimmer.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::before,

html body
button.st3-ai-launcher[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::after {
  content: none !important;

  display: none !important;

  animation: none !important;
}


/* ---------------------------------------------------------
   H. HOVER

   Slightly intensify the attraction light, but no movement.
   --------------------------------------------------------- */

@media (hover: hover) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__aura-live {
    animation-duration:
      2.3s !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__shimmer-live {
    animation-duration:
      2.65s !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]:hover
  .st3-ai-launcher__icon {
    box-shadow:
      0 9px 28px rgba(29,29,31,.085),
      0 0 0 1px rgba(246,181,54,.17),
      inset 0 0 0 1px rgba(246,181,54,.10)
      !important;
  }

}


/* ---------------------------------------------------------
   I. WHEN THE AI CHAT ITSELF IS OPEN

   Reduce attraction effects while customer is already
   interacting with the assistant.
   --------------------------------------------------------- */

html body
button.st3-ai-launcher[data-st-ai-launcher="true"].st3-ai-launcher--open
.st3-ai-launcher__aura-live {
  animation-play-state: paused !important;

  opacity: .10 !important;

  transform:
    translate3d(-50%, -50%, 0)
    scale(.86) !important;
}


html body
button.st3-ai-launcher[data-st-ai-launcher="true"].st3-ai-launcher--open
.st3-ai-launcher__shimmer-live {
  animation-play-state: paused !important;

  opacity: 0 !important;
}


/* ---------------------------------------------------------
   J. MOBILE

   Keep it attractive without producing the giant displaced
   yellow patch seen in the screenshot.
   --------------------------------------------------------- */

@media (max-width: 700px) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__aura-live {
    width: 94px !important;
    height: 94px !important;
  }

}


/* ---------------------------------------------------------
   K. ACCESSIBILITY
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__aura-live {
    animation: none !important;

    opacity: .32 !important;

    transform:
      translate3d(-50%, -50%, 0)
      scale(.92) !important;
  }


  html body
  button.st3-ai-launcher[data-st-ai-launcher="true"]
  .st3-ai-launcher__shimmer-live {
    animation: none !important;

    opacity: 0 !important;
  }

}

/* === ST REAL LAUNCHER LIGHT V1 END === */

/* === ST ACCOUNT APPLE FINAL START === */

/* ============================================================
   STEREOPHONIE — MY ACCOUNT
   CLEAN / PREMIUM / APPLE-INSPIRED RETAIL INTERFACE

   This layer is intentionally scoped ONLY to .st-account-retail.

   It does NOT alter:
   - account data
   - Supabase
   - forms/actions
   - order logic
   - addresses
   - authentication
   - wishlist
   - header
   - footer
   - shop
   - product pages
   ============================================================ */


/* ------------------------------------------------------------
   1. ACCOUNT PAGE FOUNDATION
   ------------------------------------------------------------ */

html body .st-account-retail {
  --account-ink: #1d1d1f;
  --account-muted: #6e6e73;
  --account-soft: #f5f5f7;
  --account-soft-2: #fafafa;
  --account-line: rgba(0, 0, 0, .085);
  --account-mustard: #f5b335;

  background: #fff !important;
  color: var(--account-ink) !important;

  padding:
    clamp(34px, 4.2vw, 64px)
    0
    clamp(80px, 9vw, 130px)
    !important;
}


html body .st-account-retail__shell {
  width:
    min(
      calc(100% - 48px),
      1180px
    ) !important;

  margin:
    0 auto !important;
}


/* ------------------------------------------------------------
   2. TOP ACCOUNT HERO
   ------------------------------------------------------------ */

html body .st-account-retail__intro {
  display:
    grid !important;

  grid-template-columns:
    minmax(0, 1fr) !important;

  gap:
    28px !important;

  margin:
    0 !important;

  padding:
    clamp(32px, 4vw, 54px) !important;

  border:
    0 !important;

  border-radius:
    30px !important;

  background:
    #f5f5f7 !important;

  box-shadow:
    none !important;
}


html body .st-account-retail__identity {
  display:
    flex !important;

  align-items:
    center !important;

  gap:
    22px !important;
}


html body .st-account-retail__avatar {
  width:
    64px !important;

  height:
    64px !important;

  flex:
    0 0 64px !important;

  display:
    grid !important;

  place-items:
    center !important;

  border:
    1px solid rgba(0,0,0,.08) !important;

  border-radius:
    50% !important;

  background:
    rgba(255,255,255,.88) !important;

  box-shadow:
    0 8px 25px rgba(0,0,0,.04) !important;
}


html body .st-account-retail__avatar svg {
  width:
    23px !important;

  height:
    23px !important;

  stroke-width:
    1.5 !important;
}


html body .st-account-retail__eyebrow {
  display:
    block !important;

  margin:
    0 0 7px !important;

  color:
    #86868b !important;

  font-size:
    12px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


html body .st-account-retail__identity h1 {
  margin:
    0 !important;

  color:
    var(--account-ink) !important;

  font-size:
    clamp(38px, 4.2vw, 56px) !important;

  line-height:
    .98 !important;

  font-weight:
    650 !important;

  letter-spacing:
    -.055em !important;

  text-transform:
    none !important;
}


html body .st-account-retail__identity p {
  max-width:
    700px !important;

  margin:
    12px 0 0 !important;

  color:
    var(--account-muted) !important;

  font-size:
    14px !important;

  line-height:
    1.55 !important;

  letter-spacing:
    0 !important;
}


/* ------------------------------------------------------------
   3. SUMMARY CARDS
   ------------------------------------------------------------ */

html body .st-account-retail__summary {
  display:
    grid !important;

  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;

  gap:
    12px !important;
}


html body .st-account-retail__summary > * {
  min-height:
    110px !important;

  padding:
    20px !important;

  border:
    1px solid rgba(0,0,0,.065) !important;

  border-radius:
    20px !important;

  background:
    rgba(255,255,255,.76) !important;

  box-shadow:
    none !important;
}


html body .st-account-retail__summary svg {
  width:
    15px !important;

  height:
    15px !important;

  color:
    #86868b !important;
}


html body .st-account-retail__summary small,
html body .st-account-retail__summary span {
  color:
    #86868b !important;

  font-size:
    11px !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


html body .st-account-retail__summary strong {
  color:
    var(--account-ink) !important;

  font-size:
    21px !important;

  line-height:
    1.1 !important;

  font-weight:
    620 !important;

  letter-spacing:
    -.025em !important;

  text-transform:
    none !important;
}


/* ------------------------------------------------------------
   4. QUICK ACCOUNT LINKS
   ------------------------------------------------------------ */

html body .st-account-retail__quick {
  display:
    grid !important;

  grid-template-columns:
    repeat(2, minmax(0, 1fr)) !important;

  gap:
    10px !important;

  margin:
    28px 0 0 !important;

  padding:
    0 !important;

  border:
    0 !important;

  background:
    transparent !important;
}


html body .st-account-retail__quick > a,
html body .st-account-retail__quick > button {
  min-height:
    76px !important;

  display:
    flex !important;

  align-items:
    center !important;

  gap:
    16px !important;

  padding:
    14px 18px !important;

  border:
    1px solid var(--account-line) !important;

  border-radius:
    18px !important;

  background:
    #fff !important;

  color:
    var(--account-ink) !important;

  box-shadow:
    0 4px 16px rgba(0,0,0,.018) !important;

  transform:
    none !important;

  text-decoration:
    none !important;

  transition:
    background-color 200ms ease,
    border-color 200ms ease,
    box-shadow 200ms ease !important;
}


@media (hover: hover) {

  html body .st-account-retail__quick > a:hover,
  html body .st-account-retail__quick > button:hover {
    background:
      #f8f8fa !important;

    border-color:
      rgba(0,0,0,.12) !important;

    box-shadow:
      0 8px 24px rgba(0,0,0,.035) !important;

    transform:
      none !important;
  }

}


html body .st-account-retail__quick-icon {
  width:
    38px !important;

  height:
    38px !important;

  flex:
    0 0 38px !important;

  display:
    grid !important;

  place-items:
    center !important;

  border-radius:
    50% !important;

  background:
    #f5f5f7 !important;
}


html body .st-account-retail__quick-icon svg {
  width:
    17px !important;

  height:
    17px !important;

  stroke-width:
    1.6 !important;
}


html body .st-account-retail__quick small {
  display:
    block !important;

  margin-bottom:
    3px !important;

  color:
    #86868b !important;

  font-size:
    10px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


html body .st-account-retail__quick strong,
html body .st-account-retail__quick span {
  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ------------------------------------------------------------
   5. MAIN MODULE SEPARATION
   ------------------------------------------------------------ */

html body .st-account-retail__module {
  margin:
    clamp(62px, 7vw, 92px)
    0
    0
    !important;

  padding:
    0 !important;

  border:
    0 !important;

  background:
    transparent !important;
}


html body .st-account-retail__module-head {
  display:
    flex !important;

  align-items:
    flex-end !important;

  justify-content:
    space-between !important;

  gap:
    24px !important;

  margin:
    0 0 24px !important;

  padding:
    0 !important;

  border:
    0 !important;

  background:
    transparent !important;
}


html body .st-account-retail__module-head small {
  color:
    #86868b !important;

  font-size:
    11px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


html body .st-account-retail__module-head h2 {
  margin:
    6px 0 0 !important;

  color:
    var(--account-ink) !important;

  font-size:
    clamp(30px, 3vw, 40px) !important;

  line-height:
    1 !important;

  font-weight:
    640 !important;

  letter-spacing:
    -.045em !important;

  text-transform:
    none !important;
}


html body .st-account-retail__module-head p {
  margin:
    10px 0 0 !important;

  color:
    var(--account-muted) !important;

  font-size:
    13px !important;

  line-height:
    1.55 !important;
}


html body .st-account-retail__module-mark {
  width:
    42px !important;

  height:
    42px !important;

  display:
    grid !important;

  place-items:
    center !important;

  border:
    1px solid var(--account-line) !important;

  border-radius:
    50% !important;

  background:
    #fff !important;
}


html body .st-account-retail__module-mark svg {
  width:
    17px !important;

  height:
    17px !important;
}


/* ------------------------------------------------------------
   6. REMOVE DUPLICATED INNER TITLES

   The outer command-center already says:
   Profile & delivery.
   Your orders.

   So the old second title inside each legacy component is hidden.
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
> section
> div:first-child {
  display:
    none !important;
}


/* ------------------------------------------------------------
   7. PROFILE / DELIVERY CARD
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
> section {
  overflow:
    hidden !important;

  border:
    1px solid var(--account-line) !important;

  border-radius:
    24px !important;

  background:
    #fff !important;

  box-shadow:
    0 8px 34px rgba(0,0,0,.025) !important;
}


/*
   The existing settings component has:
   grid = nav + content.

   Convert that architecture into:
   horizontal Apple-like tabs
   +
   content below.
*/

html body
.st-account-retail__module-content
> section
> .grid {
  display:
    block !important;
}


html body
.st-account-retail__module-content
> section
> .grid
> nav {
  display:
    flex !important;

  align-items:
    center !important;

  gap:
    6px !important;

  overflow-x:
    auto !important;

  padding:
    12px !important;

  border:
    0 !important;

  border-bottom:
    1px solid var(--account-line) !important;

  background:
    #fafafa !important;

  scrollbar-width:
    none !important;
}


html body
.st-account-retail__module-content
> section
> .grid
> nav::-webkit-scrollbar {
  display:
    none !important;
}


html body
.st-account-retail__module-content
> section
> .grid
> nav > button {
  width:
    auto !important;

  min-width:
    max-content !important;

  min-height:
    38px !important;

  margin:
    0 !important;

  padding:
    0 15px !important;

  display:
    inline-flex !important;

  align-items:
    center !important;

  justify-content:
    center !important;

  gap:
    9px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    transparent !important;

  color:
    #6e6e73 !important;

  box-shadow:
    none !important;

  font-size:
    12px !important;

  line-height:
    1 !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;

  transition:
    background-color 180ms ease,
    color 180ms ease !important;
}


/*
   Existing active settings tab is currently black.
   Preserve active-state recognition but soften it.
*/

html body
.st-account-retail__module-content
> section
> .grid
> nav > button[class*="bg-black"],
html body
.st-account-retail__module-content
> section
> .grid
> nav > button[class*="text-white"] {
  background:
    #1d1d1f !important;

  color:
    #fff !important;
}


/* Sign out area */

html body
.st-account-retail__module-content
> section
> .grid
> nav
> div {
  margin:
    0 0 0 auto !important;

  padding:
    0 !important;

  border:
    0 !important;
}


html body
.st-account-retail__module-content
> section
> .grid
> nav
> div
button {
  min-height:
    38px !important;

  padding:
    0 14px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    transparent !important;

  color:
    #c9342f !important;

  font-size:
    11px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* Profile content area */

html body
.st-account-retail__module-content
> section
> .grid
> div:last-child {
  padding:
    clamp(24px, 4vw, 42px) !important;
}


/* ------------------------------------------------------------
   8. PROFILE TYPOGRAPHY
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content h3 {
  margin:
    0 !important;

  color:
    var(--account-ink) !important;

  font-size:
    24px !important;

  line-height:
    1.1 !important;

  font-weight:
    620 !important;

  letter-spacing:
    -.035em !important;

  text-transform:
    none !important;
}


html body
.st-account-retail__module-content
p[class*="uppercase"],
html body
.st-account-retail__module-content
label {
  letter-spacing:
    0 !important;
}


html body
.st-account-retail__module-content
label {
  color:
    #6e6e73 !important;

  font-size:
    12px !important;

  font-weight:
    500 !important;

  text-transform:
    none !important;
}


/* ------------------------------------------------------------
   9. FORM FIELDS
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content input,
html body
.st-account-retail__module-content select,
html body
.st-account-retail__module-content textarea {
  min-height:
    50px !important;

  border:
    1px solid rgba(0,0,0,.10) !important;

  border-radius:
    12px !important;

  background:
    #f7f7f8 !important;

  color:
    var(--account-ink) !important;

  box-shadow:
    none !important;

  font-size:
    14px !important;

  letter-spacing:
    0 !important;

  outline:
    none !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}


html body
.st-account-retail__module-content input:focus,
html body
.st-account-retail__module-content select:focus,
html body
.st-account-retail__module-content textarea:focus {
  background:
    #fff !important;

  border-color:
    rgba(0,0,0,.30) !important;

  box-shadow:
    0 0 0 4px rgba(0,0,0,.035) !important;
}


html body
.st-account-retail__module-content
input:disabled,
html body
.st-account-retail__module-content
input[readonly] {
  color:
    #6e6e73 !important;

  background:
    #f5f5f7 !important;
}


/* Email LOCKED addon and telephone containers */

html body
.st-account-retail__module-content
div[class*="border-neutral-200"],
html body
.st-account-retail__module-content
div[class*="border-neutral-300"] {
  border-color:
    rgba(0,0,0,.09);
}


/* ------------------------------------------------------------
   10. PRIMARY ACCOUNT ACTION BUTTONS
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
.st-player-command-button--primary,
html body
.st-account-retail__module-content
button[class*="bg-black"]:not([class*="red"]),
html body
.st-account-retail__module-content
button[type="submit"]:not([class*="red"]) {
  min-height:
    44px !important;

  padding:
    0 20px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    var(--account-mustard) !important;

  color:
    #1d1d1f !important;

  box-shadow:
    none !important;

  font-size:
    12px !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;

  transform:
    none !important;

  transition:
    filter 180ms ease,
    box-shadow 180ms ease !important;
}


@media (hover: hover) {

  html body
  .st-account-retail__module-content
  .st-player-command-button--primary:hover,
  html body
  .st-account-retail__module-content
  button[type="submit"]:not([class*="red"]):hover {
    filter:
      brightness(.975) !important;

    box-shadow:
      0 7px 20px rgba(245,179,53,.15) !important;

    transform:
      none !important;
  }

}


/* ------------------------------------------------------------
   11. ORDERS — CLEAN UP OLD NESTED STRUCTURE
   ------------------------------------------------------------ */

/*
   Orders use the same section shell as profile.
   Hide its duplicated internal heading with rule #6.
*/

html body
.st-account-retail__module:nth-of-type(2)
.st-account-retail__module-content
> section {
  padding:
    0 !important;
}


html body
.st-account-retail__module:nth-of-type(2)
.st-account-retail__module-content
> section
> div:last-child {
  padding:
    clamp(18px, 3vw, 30px) !important;
}


/* ------------------------------------------------------------
   12. ORDER TABS
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
#customer-orders
button {
  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


html body
.st-account-retail__module-content
#customer-orders
> div:last-child
> div:first-child {
  width:
    fit-content !important;

  display:
    inline-flex !important;

  gap:
    4px !important;

  padding:
    4px !important;

  overflow:
    visible !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #f5f5f7 !important;
}


html body
.st-account-retail__module-content
#customer-orders
> div:last-child
> div:first-child
> button {
  min-height:
    36px !important;

  padding:
    0 15px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  color:
    #6e6e73 !important;

  background:
    transparent !important;

  font-size:
    12px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/*
   Existing active tab carries border-black/text-black.
*/

html body
.st-account-retail__module-content
#customer-orders
button[class*="border-black"] {
  background:
    #fff !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 1px 4px rgba(0,0,0,.08) !important;
}


/* ------------------------------------------------------------
   13. EMPTY ORDERS
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
.st-player-order-empty {
  min-height:
    250px !important;

  display:
    flex !important;

  flex-direction:
    column !important;

  align-items:
    center !important;

  justify-content:
    center !important;

  margin:
    24px 0 0 !important;

  padding:
    46px 24px !important;

  border:
    0 !important;

  border-radius:
    20px !important;

  background:
    #f7f7f8 !important;

  background-image:
    none !important;

  text-align:
    center !important;
}


html body
.st-account-retail__module-content
.st-player-order-empty p:first-child {
  color:
    #1d1d1f !important;

  font-size:
    18px !important;

  line-height:
    1.2 !important;

  font-weight:
    600 !important;

  letter-spacing:
    -.02em !important;

  text-transform:
    none !important;
}


html body
.st-account-retail__module-content
.st-player-order-empty p:nth-child(2) {
  max-width:
    430px !important;

  margin:
    8px auto 0 !important;

  color:
    #86868b !important;

  font-size:
    13px !important;

  line-height:
    1.55 !important;
}


html body
.st-account-retail__module-content
.st-player-order-empty
a {
  min-height:
    42px !important;

  display:
    inline-flex !important;

  align-items:
    center !important;

  justify-content:
    center !important;

  margin:
    22px 0 0 !important;

  padding:
    0 20px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    var(--account-mustard) !important;

  color:
    #1d1d1f !important;

  box-shadow:
    none !important;

  font-size:
    12px !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;

  text-decoration:
    none !important;
}


/* ------------------------------------------------------------
   14. REAL ORDER CARDS
   ------------------------------------------------------------ */

html body
.st-account-retail__module-content
#customer-orders article {
  overflow:
    hidden !important;

  border:
    1px solid var(--account-line) !important;

  border-radius:
    20px !important;

  background:
    #fff !important;

  box-shadow:
    none !important;
}


html body
.st-account-retail__module-content
#customer-orders article h3 {
  font-size:
    20px !important;

  letter-spacing:
    -.025em !important;

  text-transform:
    none !important;
}


html body
.st-account-retail__module-content
#customer-orders article p,
html body
.st-account-retail__module-content
#customer-orders article span {
  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* Status pills */

html body
.st-account-retail__module-content
#customer-orders article
span[class*="bg-black"] {
  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #1d1d1f !important;

  padding:
    7px 11px !important;

  color:
    #fff !important;

  font-size:
    10px !important;
}


/* ------------------------------------------------------------
   15. MESSAGES
   ------------------------------------------------------------ */

html body .st-account-retail__messages {
  margin:
    18px 0 0 !important;
}


html body .st-account-retail__messages > div {
  padding:
    13px 15px !important;

  border-radius:
    12px !important;

  font-size:
    13px !important;

  letter-spacing:
    0 !important;
}


/* ------------------------------------------------------------
   16. REMOVE OLD ARCADE-LIKE ACCOUNT EFFECTS
   ------------------------------------------------------------ */

html body .st-account-retail *,
html body .st-account-retail *::before,
html body .st-account-retail *::after {
  text-shadow:
    none !important;
}


html body .st-account-retail :is(
  h1,
  h2,
  h3,
  h4,
  p,
  label,
  button,
  a,
  span,
  small,
  strong
) {
  font-family:
    inherit !important;
}


/* ------------------------------------------------------------
   17. RESPONSIVE
   ------------------------------------------------------------ */

@media (max-width: 800px) {

  html body .st-account-retail {
    padding-top:
      24px !important;
  }


  html body .st-account-retail__shell {
    width:
      calc(100% - 28px) !important;
  }


  html body .st-account-retail__intro {
    padding:
      25px 20px !important;

    border-radius:
      24px !important;
  }


  html body .st-account-retail__identity {
    align-items:
      flex-start !important;
  }


  html body .st-account-retail__avatar {
    width:
      52px !important;

    height:
      52px !important;

    flex-basis:
      52px !important;
  }


  html body .st-account-retail__identity h1 {
    font-size:
      clamp(34px, 10vw, 46px) !important;
  }


  html body .st-account-retail__summary {
    grid-template-columns:
      1fr !important;
  }


  html body .st-account-retail__quick {
    grid-template-columns:
      1fr !important;
  }


  html body .st-account-retail__module {
    margin-top:
      58px !important;
  }


  html body .st-account-retail__module-head {
    align-items:
      flex-start !important;
  }


  html body
  .st-account-retail__module-content
  > section {
    border-radius:
      20px !important;
  }


  html body
  .st-account-retail__module-content
  > section
  > .grid
  > nav {
    padding:
      10px !important;
  }


  html body
  .st-account-retail__module-content
  > section
  > .grid
  > div:last-child {
    padding:
      22px 18px !important;
  }


  html body
  .st-account-retail__module-content
  input,
  html body
  .st-account-retail__module-content
  select,
  html body
  .st-account-retail__module-content
  textarea {
    font-size:
      16px !important;
  }

}


/* ------------------------------------------------------------
   18. REDUCED MOTION
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {

  html body .st-account-retail *,
  html body .st-account-retail *::before,
  html body .st-account-retail *::after {
    animation:
      none !important;

    transition:
      none !important;
  }

}

/* === ST ACCOUNT APPLE FINAL END === */

/* === ST ACCOUNT POLISH V2 START === */

/* ==========================================================
   STEREOPHONIE ACCOUNT — FINAL ARCADE CLEANUP

   PURPOSE
   -------
   Keep the new account architecture exactly as it is,
   while removing the remaining arcade / gaming UI remnants.

   Scoped ONLY to:
   .st-account-retail
   ========================================================== */


/* ==========================================================
   1. REMOVE OLD GREEN LED / ARCADE BUTTON DETAILS
   ========================================================== */

/*
   Historical account buttons added tiny green signal lights.
   They do not belong in the new retail interface.
*/

html body
.st-account-retail
.st-player-command-button::before,

html body
.st-account-retail
.st-player-command-button::after,

html body
.st-account-retail
.st-player-command-button--primary::before,

html body
.st-account-retail
.st-player-command-button--primary::after {
  content:
    none !important;

  display:
    none !important;

  visibility:
    hidden !important;

  opacity:
    0 !important;

  animation:
    none !important;
}


/*
   Also neutralize any old LED element physically inserted
   inside account command buttons.
*/

html body
.st-account-retail
.st-player-command-button
:is(
  i,
  [class*="led"],
  [class*="signal"],
  [class*="pulse"]
) {
  display:
    none !important;
}


/*
   Mustard actions should be clean typography only.
*/

html body
.st-account-retail
.st-player-command-button,
html body
.st-account-retail
.st-player-command-button--primary {
  gap:
    0 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ==========================================================
   2. REMOVE GREEN DOTS FROM ACCOUNT SUBMIT BUTTONS
   ========================================================== */

html body
.st-account-retail
button[type="submit"]::before,

html body
.st-account-retail
button[type="submit"]::after {
  content:
    none !important;

  display:
    none !important;

  opacity:
    0 !important;

  animation:
    none !important;
}


/*
   If an old real DOM LED was placed as the first tiny element.
*/

html body
.st-account-retail
button[type="submit"]
> i:first-child,

html body
.st-account-retail
button[type="submit"]
> [class*="led"]:first-child,

html body
.st-account-retail
button[type="submit"]
> [class*="pulse"]:first-child {
  display:
    none !important;
}


/* ==========================================================
   3. CLEAN MUSTARD ACCOUNT BUTTONS
   ========================================================== */

html body
.st-account-retail
:is(
  .st-player-command-button--primary,
  button[type="submit"]:not([class*="red"])
) {
  min-height:
    42px !important;

  padding:
    0 19px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #f5b335 !important;

  color:
    #1d1d1f !important;

  box-shadow:
    none !important;

  font-size:
    12px !important;

  line-height:
    1 !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;

  transform:
    none !important;

  transition:
    background-color 180ms ease,
    box-shadow 180ms ease,
    filter 180ms ease !important;
}


@media (hover: hover) {

  html body
  .st-account-retail
  :is(
    .st-player-command-button--primary,
    button[type="submit"]:not([class*="red"])
  ):hover {
    filter:
      brightness(.975) !important;

    box-shadow:
      0 7px 20px
      rgba(245, 179, 53, .14) !important;

    transform:
      none !important;
  }

}


/* ==========================================================
   4. STOCK EMAIL SWITCH — REAL RETAIL SWITCH
   ========================================================== */

/*
   We support both common implementations:
   - role="switch"
   - aria-pressed boolean button

   The second selector is restricted to rounded controls so
   normal buttons are never affected.
*/

html body
.st-account-retail
button[role="switch"],

html body
.st-account-retail
button[aria-pressed="true"][class*="rounded-full"],

html body
.st-account-retail
button[aria-pressed="false"][class*="rounded-full"] {
  position:
    relative !important;

  width:
    48px !important;

  min-width:
    48px !important;

  height:
    28px !important;

  min-height:
    28px !important;

  display:
    block !important;

  flex:
    0 0 48px !important;

  margin:
    0 !important;

  padding:
    0 !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  box-shadow:
    none !important;

  transform:
    none !important;

  cursor:
    pointer !important;

  transition:
    background-color 220ms cubic-bezier(.22,.61,.36,1),
    box-shadow 220ms cubic-bezier(.22,.61,.36,1)
    !important;
}


/* OFF */

html body
.st-account-retail
button[role="switch"][aria-checked="false"],

html body
.st-account-retail
button[aria-pressed="false"][class*="rounded-full"] {
  background:
    #d2d2d7 !important;

  border-color:
    transparent !important;
}


/* ON */

html body
.st-account-retail
button[role="switch"][aria-checked="true"],

html body
.st-account-retail
button[aria-pressed="true"][class*="rounded-full"] {
  background:
    #f5b335 !important;

  border-color:
    transparent !important;

  box-shadow:
    0 0 0 1px
    rgba(245,179,53,.06) !important;
}


/*
   Real knob.
   Covers the normal implementation where the switch contains
   one span for its circular thumb.
*/

html body
.st-account-retail
button[role="switch"]
> span:last-child,

html body
.st-account-retail
button[aria-pressed][class*="rounded-full"]
> span:last-child {
  position:
    absolute !important;

  top:
    3px !important;

  left:
    3px !important;

  width:
    22px !important;

  height:
    22px !important;

  margin:
    0 !important;

  padding:
    0 !important;

  border:
    0 !important;

  border-radius:
    50% !important;

  background:
    #fff !important;

  box-shadow:
    0 1px 3px
    rgba(0,0,0,.16) !important;

  transform:
    translate3d(0,0,0) !important;

  transition:
    transform 240ms
    cubic-bezier(.22,.61,.36,1)
    !important;

  pointer-events:
    none !important;
}


/* knob ON */

html body
.st-account-retail
button[role="switch"][aria-checked="true"]
> span:last-child,

html body
.st-account-retail
button[aria-pressed="true"][class*="rounded-full"]
> span:last-child {
  transform:
    translate3d(20px,0,0) !important;
}


/* knob OFF */

html body
.st-account-retail
button[role="switch"][aria-checked="false"]
> span:last-child,

html body
.st-account-retail
button[aria-pressed="false"][class*="rounded-full"]
> span:last-child {
  transform:
    translate3d(0,0,0) !important;
}


/*
   Kill old arcade pseudo-knobs so they cannot create a
   doubled / lagging switch.
*/

html body
.st-account-retail
button[role="switch"]::before,

html body
.st-account-retail
button[role="switch"]::after,

html body
.st-account-retail
button[aria-pressed][class*="rounded-full"]::before,

html body
.st-account-retail
button[aria-pressed][class*="rounded-full"]::after {
  content:
    none !important;

  display:
    none !important;
}


/* ==========================================================
   5. STOCK EMAIL CARD — SOFTER + SIMPLER
   ========================================================== */

html body
.st-account-retail
section
[class*="communication"] {
  box-shadow:
    none !important;
}


/*
   Reduce old uppercase / command-center visual language.
*/

html body
.st-account-retail
:is(
  [class*="stock"],
  [class*="notification"]
)
:is(
  p,
  span,
  strong,
  small
) {
  text-shadow:
    none !important;
}


/* ==========================================================
   6. SECURITY — SIMPLIFY DANGER ZONE
   ========================================================== */

/*
   Current markup has a red danger section using Tailwind
   classes such as border-red-200 / bg-red-50.

   Convert it from a giant warning panel into a quiet,
   secondary account action.
*/

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"] {
  margin-top:
    36px !important;

  overflow:
    hidden !important;

  border:
    1px solid rgba(0,0,0,.085) !important;

  border-radius:
    16px !important;

  background:
    #fafafa !important;

  box-shadow:
    none !important;

  color:
    #1d1d1f !important;
}


/* top danger heading */

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
> div:first-child {
  padding:
    18px 20px 12px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


/* body */

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
> div:last-child {
  padding:
    0 20px 20px !important;

  background:
    transparent !important;
}


/* warning icon */

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
[class*="rounded-full"] {
  width:
    28px !important;

  height:
    28px !important;

  flex:
    0 0 28px !important;

  border:
    1px solid rgba(205,48,43,.22) !important;

  background:
    transparent !important;

  color:
    #c9342f !important;

  font-size:
    11px !important;
}


/* tiny danger eyebrow */

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
p[class*="text-red"] {
  color:
    #c9342f !important;

  font-size:
    10px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* DELETE ACCOUNT PERMANENTLY → normal title */

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
h4 {
  margin:
    3px 0 0 !important;

  color:
    #1d1d1f !important;

  font-size:
    17px !important;

  line-height:
    1.25 !important;

  font-weight:
    600 !important;

  letter-spacing:
    -.015em !important;

  text-transform:
    none !important;
}


/*
   Description becomes secondary text.
*/

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
> div:last-child
> p {
  max-width:
    650px !important;

  margin:
    0 !important;

  color:
    #6e6e73 !important;

  font-size:
    13px !important;

  line-height:
    1.55 !important;

  letter-spacing:
    0 !important;
}


/*
   Delete button: quiet red outline.
*/

html body
.st-account-retail
section[class*="border-red-200"][class*="bg-red-50"]
button {
  width:
    auto !important;

  min-width:
    0 !important;

  min-height:
    38px !important;

  margin-top:
    16px !important;

  padding:
    0 15px !important;

  border:
    1px solid rgba(201,52,47,.42) !important;

  border-radius:
    999px !important;

  background:
    transparent !important;

  color:
    #c9342f !important;

  box-shadow:
    none !important;

  font-size:
    11px !important;

  font-weight:
    550 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;

  transform:
    none !important;

  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    color 180ms ease !important;
}


@media (hover: hover) {

  html body
  .st-account-retail
  section[class*="border-red-200"][class*="bg-red-50"]
  button:hover {
    border-color:
      #c9342f !important;

    background:
      rgba(201,52,47,.055) !important;

    color:
      #b72d29 !important;

    transform:
      none !important;
  }

}


/* ==========================================================
   7. SAVED ADDRESSES EMPTY STATE
   ========================================================== */

html body
.st-account-retail
[class*="border-dashed"] {
  border:
    0 !important;

  border-radius:
    18px !important;

  background:
    #f7f7f8 !important;

  background-image:
    none !important;
}


/* ==========================================================
   8. ACCOUNT LABELS — LESS ARCADE TYPOGRAPHY
   ========================================================== */

html body
.st-account-retail
:is(
  h2,
  h3,
  h4,
  label,
  button,
  a,
  p,
  span,
  small,
  strong
) {
  text-shadow:
    none !important;
}


/*
   Tiny eyebrow labels can remain uppercase if they are semantic,
   but dramatically reduce tracking.
*/

html body
.st-account-retail
[class*="uppercase"] {
  letter-spacing:
    .015em !important;
}


/* ==========================================================
   9. PROFILE TABS — LIGHT POLISH
   ========================================================== */

html body
.st-account-retail__module-content
> section
> .grid
> nav > button {
  min-height:
    38px !important;

  transition:
    background-color 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease !important;
}


html body
.st-account-retail__module-content
> section
> .grid
> nav > button[class*="bg-black"],
html body
.st-account-retail__module-content
> section
> .grid
> nav > button[class*="text-white"] {
  background:
    #1d1d1f !important;

  color:
    #fff !important;

  box-shadow:
    none !important;
}


/* ==========================================================
   10. ORDER EMPTY STATE — REMOVE REMAINING ARCADE SIGNAL
   ========================================================== */

html body
.st-account-retail
.st-player-order-empty
.st-player-command-button::before,

html body
.st-account-retail
.st-player-order-empty
.st-player-command-button::after {
  content:
    none !important;

  display:
    none !important;
}


/* ==========================================================
   11. SAVE BUTTON + CONTINUE SHOPPING — NO GREEN ANYWHERE
   ========================================================== */

html body
.st-account-retail
:is(
  .st-player-command-button--primary,
  button[type="submit"]:not([class*="red"])
)
:is(
  i,
  [class*="led"],
  [class*="pulse"],
  [class*="signal"]
) {
  display:
    none !important;
}


/* ==========================================================
   12. FOCUS — CLEAN ACCESSIBILITY
   ========================================================== */

html body
.st-account-retail
:is(
  button,
  a,
  input,
  select,
  textarea
):focus-visible {
  outline:
    none !important;

  box-shadow:
    0 0 0 3px
    rgba(245,179,53,.18) !important;
}


/* ==========================================================
   13. MOBILE
   ========================================================== */

@media (max-width: 700px) {

  html body
  .st-account-retail
  section[class*="border-red-200"][class*="bg-red-50"] {
    margin-top:
      28px !important;
  }


  html body
  .st-account-retail
  button[role="switch"],

  html body
  .st-account-retail
  button[aria-pressed][class*="rounded-full"] {
    width:
      46px !important;

    min-width:
      46px !important;

    flex-basis:
      46px !important;

    height:
      28px !important;
  }

}


/* ==========================================================
   14. REDUCED MOTION
   ========================================================== */

@media (prefers-reduced-motion: reduce) {

  html body
  .st-account-retail
  button[role="switch"],

  html body
  .st-account-retail
  button[role="switch"] > span,

  html body
  .st-account-retail
  button[aria-pressed][class*="rounded-full"],

  html body
  .st-account-retail
  button[aria-pressed][class*="rounded-full"] > span {
    transition:
      none !important;
  }

}

/* === ST ACCOUNT POLISH V2 END === */


/* ========================================================================
   GLOBAL QUICK VIEW — AUTHORITATIVE MOTION EXCEPTION
   Keeps the site-wide interaction reset from cancelling modal motion.
   ======================================================================== */

html body .st-retail-qv.is-open {
  opacity:
    1 !important;

  animation:
    none !important;
}

html body .st-retail-qv.is-closing {
  animation:
    stRetailQuickViewShellOut
    280ms
    ease
    both !important;
}

html body
.st-retail-qv.is-open
.st-retail-qv__window {
  animation:
    stRetailQuickViewWindowIn
    380ms
    cubic-bezier(.16,1,.3,1)
    both !important;
}

html body
.st-retail-qv.is-closing
.st-retail-qv__window {
  animation:
    stRetailQuickViewWindowOut
    260ms
    cubic-bezier(.4,0,1,1)
    both !important;
}

@media (prefers-reduced-motion: reduce) {
  html body .st-retail-qv,
  html body .st-retail-qv__window {
    animation-duration:
      1ms !important;
  }
}


/* ========================================================================
   ACCOUNT — AUTHORITATIVE ROUNDED PROFILE CONTROLS
   Dedicated semantic selectors keep older account rules from changing the
   segmented tabs, compound fields, address cards, or stock-email switch.
   ======================================================================== */

html body
.st-account-retail__module-content
> section
> .grid
> nav.st-account-settings-nav {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 14px !important;
  overflow: visible !important;
  padding: 12px !important;
  border: 0 !important;
  border-bottom: 1px solid rgba(0, 0, 0, .08) !important;
  background: #fafafa !important;
}

html body
.st-account-retail__module-content
> section
> .grid
> nav.st-account-settings-nav
> .st-account-settings-tabs {
  width: auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 50px !important;
  margin: 0 !important;
  padding: 4px !important;
  display: inline-flex !important;
  flex: 0 1 auto !important;
  align-items: center !important;
  gap: 4px !important;
  overflow-x: auto !important;
  border: 0 !important;
  border-radius: 999px !important;
  background: #f1f1f3 !important;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .015) !important;
  scrollbar-width: none !important;
}

html body
.st-account-retail__module-content
.st-account-settings-tabs::-webkit-scrollbar {
  display: none !important;
}

html body
.st-account-retail__module-content
.st-account-settings-tabs
> button.st-account-settings-tab {
  width: auto !important;
  min-width: max-content !important;
  min-height: 42px !important;
  margin: 0 !important;
  padding: 0 16px !important;
  display: inline-flex !important;
  flex: 0 0 auto !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  border: 1px solid transparent !important;
  border-radius: 999px !important;
  background: transparent !important;
  color: #6e6e73 !important;
  box-shadow: none !important;
  font-size: 12px !important;
  line-height: 1 !important;
  font-weight: 560 !important;
  letter-spacing: 0 !important;
  text-align: center !important;
  text-transform: none !important;
  cursor: pointer !important;
  transform: none !important;
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    color 180ms ease,
    box-shadow 180ms ease !important;
}

html body
.st-account-retail__module-content
.st-account-settings-tab
> small {
  color: #8a8a8f !important;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  font: inherit !important;
  font-size: 10px !important;
}

html body
.st-account-retail__module-content
.st-account-settings-tabs
> button.st-account-settings-tab.is-active {
  border-color: rgba(245, 179, 53, .42) !important;
  background: #fff8e8 !important;
  color: #1d1d1f !important;
  box-shadow:
    0 2px 9px rgba(0, 0, 0, .07),
    inset 0 1px 0 rgba(255, 255, 255, .88) !important;
}

html body
.st-account-retail__module-content
.st-account-settings-tab.is-active
> small {
  color: #a86c00 !important;
}

@media (hover: hover) {
  html body
  .st-account-retail__module-content
  .st-account-settings-tabs
  > button.st-account-settings-tab:not(.is-active):hover {
    border-color: rgba(0, 0, 0, .045) !important;
    background: rgba(255, 255, 255, .74) !important;
    color: #1d1d1f !important;
    box-shadow: none !important;
    filter: none !important;
    transform: none !important;
  }
}

html body
.st-account-retail__module-content
.st-account-settings-tabs
> button.st-account-settings-tab:focus-visible {
  box-shadow:
    0 0 0 3px rgba(245, 179, 53, .22),
    0 2px 9px rgba(0, 0, 0, .06) !important;
}

html body
.st-account-retail__module-content
> section
> .grid
> nav.st-account-settings-nav
> .st-account-settings-signout {
  margin: 0 0 0 auto !important;
  padding: 0 !important;
  flex: 0 0 auto !important;
  border: 0 !important;
}

html body
.st-account-retail__module-content
.st-account-settings-signout
> button {
  min-height: 42px !important;
  margin: 0 !important;
  padding: 0 15px !important;
  border: 1px solid transparent !important;
  border-radius: 999px !important;
  background: transparent !important;
  color: #c9342f !important;
  box-shadow: none !important;
  font-size: 11px !important;
  font-weight: 550 !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

html body
.st-account-retail__module-content
:is(input, select, textarea) {
  border-radius: 16px !important;
}

html body
.st-account-retail__module-content
.st-account-field-shell {
  min-width: 0 !important;
  min-height: 56px !important;
  overflow: hidden !important;
  border: 1px solid rgba(0, 0, 0, .1) !important;
  border-radius: 16px !important;
  background: #f7f7f8 !important;
  box-shadow: none !important;
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease !important;
}

html body
.st-account-retail__module-content
.st-account-field-shell:focus-within {
  border-color: rgba(168, 108, 0, .42) !important;
