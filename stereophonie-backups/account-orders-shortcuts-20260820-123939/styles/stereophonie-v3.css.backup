    [aria-label*="previous"],
    [aria-label*="Prev"],
    [aria-label*="prev"]
  ) {
    left:
      14px !important;
  }


  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="Next"],
    [aria-label*="next"]
  ) {
    right:
      14px !important;
  }


  [data-st-product-lightbox="true"]
  button:is(
    [aria-label*="Close"],
