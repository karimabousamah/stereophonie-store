/* ========================================================================
   DELETE REMAINING RETRO RED VISUAL LANGUAGE
   ======================================================================== */

.st3-shop-page,
.st3-product-page {
  --st-v2-signal:
    #fdb73e !important;

  --st-v2-red:
    #fdb73e !important;
}


.st3-shop-page
:is(
  .st-v2-product,
  .st-v2-catalog-sidebar,
  .st-v2-shop-results
)
*,
.st3-product-page
:is(
  .st-pdp17__panel,
  .st-pdp17-info,
  .st-buy17
)
* {
  border-color:
    rgba(0,0,0,.07);
}


/* ========================================================================
   RESPONSIVE
   ======================================================================== */

@media (max-width: 1050px) {

  .st3-shop-page
  .st-v2-product-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      ) !important;
  }


  .st3-product-page
  .st-pdp17__hero {
    grid-template-columns:
      1fr !important;
  }


  .st3-product-page
  .st-pdp17__panel {
    width:
      100% !important;
  }


  .st3-product-page
  .st-pdp17-related__grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      ) !important;
  }
}


@media (max-width: 850px) {

  .st3-shop-page
  .st-v2-shop-hero__main {
    grid-template-columns:
      1fr !important;

    gap:
      40px !important;
  }


  .st3-shop-page
  .st-v2-shop-layout {
    grid-template-columns:
      1fr !important;
  }


  .st3-shop-page
  .st-v2-catalog-sidebar {
    position:
      relative !important;

    top:
      auto !important;
  }


  .st3-product-page
  .st-pdp17-info__grid {
    grid-template-columns:
      1fr !important;
  }
}


@media (max-width: 640px) {

  .st3-shop-page
  .st-v2-shop-hero
  .st-v2-container,

  .st3-shop-page
  .st-v2-shop-body > .st-v2-container,

  .st3-product-page
  .st-pdp17__breadcrumb,

  .st3-product-page
  .st-pdp17__hero,

  .st3-product-page
  .st-pdp17-info,

  .st3-product-page
  .st-pdp17-related {
    width:
      calc(
        100% - 28px
      ) !important;
  }


  .st3-shop-page
  .st-v2-shop-hero {
    min-height:
      auto !important;

    padding:
      64px 0 !important;
  }


  .st3-shop-page
  .st-v2-shop-hero h1 {
    font-size:
      clamp(
        54px,
        16vw,
        72px
      ) !important;
  }


  .st3-shop-page
  .st-v2-shop-hero__status {
    grid-template-columns:
      1fr !important;
  }


  .st3-shop-page
  .st-v2-shop-hero__status > div {
    border-right:
      0 !important;

    border-bottom:
      1px solid
      rgba(0,0,0,.055) !important;
  }


  .st3-shop-page
  .st-v2-product-grid {
    grid-template-columns:
      1fr !important;
  }


  .st3-shop-page
  .st-v2-catalog-tools {
    align-items:
      stretch !important;

    flex-direction:
      column !important;
  }


  .st3-shop-page
  .st-v2-catalog-search {
    width:
      100% !important;
  }


  .st3-product-page
  .st-pdp17__hero {
    margin-bottom:
      76px !important;

    gap:
      18px !important;
  }


  .st3-product-page
  .st-pdp17__gallery-column,
  .st3-product-page
  .st-pdp17__panel,
  .st3-product-page
  .st-pdp17-gallery {
    border-radius:
      24px !important;
  }


  .st3-product-page
  .st-pdp17-gallery__stage {
    min-height:
      460px !important;
  }


  .st3-product-page
  .st-pdp17-gallery__image {
    inset:
      66px
      28px
      82px !important;

    width:
      calc(100% - 56px) !important;

    height:
      calc(100% - 148px) !important;
  }


  .st3-product-page
  .st-pdp17__panel {
    padding:
      26px 20px !important;
  }


  .st3-product-page
  .st-pdp17__identity h1 {
    font-size:
      clamp(
        42px,
        13vw,
        58px
      ) !important;
  }


  .st3-product-page
  .st-pdp17__facts {
    grid-template-columns:
      1fr !important;
  }


  .st3-product-page
  .st-buy17__actions {
    grid-template-columns:
      1fr !important;
  }


  .st3-product-page
  .st-buy17__wishlist {
    grid-column:
      auto !important;
  }


  .st3-product-page
  .st-pdp17-related__grid {
    grid-template-columns:
      1fr !important;
  }
}


/* Motion accessibility */

@media (
  prefers-reduced-motion:
  reduce
) {

  .st3-shop-page *,
  .st3-product-page * {
    animation:
      none !important;

    transition:
      none !important;
  }
}



/* ========================================================================
   STEREOPHONIE V3 — SHOP V4
   Real retail architecture.
   This layer intentionally replaces the old database / arcade composition.
   ======================================================================== */


.st3-shop-v4 {
  position: relative;

  min-height: 100vh;

  overflow: clip;

  background:
    #fff;

  color:
    #1d1d1f;
}


/* ------------------------------------------------------------------------
   HERO
   ------------------------------------------------------------------------ */

.st3-shop-v4__hero {
  position: relative;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      #f5f5f7 0%,
      #f7f7f8 58%,
      #fbfbfc 100%
    );
}


.st3-shop-v4__hero::after {
  content: "";

  position: absolute;

  width:
    clamp(
      300px,
      38vw,
      620px
    );

  aspect-ratio: 1;

  right:
    clamp(
      -210px,
      -8vw,
      -80px
    );

  top:
    clamp(
      -230px,
      -12vw,
      -90px
    );

  border-radius:
    50%;

  pointer-events:
    none;

  background:
    radial-gradient(
      circle,
      rgba(253,183,62,.14) 0%,
      rgba(253,183,62,.055) 38%,
      transparent 70%
    );

  filter:
    blur(4px);
}


.st3-shop-v4__hero-inner {
  position: relative;
  z-index: 2;

  width:
    min(
      calc(100% - 48px),
      1220px
    );

  margin:
    0 auto;

  padding:
    clamp(56px, 7vw, 94px)
    0
    clamp(72px, 9vw, 120px);
}


.st3-shop-v4__breadcrumb {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom:
    clamp(
      58px,
      7vw,
      90px
    );

  color:
    #86868b;

  font-size:
    12px;

  font-weight:
    500;

  line-height:
    1;
}


.st3-shop-v4__breadcrumb a {
  color:
    inherit;

  text-decoration:
    none;
}


.st3-shop-v4__breadcrumb a:hover {
  color:
    #1d1d1f;
}


.st3-shop-v4__breadcrumb svg {
  width:
    12px;

  height:
    12px;
}


.st3-shop-v4__hero-grid {
  display: grid;

  grid-template-columns:
    minmax(0,1.2fr)
    minmax(340px,.8fr);

  align-items:
    end;

  gap:
    clamp(
      50px,
      8vw,
      120px
    );
}


.st3-shop-v4__eyebrow {
  margin:
    0 0 18px;

  color:
    #86868b;

  font-size:
    14px;

  font-weight:
    600;

  line-height:
    1.2;

  letter-spacing:
    -.01em;
}


.st3-shop-v4__hero-copy h1 {
  max-width:
    820px;

  margin:
    0;

  color:
    #1d1d1f;

  font-size:
    clamp(
      56px,
      6.8vw,
      96px
    );

  font-weight:
    650;

  line-height:
    .94;

  letter-spacing:
    -.067em;

  text-wrap:
    balance;
}


.st3-shop-v4__intro {
  max-width:
    610px;

  margin:
    30px 0 0;

  color:
    #6e6e73;

  font-size:
    clamp(
      17px,
      1.6vw,
      21px
    );

  line-height:
    1.48;

  letter-spacing:
    -.018em;
}


.st3-shop-v4__hero-summary {
  display: grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0,1fr)
    );

  overflow:
    hidden;

  border:
    1px solid
    rgba(0,0,0,.055);

  border-radius:
    24px;

  background:
    rgba(255,255,255,.74);

  box-shadow:
    0 18px 44px
    rgba(0,0,0,.045);

  -webkit-backdrop-filter:
    blur(18px);

  backdrop-filter:
    blur(18px);
}


.st3-shop-v4__hero-summary > div {
  min-width:
    0;

  padding:
    24px 20px;
}


.st3-shop-v4__hero-summary > div + div {
  border-left:
    1px solid
    rgba(0,0,0,.055);
}


.st3-shop-v4__hero-summary strong {
  display: block;

  overflow: hidden;

  color:
    #1d1d1f;

  font-size:
    clamp(
      17px,
      1.7vw,
      22px
    );

  font-weight:
    650;

  line-height:
    1.1;

  letter-spacing:
    -.03em;

  text-overflow:
    ellipsis;

  white-space:
    nowrap;
}


.st3-shop-v4__hero-summary span {
  display: block;

  margin-top:
    8px;

  color:
    #86868b;

  font-size:
    11px;

  line-height:
    1.35;
}


/* ------------------------------------------------------------------------
   CATALOG
   ------------------------------------------------------------------------ */

.st3-shop-v4__catalog {
  background:
    #fff;
}


.st3-shop-v4__catalog-inner {
  width:
    min(
      calc(100% - 48px),
      1220px
    );

  margin:
    0 auto;

  padding:
    clamp(
      76px,
      8vw,
      116px
    )
    0
    120px;
}


.st3-shop-v4__catalog-heading {
  display: flex;

  align-items:
    end;

  justify-content:
    space-between;

  gap:
    32px;

  margin-bottom:
    34px;
}


.st3-shop-v4__catalog-heading p {
  margin:
    0 0 9px;

  color:
    #86868b;

  font-size:
    13px;

  font-weight:
    600;
}


.st3-shop-v4__catalog-heading h2 {
  margin:
    0;

  color:
    #1d1d1f;

  font-size:
    clamp(
      38px,
      4.6vw,
      64px
    );

  line-height:
    .98;

  font-weight:
    650;

  letter-spacing:
    -.058em;
}


.st3-shop-v4__catalog-heading > span {
  padding-bottom:
    5px;

  color:
    #86868b;

  font-size:
    13px;

  white-space:
    nowrap;
}


/* ------------------------------------------------------------------------
   CONTROLS CONTAINER

   The existing functional controls are preserved inside here.
   Phase 2 replaces their JSX entirely.
   ------------------------------------------------------------------------ */

.st3-shop-v4__controls {
  position:
    relative;

  z-index:
    10;

  margin-bottom:
    22px;
}


/*
 * IMPORTANT:
 * kill the old permanent catalog/sidebar geometry.
 */

.st3-shop-v4__controls
.st-v2-catalog-tools {
  position:
    relative !important;

  inset:
    auto !important;

  width:
    100% !important;

  min-height:
    auto !important;

  margin:
    0 !important;

  padding:
    10px !important;

  display:
    flex !important;

  align-items:
    center !important;

  gap:
    12px !important;

  border:
    1px solid
    rgba(0,0,0,.055) !important;

  border-radius:
    24px !important;

  background:
    #f5f5f7 !important;

  box-shadow:
    none !important;
}


.st3-shop-v4__controls
.st-v2-catalog-search {
  flex:
    1 1 auto !important;

  min-width:
    0 !important;

  min-height:
    52px !important;

  margin:
    0 !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    18px !important;

  background:
    #fff !important;
}


.st3-shop-v4__controls
.st-v2-catalog-search input {
  min-height:
    52px !important;

  padding-left:
    48px !important;

  border:
    0 !important;

  background:
    transparent !important;

  color:
    #1d1d1f !important;

  font-size:
    14px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-v4__controls
.st-v2-catalog-search input::placeholder {
  color:
    #86868b !important;
}


.st3-shop-v4__controls
.st-v2-catalog-search button {
  min-width:
    112px !important;

  min-height:
    44px !important;

  margin:
    4px !important;

  padding:
    0 20px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fdb73e !important;

  color:
    #111 !important;

  font-size:
    12px !important;

  font-weight:
    650 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-v4__controls
.st-v2-catalog-tools__right {
  display:
    flex !important;

  align-items:
    center !important;

  gap:
    8px !important;
}


.st3-shop-v4__controls
:is(
  .st-v2-catalog-filter-trigger,
  .st-v2-catalog-reset
) {
  min-height:
    46px !important;

  padding:
    0 17px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  font-size:
    12px !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/*
 * Remove old desktop sidebar from the visual architecture.
 * Functional controls opened by the client component remain available.
 */

.st3-shop-v4
.st-v2-catalog-sidebar {
  position:
    fixed !important;

  z-index:
    9990 !important;

  top:
    var(
      --st3-header-height,
      60px
    ) !important;

  right:
    0 !important;

  bottom:
    0 !important;

  left:
    auto !important;

  width:
    min(
      430px,
      calc(100vw - 24px)
    ) !important;

  max-width:
    430px !important;

  height:
    calc(
      100dvh
      -
      var(
        --st3-header-height,
        60px
      )
    ) !important;

  margin:
    0 !important;

  padding:
    30px !important;

  overflow-y:
    auto !important;

  border:
    0 !important;

  border-left:
    1px solid
    rgba(0,0,0,.06) !important;

  border-radius:
    28px 0 0 28px !important;

  background:
    rgba(250,250,252,.985) !important;

  box-shadow:
    -24px 0 70px
    rgba(0,0,0,.10) !important;

  -webkit-backdrop-filter:
    blur(24px);

  backdrop-filter:
    blur(24px);
}


/* ------------------------------------------------------------------------
   FILTERED STATE
   ------------------------------------------------------------------------ */

.st3-shop-v4__active-state {
  min-height:
    44px;

  margin:
    0 0 24px;

  padding:
    0 4px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    24px;

  color:
    #86868b;

  font-size:
    12px;
}


.st3-shop-v4__active-state a {
  color:
    #a86700;

  font-weight:
    600;

  text-decoration:
    none;
}


/* ------------------------------------------------------------------------
   RESULTS
   ------------------------------------------------------------------------ */

.st3-shop-v4__results {
  width:
    100%;

  min-width:
    0;
}


.st3-shop-v4__grid {
  width:
    100%;

  display:
    grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0,1fr)
    );

  gap:
    24px;
}


/*
 * The old product component remains temporarily,
 * but it is forced into a clean retail card footprint
 * instead of its previous arcade/database dimensions.
 */

.st3-shop-v4__grid
.st-v2-product {
  position:
    relative !important;

  width:
    100% !important;

  min-width:
    0 !important;

  max-width:
    none !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    28px !important;

  background:
    #f5f5f7 !important;

  box-shadow:
    none !important;

  transform:
    translateZ(0);

  transition:
    transform
      300ms
      cubic-bezier(.22,1,.36,1),
    box-shadow
      300ms
      ease !important;
}


@media (hover:hover) {
  .st3-shop-v4__grid
  .st-v2-product:hover {
    transform:
      translateY(-5px) !important;

    box-shadow:
      0 22px 50px
      rgba(0,0,0,.075) !important;
  }
}


.st3-shop-v4__grid
.st-v2-product__head {
  min-height:
    0 !important;

  padding:
    18px 18px 0 !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-v4__grid
.st-v2-product__head
:is(
  [class*="slot"],
  [class*="reference"]
) {
  display:
    none !important;
}


.st3-shop-v4__grid
.st-v2-product__status {
  color:
    #86868b !important;

  font-size:
    10px !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-v4__grid
.st-v2-product__media {
  position:
    relative !important;

  height:
    clamp(
      280px,
      28vw,
      360px
    ) !important;

  margin:
    10px
    10px
    0 !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    22px !important;

  background:
    #fff !important;
}


.st3-shop-v4__grid
.st-v2-product__media > a {
  width:
    100% !important;

  height:
    100% !important;

  display:
    flex !important;

  align-items:
    center !important;

  justify-content:
    center !important;
}


.st3-shop-v4__grid
.st-v2-product__image {
  position:
    absolute !important;

  inset:
    0 !important;

  width:
    100% !important;

  height:
    100% !important;

  padding:
    clamp(
      32px,
      4vw,
      54px
    ) !important;

  object-fit:
    contain !important;

  background:
    transparent !important;
}


.st3-shop-v4__grid
.st-v2-product__wishlist {
  width:
    42px !important;

  height:
    42px !important;

  right:
    15px !important;

  top:
    15px !important;

  border:
    0 !important;

  border-radius:
    50% !important;

  background:
    rgba(255,255,255,.95) !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 7px 20px
    rgba(0,0,0,.075) !important;
}


.st3-shop-v4__grid
.st-v2-product__wishlist.is-active {
  background:
    #fdb73e !important;

  color:
    #111 !important;
}


.st3-shop-v4__grid
.st-v2-product__badge {
  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 5px 16px
    rgba(0,0,0,.06) !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-v4__grid
.st-v2-product__body {
  padding:
    22px
    20px
    20px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-v4__grid
.st-v2-product__category {
  color:
    #86868b !important;

  font-size:
    12px !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-v4__grid
.st-v2-product__name {
  margin-top:
    8px !important;

  color:
    #1d1d1f !important;

  font-size:
    21px !important;

  line-height:
    1.15 !important;

  font-weight:
    650 !important;

  letter-spacing:
    -.035em !important;

  text-transform:
    none !important;
}


.st3-shop-v4__grid
.st-v2-product__pricing {
  margin-top:
    17px !important;
}


.st3-shop-v4__grid
.st-v2-product__pricing strong {
  color:
    #1d1d1f !important;

  font-size:
    17px !important;

  letter-spacing:
    -.02em !important;
}


.st3-shop-v4__grid
.st-v2-product__footer {
  padding:
    0 20px
    22px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-v4__grid
.st-v2-product__footer > a:first-child,
.st3-shop-v4__grid
.st-v2-product__cart {
  min-height:
    44px !important;

  padding:
    0 18px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fdb73e !important;

  color:
    #111 !important;

  font-size:
    12px !important;

  font-weight:
    650 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ------------------------------------------------------------------------
   EMPTY STATE
   ------------------------------------------------------------------------ */

.st3-shop-v4__empty {
  min-height:
    500px;

  padding:
    80px 28px;

  display:
    flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    center;

  text-align:
    center;

  border-radius:
    32px;

  background:
    #f5f5f7;
}


.st3-shop-v4__empty-icon {
  width:
    62px;

  height:
    62px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  margin-bottom:
    30px;

  border-radius:
    50%;

  background:
    #fff;

  box-shadow:
    0 9px 26px
    rgba(0,0,0,.055);
}


.st3-shop-v4__empty-icon svg {
  width:
    25px;

  height:
    25px;
}


.st3-shop-v4__empty > p {
  margin:
    0 0 10px;

  color:
    #86868b;

  font-size:
    13px;

  font-weight:
    600;
}


.st3-shop-v4__empty h2 {
  margin:
    0;

  color:
    #1d1d1f;

  font-size:
    clamp(
      38px,
      4vw,
      58px
    );

  line-height:
    1;

  font-weight:
    650;

  letter-spacing:
    -.055em;
}


.st3-shop-v4__empty > span {
  max-width:
    480px;

  margin-top:
    20px;

  color:
    #6e6e73;

  font-size:
    16px;

  line-height:
    1.5;
}


.st3-shop-v4__reset {
  min-height:
    48px;

  margin-top:
    30px;

  padding:
    0 22px;

  display:
    inline-flex;

  align-items:
    center;

  gap:
    9px;

  border-radius:
    999px;

  background:
    #fdb73e;

  color:
    #111;

  font-size:
    13px;

  font-weight:
    650;

  text-decoration:
    none;
}


.st3-shop-v4__reset svg {
  width:
    16px;

  height:
    16px;
}


/* ------------------------------------------------------------------------
   TABLET
   ------------------------------------------------------------------------ */

@media (
  max-width:
  1000px
) {

  .st3-shop-v4__hero-grid {
    grid-template-columns:
      1fr;
  }


  .st3-shop-v4__hero-summary {
    max-width:
      650px;
  }


  .st3-shop-v4__grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      );
  }

}


/* ------------------------------------------------------------------------
   MOBILE
   ------------------------------------------------------------------------ */

@media (
  max-width:
  700px
) {

  .st3-shop-v4__hero-inner,
  .st3-shop-v4__catalog-inner {
    width:
      calc(100% - 32px);
  }


  .st3-shop-v4__hero-inner {
    padding:
      42px 0
      66px;
  }


  .st3-shop-v4__breadcrumb {
    margin-bottom:
      44px;
  }


  .st3-shop-v4__hero-copy h1 {
    font-size:
      clamp(
        48px,
        14vw,
        68px
      );
  }


  .st3-shop-v4__intro {
    font-size:
      17px;
  }


  .st3-shop-v4__hero-summary {
    grid-template-columns:
      1fr;
  }


  .st3-shop-v4__hero-summary > div {
    padding:
      18px 20px;
  }


  .st3-shop-v4__hero-summary > div + div {
    border-left:
      0;

    border-top:
      1px solid
      rgba(0,0,0,.055);
  }


  .st3-shop-v4__catalog-inner {
    padding:
      64px 0
      90px;
  }


  .st3-shop-v4__catalog-heading {
    align-items:
      start;

    flex-direction:
      column;
  }


  .st3-shop-v4__catalog-heading h2 {
    font-size:
      44px;
  }


  .st3-shop-v4__controls
  .st-v2-catalog-tools {
    flex-direction:
      column !important;

    align-items:
      stretch !important;
  }


  .st3-shop-v4__controls
  .st-v2-catalog-tools__right {
    width:
      100% !important;
  }


  .st3-shop-v4__grid {
    grid-template-columns:
      1fr;

    gap:
      18px;
  }


  .st3-shop-v4__grid
  .st-v2-product__media {
    height:
      min(
        92vw,
        430px
      ) !important;
  }

}


/* ------------------------------------------------------------------------
   REDUCED MOTION
   ------------------------------------------------------------------------ */

@media (
  prefers-reduced-motion:
  reduce
) {

  .st3-shop-v4 *,
  .st3-shop-v4 *::before,
  .st3-shop-v4 *::after {
    scroll-behavior:
      auto !important;

    animation-duration:
      .01ms !important;

    animation-iteration-count:
      1 !important;

    transition-duration:
      .01ms !important;
  }

}



/* ==========================================================================
   STEREOPHONIE V3 — RETAIL REDESIGN PHASE 2
   Authoritative shop + PDP layer.
   Removes remaining arcade/database architecture from visible storefront.
   ========================================================================== */


/* ==========================================================================
   SHOP — STOP LEGACY FILTER PANEL FROM FLOATING OVER THE PAGE
   ========================================================================== */

.st3-shop-page {
  --st3-retail-max: 1220px;
  --st3-retail-surface: #f5f5f7;
  --st3-retail-text: #1d1d1f;
  --st3-retail-muted: #6e6e73;
  --st3-retail-soft: #86868b;
  --st3-retail-border: rgba(0, 0, 0, 0.07);
  --st3-retail-mustard: #fdb73e;

  background: #fff !important;
  color: var(--st3-retail-text);
}


/*
 * The old component still owns all filter/query logic,
 * but it is no longer allowed to behave like a fixed arcade console.
 */

.st3-shop-page .st-v2-catalog-sidebar,
.st3-shop-page .st-filter-v10-sidebar {
  position: static !important;
  inset: auto !important;

  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;

  margin: 0 !important;
  padding: 0 !important;

  overflow: visible !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  box-shadow: none !important;

  transform: none !important;
  z-index: auto !important;
}


/*
 * Kill the old sidebar/system heading.
 */

.st3-shop-page .st-v2-catalog-sidebar__title,
.st3-shop-page .st-filter-v10-sidebar
  > :is(header, .st-v2-catalog-sidebar__title) {
  display: none !important;
}


/*
 * Convert filter controls into a clean horizontal retail toolbar.
 */

.st3-shop-page .st-v2-catalog-panel {
  width: 100% !important;

  display: grid !important;

  grid-template-columns:
    repeat(5, minmax(0, 1fr)) !important;

  gap: 10px !important;

  padding: 0 !important;

  border: 0 !important;

  background: transparent !important;
}


/*
 * Remove arcade separators/section headers.
 */

.st3-shop-page .st-v2-catalog-panel section {
  min-width: 0 !important;

  margin: 0 !important;
  padding: 0 !important;

  border: 0 !important;

  background: transparent !important;
}

.st3-shop-page .st-v2-control-label {
  display: none !important;
}


/*
 * Category / Brand / Price / availability / sort
 * become compact Apple-like filter pills/cards.
 */

.st3-shop-page
:is(
  .st-v2-catalog-panel__categories,
  .st-v2-select,
  .st-v2-price-range,
  .st-v2-toggle
) {
  width: 100% !important;
}


.st3-shop-page
:is(
  .st-v2-catalog-panel__categories button,
  .st-v2-select select,
  .st-v2-toggle,
  .st-v2-price-range
) {
  min-height: 54px !important;

  border:
    1px solid
    rgba(0, 0, 0, 0.065) !important;

  border-radius:
    18px !important;

  background:
    #f5f5f7 !important;

  color:
    #1d1d1f !important;

  box-shadow:
    none !important;

  text-transform:
    none !important;

  letter-spacing:
    0 !important;
}


/*
 * Remove all visible legacy copy if those nodes remain.
 */

.st3-shop-page
:is(
  .st-filter-v10-sidebar,
  .st-v2-catalog-sidebar
)
:is(
  [data-version],
  [data-system],
  [data-status]
) {
  display: none !important;
}


/* ==========================================================================
   SHOP SEARCH
   ========================================================================== */

.st3-shop-page .st-v2-catalog-tools {
  width:
    min(
      calc(100% - 48px),
      var(--st3-retail-max)
    ) !important;

  margin:
    0 auto
    24px !important;

  padding:
    0 !important;

  display:
    grid !important;

  grid-template-columns:
    minmax(0, 1fr)
    auto !important;

  gap:
    12px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-page .st-v2-catalog-search {
  min-height:
    60px !important;

  border:
    0 !important;

  border-radius:
    22px !important;

  background:
    #f5f5f7 !important;

  overflow:
    hidden !important;

  box-shadow:
    none !important;
}


.st3-shop-page
.st-v2-catalog-search input {
  color:
    #1d1d1f !important;

  font-size:
    15px !important;

  font-weight:
    450 !important;

  letter-spacing:
    -0.01em !important;

  text-transform:
    none !important;
}


.st3-shop-page
.st-v2-catalog-search button {
  height:
    46px !important;

  margin:
    7px !important;

  padding:
    0 24px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fdb73e !important;

  color:
    #111 !important;

  font-size:
    13px !important;

  font-weight:
    650 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ==========================================================================
   FILTER BAR WRAPPER
   ========================================================================== */

.st3-shop-page
.st-v2-catalog-sidebar {
  width:
    min(
      calc(100% - 48px),
      var(--st3-retail-max)
    ) !important;

  margin:
    0 auto
    52px !important;
}


.st3-shop-page
.st-v2-catalog-panel {
  padding:
    10px !important;

  border:
    0 !important;

  border-radius:
    24px !important;

  background:
    #f5f5f7 !important;
}


/*
 * Reset filter action.
 */

.st3-shop-page
:is(
  .st-v2-catalog-reset,
  [class*="reset"]
) {
  min-height:
    54px !important;

  border:
    0 !important;

  border-radius:
    18px !important;

  background:
    #fff !important;

  color:
    #6e6e73 !important;

  text-transform:
    none !important;

  letter-spacing:
    0 !important;
}


/* ==========================================================================
   SHOP RESULTS AREA
   ========================================================================== */

.st3-shop-page .st-v2-shop-body {
  padding:
    0 0
    110px !important;

  background:
    #fff !important;
}


.st3-shop-page
.st-v2-shop-body
> .st-v2-container {
  width:
    100% !important;

  max-width:
    none !important;

  margin:
    0 !important;

  padding:
    0 !important;
}


.st3-shop-page .st-v2-shop-layout {
  width:
    min(
      calc(100% - 48px),
      var(--st3-retail-max)
    ) !important;

  margin:
    0 auto !important;

  display:
    block !important;

  grid-template-columns:
    none !important;
}


.st3-shop-page
.st-v2-shop-layout__sidebar-space {
  display:
    none !important;
}


.st3-shop-page
.st-v2-shop-results {
  width:
    100% !important;

  min-width:
    0 !important;

  margin:
    0 !important;

  padding:
    0 !important;
}


.st3-shop-page
.st-v2-shop-results__head {
  min-height:
    44px !important;

  margin:
    0 0
    24px !important;

  padding:
    0 !important;

  display:
    flex !important;

  align-items:
    center !important;

  justify-content:
    space-between !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-page
.st-v2-shop-results__head span {
  color:
    #86868b !important;

  font-size:
    13px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-page
.st-v2-shop-results__head strong {
  color:
    #1d1d1f !important;

  font-size:
    15px !important;

  font-weight:
    600 !important;

  letter-spacing:
    -0.015em !important;

  text-transform:
    none !important;
}


/*
 * Hide green arcade LEDs/status copy.
 */

.st3-shop-page
.st-v2-shop-results__head
> div:last-child,
.st3-shop-page
.st-v2-shop-results__head
.st-v2-led {
  display:
    none !important;
}


/* ==========================================================================
   PRODUCT GRID — IMPORTANT
   ========================================================================== */

.st3-shop-page .st-v2-product-grid {
  width:
    100% !important;

  display:
    grid !important;

  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    ) !important;

  align-items:
    stretch !important;

  gap:
    22px !important;
}


/*
 * Remove legacy fixed/narrow card sizing.
 */

.st3-shop-page
.st-v2-product-grid
> * {
  width:
    100% !important;

  min-width:
    0 !important;

  max-width:
    none !important;

  margin:
    0 !important;
}


/* ==========================================================================
   PRODUCT CARD — DESTROY ARCADE PRESENTATION
   ========================================================================== */

.st3-shop-page .st-v2-product {
  position:
    relative !important;

  min-height:
    100% !important;

  overflow:
    hidden !important;

  display:
    flex !important;

  flex-direction:
    column !important;

  border:
    0 !important;

  border-radius:
    28px !important;

  background:
    #f5f5f7 !important;

  box-shadow:
    none !important;
}


.st3-shop-page
.st-v2-product__head {
  position:
    absolute !important;

  z-index:
    5 !important;

  top:
    18px !important;

  left:
    18px !important;

  right:
    auto !important;

  width:
    auto !important;

  min-height:
    0 !important;

  padding:
    0 !important;

  border:
    0 !important;

  background:
    transparent !important;
}


/*
 * Completely hide old slot/reference/status bar.
 */

.st3-shop-page
.st-v2-product__status {
  display:
    none !important;
}


.st3-shop-page
.st-v2-product__media {
  position:
    relative !important;

  width:
    calc(100% - 20px) !important;

  height:
    360px !important;

  margin:
    10px
    10px
    0 !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    23px !important;

  background:
    #fff !important;
}


.st3-shop-page
.st-v2-product__media::before,
.st3-shop-page
.st-v2-product__media::after {
  content:
    none !important;

  display:
    none !important;
}


.st3-shop-page
.st-v2-product__image {
  inset:
    0 !important;

  width:
    100% !important;

  height:
    100% !important;

  padding:
    46px !important;

  object-fit:
    contain !important;

  background:
    transparent !important;

  filter:
    none !important;
}


.st3-shop-page
.st-v2-product__wishlist {
  top:
    18px !important;

  right:
    18px !important;

  width:
    42px !important;

  height:
    42px !important;

  border:
    0 !important;

  border-radius:
    50% !important;

  background:
    rgba(255,255,255,.96) !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 5px 18px
    rgba(0,0,0,.07) !important;
}


.st3-shop-page
.st-v2-product__wishlist.is-active {
  background:
    #fdb73e !important;

  color:
    #111 !important;
}


/*
 * Hide system/code badge styling.
 */

.st3-shop-page
.st-v2-product__badge {
  top:
    18px !important;

  left:
    18px !important;

  padding:
    9px 13px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 5px 18px
    rgba(0,0,0,.06) !important;

  font-size:
    12px !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-page
.st-v2-product__badge
:is(
  small,
  i,
  svg
) {
  display:
    none !important;
}


.st3-shop-page
.st-v2-product__body {
  flex:
    1 !important;

  padding:
    24px
    22px
    18px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-page
.st-v2-product__category {
  color:
    #86868b !important;

  font-size:
    13px !important;

  font-weight:
    500 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-shop-page
.st-v2-product__category
:is(
  svg,
  i
) {
  display:
    none !important;
}


.st3-shop-page
.st-v2-product__name {
  margin:
    8px 0
    0 !important;

  color:
    #1d1d1f !important;

  font-size:
    22px !important;

  line-height:
    1.12 !important;

  font-weight:
    650 !important;

  letter-spacing:
    -.035em !important;

  text-transform:
    none !important;
}


.st3-shop-page
.st-v2-product__pricing {
  margin-top:
    18px !important;

  display:
    flex !important;

  align-items:
    baseline !important;

  gap:
    10px !important;
}


.st3-shop-page
.st-v2-product__pricing strong {
  color:
    #1d1d1f !important;

  font-size:
    18px !important;

  font-weight:
    600 !important;

  letter-spacing:
    -.02em !important;
}


.st3-shop-page
.st-v2-product__footer {
  padding:
    0 22px
    24px !important;

  border:
    0 !important;

  background:
    transparent !important;
}


.st3-shop-page
.st-v2-product__footer
> a:first-child {
  width:
    100% !important;

  min-height:
    46px !important;

  display:
    inline-flex !important;

  align-items:
    center !important;

  justify-content:
    center !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fdb73e !important;

  color:
    #111 !important;

  font-size:
    13px !important;

  font-weight:
    650 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ==========================================================================
   REMOVE ANY REMAINING ARCADE MICRO-COPY IN SHOP VISUALLY
   ========================================================================== */

.st3-shop-page
:is(
  [class*="slot"],
  [class*="system-command"],
  [class*="system-flag"],
  [class*="system-status"],
  [class*="terminal"]
) {
  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


/* ==========================================================================
   PRODUCT PAGE — STRONGER V3 FOUNDATION
   ========================================================================== */

.st3-product-page {
  background:
    #fff !important;
}


.st3-product-page
.st-pdp17__hero {
  align-items:
    stretch !important;
}


.st3-product-page
.st-pdp17__gallery-column,
.st3-product-page
.st-pdp17__panel {
  background:
    #f5f5f7 !important;

  border-radius:
    34px !important;

  border:
    0 !important;

  overflow:
    hidden !important;

  box-shadow:
    none !important;
}


/*
 * Product panel should behave as one continuous premium card.
 */

.st3-product-page
.st-pdp17__panel {
  padding:
    clamp(
      34px,
      4vw,
      52px
    ) !important;
}


/*
 * Remove remaining uppercase arcade feeling.
 */

.st3-product-page
:is(
  .st-pdp17__identity h1,
  .st-pdp17-info h2,
  .st-pdp17-info h3,
  .st-pdp17-related h2
) {
  text-transform:
    none !important;
}


.st3-product-page
:is(
  .st-pdp17__signal,
  .st-pdp17__identity > p,
  .st-pdp17-info small,
  .st-pdp17-info__number
) {
  letter-spacing:
    0 !important;
}


/* ==========================================================================
   PURCHASE OPTIONS — REPLACE BLACK ARCADE CONSOLE VISUALLY
   ========================================================================== */

.st3-product-page .st-buy17 {
  margin-top:
    28px !important;

  overflow:
    hidden !important;

  border:
    0 !important;

  border-radius:
    24px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  box-shadow:
    none !important;
}


.st3-product-page
.st-buy17__header {
  min-height:
    58px !important;

  padding:
    0 18px !important;

  border-bottom:
    1px solid
    rgba(0,0,0,.065) !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;
}


.st3-product-page
.st-buy17__header div {
  font-size:
    13px !important;

  font-weight:
    600 !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-product-page
.st-buy17__header small {
  color:
    #86868b !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-product-page
.st-buy17__body {
  padding:
    20px !important;

  background:
    #fff !important;
}


.st3-product-page
.st-buy17__section,
.st3-product-page
.st-buy17__selection,
.st3-product-page
.st-buy17__specs,
.st3-product-page
.st-buy17__status,
.st3-product-page
.st-buy17__quantity {
  border:
    0 !important;

  border-radius:
    18px !important;

  background:
    #f5f5f7 !important;

  color:
    #1d1d1f !important;
}


.st3-product-page
.st-buy17__selection {
  padding:
    18px !important;
}


.st3-product-page
.st-buy17__selected-price strong {
  color:
    #1d1d1f !important;
}


.st3-product-page
.st-buy17__specs {
  margin-top:
    12px !important;

  overflow:
    hidden !important;
}


.st3-product-page
.st-buy17__specs > div {
  border-color:
    rgba(0,0,0,.055) !important;
}


.st3-product-page
.st-buy17__status {
  margin-top:
    12px !important;

  padding:
    16px !important;
}


.st3-product-page
.st-buy17__variants button {
  border:
    1px solid
    rgba(0,0,0,.075) !important;

  border-radius:
    14px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  letter-spacing:
    0 !important;

  text-transform:
    none !important;
}


.st3-product-page
.st-buy17__variants
button.is-active {
  border-color:
    #fdb73e !important;

  box-shadow:
    0 0 0 2px
    rgba(253,183,62,.14) !important;
}


.st3-product-page
.st-buy17__cart {
  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #fdb73e !important;

  color:
    #111 !important;
}


.st3-product-page
.st-buy17__buy {
  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    #1d1d1f !important;

  color:
    #fff !important;
}


.st3-product-page
.st-buy17__wishlist {
  border:
    1px solid
    rgba(0,0,0,.09) !important;

  border-radius:
    999px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;
}


.st3-product-page
.st-buy17__wishlist.is-active {
  border-color:
    #fdb73e !important;

  color:
    #1d1d1f !important;
}


/*
 * Hide the arcade instructional micro labels.
 */

.st3-product-page
.st-buy17__actions
small {
  display:
    none !important;
}


/* ==========================================================================
   PRODUCT DETAILS
   ========================================================================== */

.st3-product-page
.st-pdp17-info {
  width:
    min(
      calc(100% - 48px),
      1120px
    ) !important;

  margin:
    0 auto
    110px !important;
}


.st3-product-page
.st-pdp17-info__grid {
  display:
    grid !important;

  grid-template-columns:
    repeat(
      2,
      minmax(0,1fr)
    ) !important;

  gap:
    16px !important;
}


.st3-product-page
.st-pdp17-info__grid
> article {
  min-height:
    300px !important;

  padding:
    30px !important;

  border:
    0 !important;

  border-radius:
    28px !important;

  background:
    #f5f5f7 !important;

  box-shadow:
    none !important;
}


.st3-product-page
.st-pdp17-info__number {
  color:
    #a1a1a6 !important;

  font-size:
    12px !important;
}


.st3-product-page
.st-pdp17-info__icon {
  width:
    42px !important;

  height:
    42px !important;

  border:
    0 !important;

  border-radius:
    13px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;

  box-shadow:
    0 4px 14px
    rgba(0,0,0,.035) !important;
}


.st3-product-page
.st-pdp17-info__verified {
  border:
    0 !important;

  border-radius:
    15px !important;

  background:
    #fff !important;

  color:
    #1d1d1f !important;
}


/* ==========================================================================
   MOBILE / TABLET
   ========================================================================== */

@media (max-width: 1100px) {

  .st3-shop-page
  .st-v2-catalog-panel {
    grid-template-columns:
      repeat(
        3,
        minmax(0,1fr)
      ) !important;
  }


  .st3-shop-page
  .st-v2-product-grid {
    grid-template-columns:
      repeat(
        2,
        minmax(0,1fr)
      ) !important;
  }

}


@media (max-width: 760px) {

  .st3-shop-page
  .st-v2-catalog-tools,
  .st3-shop-page
  .st-v2-catalog-sidebar,
  .st3-shop-page
  .st-v2-shop-layout {
    width:
      calc(100% - 28px) !important;
  }


  .st3-shop-page
  .st-v2-catalog-panel {
    grid-template-columns:
      1fr !important;
  }


  .st3-shop-page
  .st-v2-product-grid {
    grid-template-columns:
      1fr !important;
  }


  .st3-shop-page
  .st-v2-product__media {
    height:
      330px !important;
  }


  .st3-product-page
  .st-pdp17-info__grid {
    grid-template-columns:
      1fr !important;
  }

}


@media (prefers-reduced-motion: reduce) {

  .st3-shop-page *,
  .st3-product-page * {
    scroll-behavior:
      auto !important;
  }

}



/* ========================================================================
   STEREOPHONIE REAL RETAIL V3
   Structural migration
   ======================================================================== */

.st-retail-shop {
  background: #fff;
  color: #1d1d1f;
}

/* ------------------------------------------------------------------------
   FILTERS
   ------------------------------------------------------------------------ */

.st-retail-filters {
  width: 100%;
  margin: 0 0 42px;
}

.st-retail-filters__search {
  width: 100%;
  height: 64px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14px;
  padding: 6px 7px 6px 20px;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 20px;
  background: #f5f5f7;
}

.st-retail-filters__search > svg {
  width: 18px;
  height: 18px;
  color: #86868b;
}

.st-retail-filters__search input {
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #1d1d1f;
  font: inherit;
  font-size: 15px;
}

.st-retail-filters__search input::placeholder {
  color: #8a8a8f;
}

.st-retail-filters__search button {
  height: 50px;
  min-width: 108px;
  padding: 0 22px;
  border: 0;
  border-radius: 15px;
  background: #fdb73e;
  color: #111;
  font-size: 13px;
  font-weight: 650;
  cursor: pointer;
}

.st-retail-filters__bar {
  min-height: 76px;
  margin-top: 14px;
  padding: 12px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid rgba(0,0,0,.08);
}

.st-retail-filters__choices,
.st-retail-filters__right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.st-retail-filters__choices > button {
  min-height: 44px;
  padding: 0 15px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(0,0,0,.09);
  border-radius: 999px;
  background: #fff;
  color: #1d1d1f;
  cursor: pointer;
  transition:
    border-color 180ms ease,
    background 180ms ease;
}

.st-retail-filters__choices > button:hover,
.st-retail-filters__choices > button.is-active {
  border-color: rgba(0,0,0,.2);
  background: #f5f5f7;
}

.st-retail-filters__choices > button span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 550;
}

.st-retail-filters__choices > button strong {
  max-width: 110px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #6e6e73;
  font-weight: 500;
}

.st-retail-filters__choices svg {
  width: 15px;
  height: 15px;
}

.st-retail-filters__sort {
  position: relative;
  min-height: 44px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border-radius: 999px;
  background: #f5f5f7;
}

.st-retail-filters__sort > span {
  color: #86868b;
  font-size: 12px;
}

.st-retail-filters__sort select {
  appearance: none;
  padding: 0 22px 0 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #1d1d1f;
  font: inherit;
  font-size: 13px;
  font-weight: 550;
  cursor: pointer;
}

.st-retail-filters__sort svg {
  position: absolute;
  right: 12px;
  width: 14px;
  height: 14px;
  pointer-events: none;
}

.st-retail-filters__clear {
  min-height: 42px;
  padding: 0 10px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 0;
  background: transparent;
  color: #6e6e73;
  font-size: 12px;
  cursor: pointer;
}

.st-retail-filters__clear svg {
  width: 14px;
  height: 14px;
}

.st-retail-filters__mobile {
  display: none;
}

/* Kill old physical sidebar if any stale subtree survives HMR. */

.st-retail-shop .st-v2-catalog-sidebar,
.st-retail-shop .st-filter-v10-sidebar,
.st-retail-shop .st-v2-shop-layout__sidebar-space {
  display: none !important;
}

/* ------------------------------------------------------------------------
   PRODUCT GRID
   ------------------------------------------------------------------------ */

.st-retail-shop .st-v2-shop-layout {
  display: block !important;
  width: 100% !important;
}

.st-retail-shop .st-v2-shop-results {
  width: 100% !important;
  min-width: 0 !important;
}

.st-retail-shop .st-v2-product-grid {
  width: 100% !important;
  display: grid !important;
  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;
  gap: 24px !important;
}

.st-retail-card {
  min-width: 0;
  overflow: hidden;
  border: 0;
  border-radius: 26px;
  background: #f5f5f7;
  transition:
    transform 300ms cubic-bezier(.22,1,.36,1),
    box-shadow 300ms ease;
}

@media (hover:hover) {
  .st-retail-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(0,0,0,.07);
  }
}

.st-retail-card__visual {
  position: relative;
  height: clamp(300px, 31vw, 410px);
  margin: 10px 10px 0;
  overflow: hidden;
  border-radius: 21px;
  background: #fff;
}

.st-retail-card__image-link {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-retail-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  padding: clamp(34px, 4vw, 58px);
  object-fit: contain;
  transition:
    opacity 350ms ease,
    transform 500ms cubic-bezier(.22,1,.36,1);
}

.st-retail-card__image--primary {
  opacity: 1;
}

.st-retail-card__image--secondary {
  opacity: 0;
}

@media (hover:hover) {
  .st-retail-card:hover
  .st-retail-card__image--primary {
    transform: scale(1.025);
  }

  .st-retail-card:hover
  .st-retail-card__image--secondary {
    opacity: 1;
    transform: scale(1.025);
  }

  .st-retail-card:hover
  .st-retail-card__image--secondary
  + * {
    opacity: 1;
  }
}

.st-retail-card__empty {
  display: grid;
  place-items: center;
  gap: 10px;
  color: #86868b;
  font-size: 13px;
}

.st-retail-card__empty svg {
  width: 28px;
  height: 28px;
}

.st-retail-card__top {
  position: absolute;
  z-index: 4;
  left: 16px;
  right: 16px;
  top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  pointer-events: none;
}

.st-retail-card__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.st-retail-card__badges span {
  padding: 8px 11px;
  border-radius: 999px;
  background: rgba(255,255,255,.94);
  color: #1d1d1f;
  box-shadow: 0 5px 16px rgba(0,0,0,.05);
  font-size: 11px;
  font-weight: 600;
}

.st-retail-card__badges span.is-muted {
  color: #86868b;
}

.st-retail-card__wishlist {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.95);
  color: #1d1d1f;
  box-shadow: 0 5px 18px rgba(0,0,0,.07);
  pointer-events: auto;
  cursor: pointer;
}

.st-retail-card__wishlist svg {
  width: 18px;
  height: 18px;
}

.st-retail-card__wishlist.is-active {
  background: #fff9ed;
  border: 1px solid #f5b335;
  color: #1d1d1f;
  box-shadow: 0 5px 18px rgba(245, 179, 53, 0.10);
}

.st-retail-card__wishlist.is-active svg {
  color: #1d1d1f;
  stroke: #1d1d1f;
  fill: #1d1d1f;
}

.st-retail-card__wishlist.is-active:hover {
  background: #fff5df;
  border-color: #f5b335;
  color: #1d1d1f;
  box-shadow: 0 7px 22px rgba(245, 179, 53, 0.16);
}

.st-retail-card__wishlist.is-active:hover svg,
.st-retail-card__wishlist.is-active:focus-visible svg {
  color: #1d1d1f;
  stroke: #1d1d1f;
  fill: #1d1d1f;
}

/*
 * Product-card saved bookmark:
 * canonical final icon state.
 */
.st-retail-card__wishlist[aria-pressed="true"],
.st-retail-card__wishlist.is-active {
  background: #fff9ed !important;
  border: 1px solid #f5b335 !important;
  color: #1d1d1f !important;
}

.st-retail-card__wishlist[aria-pressed="true"] svg,
.st-retail-card__wishlist.is-active svg,
.st-retail-card__wishlist[aria-pressed="true"] svg.fill-current,
.st-retail-card__wishlist.is-active svg.fill-current {
  color: #1d1d1f !important;
  stroke: #1d1d1f !important;
  fill: #1d1d1f !important;
}


.st-retail-card__quick {
  position: absolute;
  z-index: 4;
  left: 50%;
  bottom: 18px;
  transform: translate(-50%, 8px);
  min-height: 42px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  border-radius: 999px;
  background: rgba(29,29,31,.94);
  color: #fff;
  font-size: 12px;
  font-weight: 550;
  opacity: 0;
  cursor: pointer;
  transition:
    opacity 180ms ease,
    transform 180ms ease;
}

.st-retail-card__quick svg {
  width: 15px;
  height: 15px;
}

@media (hover:hover) {
  .st-retail-card:hover
  .st-retail-card__quick {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

.st-retail-card__content {
  padding: 22px 22px 24px;
}

.st-retail-card__category {
  color: #86868b;
  font-size: 12px;
  font-weight: 500;
}

.st-retail-card__name {
  margin-top: 7px;
  display: block;
  color: #1d1d1f;
  font-size: clamp(19px, 1.5vw, 23px);
  line-height: 1.13;
  font-weight: 650;
  letter-spacing: -.035em;
  text-decoration: none;
}

.st-retail-card__footer {
  margin-top: 19px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14px;
}

.st-retail-card__price {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.st-retail-card__price strong {
  color: #1d1d1f;
  font-size: 16px;
  font-weight: 600;
}

.st-retail-card__price del {
  color: #86868b;
  font-size: 12px;
}

.st-retail-card__footer > span {
  color: #86868b;
  font-size: 11px;
}

.st-retail-card__footer > span.is-available {
  color: #188038;
}

/* ------------------------------------------------------------------------
   QUICK VIEW
   ------------------------------------------------------------------------ */

.st-retail-qv {
  position: fixed;
  z-index: 3000;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 28px;
  isolation: isolate;
  overflow: hidden;
  overscroll-behavior: contain;
  animation: stRetailQuickViewShellIn 320ms ease both;
}

.st-retail-qv.is-closing {
  pointer-events: none;
  animation: stRetailQuickViewShellOut 280ms ease both;
}

.st-retail-qv__backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgba(0,0,0,.28);
  backdrop-filter: blur(12px);
}

.st-retail-qv__window {
  position: relative;
  z-index: 1;
  width: min(960px, 100%);
  max-height: min(720px, calc(100vh - 56px));
  overflow: auto;
  display: grid;
  grid-template-columns: 1.04fr .96fr;
  border-radius: 30px;
  background: #fff;
  box-shadow: 0 36px 100px rgba(0,0,0,.2);
  transform-origin: center;
  will-change: opacity, transform;
  animation:
    stRetailQuickViewWindowIn
    380ms
    cubic-bezier(.16,1,.3,1)
    both;
}

.st-retail-qv.is-closing .st-retail-qv__window {
  animation:
    stRetailQuickViewWindowOut
    260ms
    cubic-bezier(.4,0,1,1)
    both;
}

@keyframes stRetailQuickViewShellIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes stRetailQuickViewShellOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes stRetailQuickViewWindowIn {
  from {
    opacity: 0;
    transform: translate3d(0, 24px, 0) scale(.97);
    filter: blur(3px);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }
}

@keyframes stRetailQuickViewWindowOut {
  from {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }

  to {
    opacity: 0;
    transform: translate3d(0, 14px, 0) scale(.985);
    filter: blur(2px);
  }
}

.st-retail-qv__close {
  position: absolute;
  z-index: 4;
  right: 18px;
  top: 18px;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.94);
  cursor: pointer;
}

.st-retail-qv__close svg {
  width: 18px;
  height: 18px;
}

.st-retail-qv__visual {
  min-height: 570px;
  display: grid;
  place-items: center;
  padding: 60px;
  background: #f5f5f7;
}

.st-retail-qv__visual img {
  width: 100%;
  height: 100%;
  max-height: 460px;
  object-fit: contain;
}

.st-retail-qv__info {
  padding: 76px 52px 52px;
}

.st-retail-qv__category {
  color: #86868b;
  font-size: 13px;
}

.st-retail-qv__info h2 {
  margin: 13px 0 20px;
  color: #1d1d1f;
  font-size: clamp(34px, 3vw, 48px);
  line-height: 1;
  letter-spacing: -.055em;
}

.st-retail-qv__price {
  display: flex;
  align-items: baseline;
  gap: 11px;
}

.st-retail-qv__price strong {
  font-size: 24px;
}

.st-retail-qv__price del {
  color: #86868b;
  font-size: 14px;
}

.st-retail-qv__availability {
  margin-top: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #86868b;
  font-size: 12px;
}

.st-retail-qv__availability i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #b6b6bb;
}

.st-retail-qv__availability.is-available {
  color: #188038;
}

.st-retail-qv__availability.is-available i {
  background: #f6b43a;
}

.st-retail-qv__info > p {
  margin: 24px 0 0;
  color: #6e6e73;
  font-size: 14px;
  line-height: 1.6;
}

.st-retail-qv__primary,
.st-retail-qv__save {
  width: 100%;
  min-height: 52px;
  margin-top: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border-radius: 999px;
  text-decoration: none;
  cursor: pointer;
}

.st-retail-qv__primary {
  background: #fdb73e;
  color: #111;
  font-size: 13px;
  font-weight: 650;
}

.st-retail-qv__save {
  margin-top: 9px;
  border: 1px solid rgba(0,0,0,.1);
  background: #fff;
  color: #1d1d1f;
  font-size: 13px;
}

.st-retail-qv__save svg {
  width: 16px;
  height: 16px;
}

/* ------------------------------------------------------------------------
   FILTER MODALS
   ------------------------------------------------------------------------ */

.st-retail-filter-modal,
.st-retail-filter-sheet {
  position: fixed;
  z-index: 3100;
  inset: 0;
}

.st-retail-filter-modal__backdrop,
.st-retail-filter-sheet__backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgba(0,0,0,.23);
  backdrop-filter: blur(10px);
}

.st-retail-filter-modal {
  display: grid;
  place-items: center;
  padding: 24px;
}

.st-retail-filter-modal__dialog {
  position: relative;
  z-index: 1;
  width: min(620px, 100%);
  max-height: min(720px, calc(100vh - 48px));
  overflow: auto;
  border-radius: 28px;
  background: #fff;
  box-shadow: 0 30px 90px rgba(0,0,0,.18);
}

/* Re-skin preserved modal internals. */

.st-retail-filter-modal
.st-filter-v10-modal__body {
  padding: 32px !important;
  border: 0 !important;
  background: #fff !important;
}

.st-retail-filter-modal
.st-filter-v10-modal__heading {
  padding: 0 0 25px !important;
  border-bottom: 1px solid rgba(0,0,0,.08) !important;
}

.st-retail-filter-modal
.st-filter-v10-modal__heading small {
  color: #86868b !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

.st-retail-filter-modal
.st-filter-v10-modal__heading h2 {
  margin-top: 7px !important;
  color: #1d1d1f !important;
  font-size: 30px !important;
  line-height: 1 !important;
  letter-spacing: -.04em !important;
  text-transform: none !important;
}

.st-retail-filter-modal
.st-filter-v10-modal__heading button {
  border: 0 !important;
  border-radius: 50% !important;
  background: #f5f5f7 !important;
}

.st-retail-filter-modal
.st-filter-v10-choice-list {
  margin-top: 18px !important;
  display: grid !important;
  gap: 6px !important;
}

.st-retail-filter-modal
.st-filter-v10-choice-list > button {
  min-height: 56px !important;
  padding: 0 16px !important;
  border: 0 !important;
  border-radius: 14px !important;
  background: transparent !important;
  color: #1d1d1f !important;
}

.st-retail-filter-modal
.st-filter-v10-choice-list > button:hover,
.st-retail-filter-modal
.st-filter-v10-choice-list > button.is-active {
  background: #f5f5f7 !important;
}

.st-retail-filter-modal
.st-filter-v10-choice-list small {
  display: none !important;
}

.st-retail-filter-modal
.st-filter-v10-choice-list strong {
  font-size: 14px !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

/* ------------------------------------------------------------------------
   MOBILE FILTER SHEET
   ------------------------------------------------------------------------ */

.st-retail-filter-sheet {
  display: none;
}

.st-retail-filter-sheet__panel {
  position: absolute;
  z-index: 2;
  left: 12px;
  right: 12px;
  bottom: 12px;
  max-height: calc(100vh - 24px);
  overflow: auto;
  border-radius: 28px;
  background: #fff;
}

.st-retail-filter-sheet__panel > header {
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.st-retail-filter-sheet__panel > header div {
  display: grid;
  gap: 4px;
}

.st-retail-filter-sheet__panel > header span {
  color: #86868b;
  font-size: 12px;
}

.st-retail-filter-sheet__panel > header strong {
  font-size: 22px;
  letter-spacing: -.03em;
}

.st-retail-filter-sheet__panel > header button {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: #f5f5f7;
}

.st-retail-filter-sheet__content {
  padding: 0 16px 20px;
  display: grid;
  gap: 7px;
}

.st-retail-filter-sheet__content > button {
  min-height: 66px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 16px;
  background: #f5f5f7;
  text-align: left;
}

.st-retail-filter-sheet__content > button span {
  display: grid;
  gap: 4px;
}

.st-retail-filter-sheet__content small {
  color: #86868b;
  font-size: 11px;
}

.st-retail-filter-sheet__content strong {
  color: #1d1d1f;
  font-size: 14px;
}

.st-retail-filter-sheet__panel > footer {
  padding: 14px 16px 18px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  border-top: 1px solid rgba(0,0,0,.07);
}

.st-retail-filter-sheet__panel > footer button {
  min-height: 52px;
  border: 0;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
}

.st-retail-filter-sheet__panel > footer button:first-child {
  background: #f5f5f7;
  color: #1d1d1f;
}

.st-retail-filter-sheet__panel > footer button:last-child {
  background: #1d1d1f;
  color: #fff;
}

/* ------------------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------------------ */

@media (max-width: 1100px) {
  .st-retail-shop .st-v2-product-grid {
    grid-template-columns:
      repeat(2, minmax(0,1fr)) !important;
  }

  .st-retail-filters__choices {
    flex-wrap: wrap;
  }
}

@media (max-width: 820px) {
  .st-retail-filters__choices,
  .st-retail-filters__clear,
  .st-retail-filters__sort {
    display: none;
  }

  .st-retail-filters__bar {
    min-height: 58px;
  }

  .st-retail-filters__right {
    width: 100%;
    justify-content: flex-end;
  }

  .st-retail-filters__mobile {
    min-height: 44px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    border-radius: 999px;
    background: #f5f5f7;
    color: #1d1d1f;
    font-size: 13px;
    font-weight: 600;
  }

  .st-retail-filters__mobile svg {
    width: 16px;
    height: 16px;
  }

  .st-retail-filters__mobile span {
    min-width: 21px;
    height: 21px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #1d1d1f;
    color: #fff;
    font-size: 10px;
  }

  .st-retail-filter-sheet {
    display: block;
  }

  .st-retail-qv__window {
    grid-template-columns: 1fr;
  }

  .st-retail-qv__visual {
    min-height: 390px;
  }
}

@media (max-width: 640px) {
  .st-retail-filters__search {
    height: 58px;
    padding-left: 16px;
  }

  .st-retail-filters__search button {
    min-width: 86px;
    height: 46px;
  }

  .st-retail-shop .st-v2-product-grid {
    grid-template-columns: 1fr !important;
    gap: 18px !important;
  }

  .st-retail-card__visual {
    height: 390px;
  }

  .st-retail-qv {
    padding: 10px;
  }

  .st-retail-qv__window {
    max-height: calc(100vh - 20px);
    border-radius: 22px;
  }

  .st-retail-qv__visual {
    min-height: 330px;
    padding: 48px;
  }

  .st-retail-qv__info {
    padding: 38px 25px 28px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .st-retail-card,
  .st-retail-card__image,
  .st-retail-card__quick,
  .st-retail-qv,
  .st-retail-qv__backdrop,
  .st-retail-qv__window {
    animation-duration: 1ms !important;
    transition: none !important;
  }
}


/* ========================================================================
   PRODUCT PAGE V3 — STRUCTURAL RETAIL DESIGN
   ======================================================================== */

.st-product-v3 {
  min-height: 100vh;
  background: #fff;
  color: #1d1d1f;
}

.st-product-v3__shell {
  width: min(calc(100% - 48px), 1280px);
  margin: 0 auto;
}

.st-product-v3__breadcrumb {
  padding: 30px 0 22px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #86868b;
  font-size: 12px;
}

.st-product-v3__breadcrumb a,
.st-product-v3__breadcrumb span {
  color: inherit;
  text-decoration: none;
}

.st-product-v3__main {
  display: grid;
  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(390px, .92fr);
  gap: 42px;
  align-items: start;
  padding-bottom: 110px;
}

.st-product-v3__gallery,
.st-product-v3__summary {
  min-width: 0;
}

.st-product-v3__summary {
  padding: 12px 0 0;
}

.st-product-v3__availability-row {
  min-height: 48px;
  padding-bottom: 23px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid rgba(0,0,0,.08);
}

.st-product-v3__availability {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #86868b;
  font-size: 12px;
  font-weight: 550;
}

.st-product-v3__availability i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #aaa;
}

.st-product-v3__availability.is-available {
  color: #188038;
}

.st-product-v3__availability.is-available i {
  background: #f6b43a;
}

.st-product-v3__reference {
  color: #99999e;
  font-size: 11px;
}

.st-product-v3__heading {
  padding: 48px 0 28px;
}

.st-product-v3__heading > span {
  color: #86868b;
  font-size: 13px;
}

.st-product-v3__heading h1 {
  max-width: 650px;
  margin: 14px 0 0;
  color: #1d1d1f;
  font-size: clamp(48px, 5vw, 72px);
  line-height: .96;
  font-weight: 650;
  letter-spacing: -.065em;
}

.st-product-v3__price {
  margin-top: 26px;
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.st-product-v3__price strong {
  color: #1d1d1f;
  font-size: 27px;
  font-weight: 600;
  letter-spacing: -.03em;
}

.st-product-v3__price del {
  color: #86868b;
  font-size: 15px;
}

.st-product-v3__description {
  margin: 0;
  padding: 26px 0;
  border-top: 1px solid rgba(0,0,0,.08);
  border-bottom: 1px solid rgba(0,0,0,.08);
  color: #6e6e73;
  font-size: 15px;
  line-height: 1.65;
}

.st-product-v3__meta {
  padding: 18px 0 26px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.st-product-v3__meta > div {
  padding: 14px;
  border-radius: 15px;
  background: #f5f5f7;
}

.st-product-v3__meta small,
.st-product-v3__meta strong {
  display: block;
}

.st-product-v3__meta small {
  color: #86868b;
  font-size: 10px;
}

.st-product-v3__meta strong {
  margin-top: 6px;
  color: #1d1d1f;
  font-size: 12px;
}

/* gallery */

.st-product-gallery-v3 {
  position: sticky;
  top: 100px;
}

.st-product-gallery-v3__stage {
  position: relative;
  min-height: 650px;
  overflow: hidden;
  display: grid;
  place-items: center;
  border-radius: 32px;
  background: #f5f5f7;
}

.st-product-gallery-v3__image {
  width: 100%;
  height: 100%;
  max-height: 590px;
  padding: 70px;
  object-fit: contain;
  filter: drop-shadow(0 26px 34px rgba(0,0,0,.06));
}

.st-product-gallery-v3__counter {
  position: absolute;
  left: 22px;
  bottom: 22px;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(255,255,255,.95);
  color: #1d1d1f;
  font-size: 11px;
  font-weight: 600;
}

.st-product-gallery-v3__fullscreen {
  position: absolute;
  left: 50%;
  bottom: 20px;
  transform: translateX(-50%);
  min-height: 44px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  border-radius: 999px;
  background: #1d1d1f;
  color: #fff;
  font-size: 12px;
  cursor: pointer;
}

.st-product-gallery-v3__fullscreen svg {
  width: 15px;
  height: 15px;
}

.st-product-gallery-v3__nav {
  position: absolute;
  right: 20px;
  bottom: 20px;
  display: flex;
  gap: 7px;
}

.st-product-gallery-v3__nav button {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: #fff;
  color: #1d1d1f;
  cursor: pointer;
}

.st-product-gallery-v3__nav svg {
  width: 18px;
  height: 18px;
}

.st-product-gallery-v3__thumbs {
  margin-top: 12px;
  display: flex;
  gap: 9px;
}

.st-product-gallery-v3__thumbs button {
  position: relative;
  width: 84px;
  height: 84px;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 16px;
  background: #f5f5f7;
  cursor: pointer;
}

.st-product-gallery-v3__thumbs button.is-active {
  border-color: #fdb73e;
}

.st-product-gallery-v3__thumbs img {
  width: 100%;
  height: 100%;
  padding: 9px;
  object-fit: contain;
}

.st-product-gallery-v3__thumbs span {
  display: none;
}

/* purchase */

.st-purchase-v3 {
  margin-top: 6px;
  padding: 0;
  border: 0;
  background: transparent;
}

.st-purchase-v3__header {
  padding: 18px 0;
  display: flex;
  justify-content: space-between;
  border-top: 1px solid rgba(0,0,0,.08);
  border-bottom: 1px solid rgba(0,0,0,.08);
  font-size: 13px;
}

.st-purchase-v3__header > div {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.st-purchase-v3__header small {
  color: #86868b;
}

.st-purchase-v3__led {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #f6b43a;
}

.st-purchase-v3__body {
  padding: 24px 0 0;
}

.st-purchase-v3__section {
  margin-bottom: 24px;
}

.st-purchase-v3__section-title {
  margin-bottom: 12px;
}

.st-purchase-v3__section-title > span {
  display: none;
}

.st-purchase-v3__section-title strong {
  color: #1d1d1f;
  font-size: 13px;
}

.st-purchase-v3__section-title small {
  margin-top: 3px;
  display: block;
  color: #86868b;
  font-size: 11px;
}

.st-purchase-v3__variants {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.st-purchase-v3__variants button {
  min-height: 46px;
  padding: 0 15px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(0,0,0,.11);
  border-radius: 14px;
  background: #fff;
  color: #1d1d1f;
  font-size: 12px;
  cursor: pointer;
}

.st-purchase-v3__variants button.is-active {
  border-color: #1d1d1f;
  background: #1d1d1f;
  color: #fff;
}

.st-purchase-v3__variants button.is-unavailable {
  opacity: .45;
}

.st-purchase-v3__selection {
  margin: 18px 0;
  padding: 18px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  border-radius: 18px;
  background: #f5f5f7;
}

.st-purchase-v3__selection small,
.st-purchase-v3__selection span {
  color: #86868b;
  font-size: 10px;
}

.st-purchase-v3__selection strong {
  display: block;
  margin-top: 4px;
}

.st-purchase-v3__selected-price strong {
  margin-top: 0;
  font-size: 20px;
}

.st-purchase-v3__specs {
  margin: 0 0 16px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 16px;
  background: rgba(0,0,0,.08);
}

.st-purchase-v3__specs > div {
  padding: 14px;
  background: #fff;
}

.st-purchase-v3__specs small,
.st-purchase-v3__specs strong {
  display: block;
}

.st-purchase-v3__specs small {
  color: #86868b;
  font-size: 9px;
}

.st-purchase-v3__specs strong {
  margin-top: 5px;
  color: #1d1d1f;
  font-size: 11px;
}

.st-purchase-v3__status {
  margin: 14px 0;
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 11px;
  border-radius: 14px;
  background: #f5f5f7;
}

.st-purchase-v3__status > i {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #aaa;
}

.st-purchase-v3__status.is-ready > i,
.st-purchase-v3__status.is-low > i {
  background: #f6b43a;
}

.st-purchase-v3__status strong,
.st-purchase-v3__status span {
  display: block;
}

.st-purchase-v3__status strong {
  font-size: 11px;
}

.st-purchase-v3__status span {
  margin-top: 2px;
  color: #86868b;
  font-size: 10px;
}

.st-purchase-v3__quantity {
  margin: 20px 0;
  display: flex;
  align-items: end;
  justify-content: space-between;
}

.st-purchase-v3__quantity small {
  color: #86868b;
  font-size: 10px;
}

.st-purchase-v3__quantity > span {
  color: #86868b;
  font-size: 10px;
}

.st-purchase-v3__stepper {
  margin-top: 7px;
  display: inline-grid;
  grid-template-columns: 40px 48px 40px;
  height: 42px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,.1);
  border-radius: 999px;
}

.st-purchase-v3__stepper button,
.st-purchase-v3__stepper strong {
  display: grid;
  place-items: center;
  border: 0;
  background: #fff;
}

.st-purchase-v3__stepper button {
  cursor: pointer;
}

.st-purchase-v3__stepper svg {
  width: 14px;
  height: 14px;
}

.st-purchase-v3__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}

.st-purchase-v3__cart,
.st-purchase-v3__buy,
.st-purchase-v3__notify,
.st-purchase-v3__disabled,
.st-purchase-v3__wishlist {
  min-height: 52px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
}

.st-purchase-v3__cart,
.st-purchase-v3__buy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  cursor: pointer;
}

.st-purchase-v3__cart {
  background: #fdb73e;
  color: #111;
}

.st-purchase-v3__buy {
  background: #1d1d1f;
  color: #fff;
}

.st-purchase-v3__cart small,
.st-purchase-v3__buy small {
  display: none;
}

.st-purchase-v3__cart svg,
.st-purchase-v3__buy svg {
  width: 16px;
  height: 16px;
}

.st-purchase-v3__wishlist {
  grid-column: 1 / -1;
  border: 1px solid rgba(0,0,0,.1);
  background: #fff;
  color: #1d1d1f;
  cursor: pointer;
}

.st-purchase-v3__notify,
.st-purchase-v3__disabled {
  grid-column: 1 / -1;
  border: 0;
}

.st-purchase-v3__notify {
  background: #1d1d1f;
  color: #fff;
}

/* lower content */

.st-product-v3__details {
  padding: 100px 0;
  border-top: 1px solid rgba(0,0,0,.07);
}

.st-product-v3__details-head {
  max-width: 720px;
  margin-bottom: 46px;
}

.st-product-v3__details-head span {
  color: #86868b;
  font-size: 13px;
}

.st-product-v3__details-head h2 {
  margin: 10px 0 0;
  font-size: clamp(42px, 4.5vw, 64px);
  line-height: .98;
  letter-spacing: -.06em;
}

.st-product-v3__details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.st-product-v3__details-grid article {
  padding: 34px;
  border-radius: 26px;
  background: #f5f5f7;
}

.st-product-v3__details-grid small {
  color: #86868b;
  font-size: 11px;
}

.st-product-v3__details-grid h3 {
  margin: 7px 0 0;
  font-size: 26px;
  letter-spacing: -.04em;
}

.st-product-v3__overview > p,
.st-product-v3__specifications > p {
  margin: 24px 0 0;
  color: #6e6e73;
  line-height: 1.65;
}

.st-product-v3__overview dl,
.st-product-v3__specifications dl {
  margin: 28px 0 0;
}

.st-product-v3__overview dl > div,
.st-product-v3__specifications dl > div {
  padding: 12px 0;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid rgba(0,0,0,.07);
}

.st-product-v3__overview dt,
.st-product-v3__specifications dt {
  color: #86868b;
  font-size: 11px;
}

.st-product-v3__overview dd,
.st-product-v3__specifications dd {
  margin: 0;
  color: #1d1d1f;
  font-size: 12px;
  font-weight: 600;
  text-align: right;
}

.st-product-v3__service-grid {
  margin-top: 18px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.st-product-v3__service-grid > a,
.st-product-v3__service-grid > div {
  min-height: 180px;
  padding: 26px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 16px;
  align-items: start;
  border-radius: 24px;
  background: #f5f5f7;
  color: #1d1d1f;
  text-decoration: none;
}

.st-product-v3__service-grid > div {
  grid-template-columns: auto 1fr;
}

.st-product-v3__service-grid svg {
  width: 20px;
  height: 20px;
}

.st-product-v3__service-grid span {
  display: block;
}

.st-product-v3__service-grid small,
.st-product-v3__service-grid strong,
.st-product-v3__service-grid p {
  display: block;
}

.st-product-v3__service-grid small {
  color: #86868b;
  font-size: 10px;
}

.st-product-v3__service-grid strong {
  margin-top: 7px;
  font-size: 17px;
}

.st-product-v3__service-grid p {
  margin: 8px 0 0;
  color: #6e6e73;
  font-size: 12px;
  line-height: 1.5;
}

.st-product-v3__related {
  padding: 40px 0 110px;
}

.st-product-v3__related > header {
  margin-bottom: 28px;
  display: flex;
  justify-content: space-between;
  align-items: end;
}

.st-product-v3__related header span {
  color: #86868b;
  font-size: 12px;
}

.st-product-v3__related h2 {
  margin: 6px 0 0;
  font-size: 38px;
  letter-spacing: -.045em;
}

.st-product-v3__related header > a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #1d1d1f;
  font-size: 12px;
  text-decoration: none;
}

.st-product-v3__related-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

/* remove old PDP if anything stale survives */

.st-product-v3 .st-pdp17,
.st-product-v3 .st-pdp17-info,
.st-product-v3 .st-pdp17-related,
.st-product-v3 .st-buy17 {
  display: none !important;
}

@media (max-width: 1050px) {
  .st-product-v3__main {
    grid-template-columns: 1fr;
  }

  .st-product-gallery-v3 {
    position: relative;
    top: auto;
  }

  .st-product-v3__summary {
    max-width: 720px;
  }

  .st-product-v3__service-grid {
    grid-template-columns: 1fr;
  }

  .st-product-v3__related-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 720px) {
  .st-product-v3__shell {
    width: min(calc(100% - 28px), 1280px);
  }

  .st-product-v3__main {
    gap: 28px;
    padding-bottom: 70px;
  }

  .st-product-gallery-v3__stage {
    min-height: 440px;
    border-radius: 22px;
  }

  .st-product-gallery-v3__image {
    padding: 42px;
  }

  .st-product-v3__heading {
    padding-top: 34px;
  }

  .st-product-v3__heading h1 {
    font-size: clamp(42px, 14vw, 60px);
  }

  .st-product-v3__meta {
    grid-template-columns: 1fr;
  }

  .st-product-v3__details {
    padding: 72px 0;
  }

  .st-product-v3__details-grid {
    grid-template-columns: 1fr;
  }

  .st-product-v3__details-grid article {
    padding: 25px;
  }

  .st-product-v3__related-grid {
    grid-template-columns: 1fr;
  }

  .st-purchase-v3__actions {
    grid-template-columns: 1fr;
  }

  .st-purchase-v3__wishlist {
    grid-column: auto;
  }
}

/* ========================================================================
   SHOP HERO REMOVAL + COMPACT RETAIL START
   ======================================================================== */

.st-retail-shop {
  padding-top: 0 !important;
}

.st-retail-shop .st3-shop-hero,
.st-retail-shop .st-v2-shop-hero,
.st-retail-shop .st3-shop-intro {
  display: none !important;
}

.st-retail-shop .st-v2-shop-body {
  padding-top: 56px !important;
}

.st-retail-shop .st-v2-container {
  width: min(calc(100% - 48px), 1280px) !important;
  margin-inline: auto !important;
}

.st-retail-shop .st-v2-shop-results__head {
  margin-bottom: 24px !important;
}

@media (max-width: 720px) {
  .st-retail-shop .st-v2-shop-body {
    padding-top: 28px !important;
  }

  .st-retail-shop .st-v2-container {
    width: min(calc(100% - 28px), 1280px) !important;
  }
}


/* STEREOPHONIE V4 MINIMAL RETAIL
   ====================================================================== */

:root {
  --st-v4-black: #171719;
  --st-v4-text: #1d1d1f;
  --st-v4-muted: #76767b;
  --st-v4-line: rgba(0, 0, 0, 0.085);
  --st-v4-soft: #f5f5f7;
  --st-v4-soft-2: #fafafa;
  --st-v4-white: #ffffff;
  --st-v4-mustard: #f6b43a;
  --st-v4-green: #2ccf66;
}


/* ======================================================================
   SHOP
   ====================================================================== */

.st-retail-shop-v4 {
  background: #fff !important;
  color: var(--st-v4-text);
  min-height: 100vh;
}

/* The old introduction must never consume layout even if stale JSX
   somehow survives a merge. */
.st-retail-shop-v4 .st-v2-shop-hero,
.st-retail-shop-v4 .st3-shop-hero,
.st-retail-shop-v4 .st3-shop-intro {
  display: none !important;
}

.st-retail-shop-v4 .st-v2-shop-body {
  padding:
    clamp(42px, 5vw, 76px)
    0
    clamp(80px, 9vw, 132px) !important;
  background: #fff !important;
}

.st-retail-shop-v4 .st-v2-container {
  width:
    min(
      calc(100% - 48px),
      1220px
    ) !important;
  max-width: none !important;
  margin-inline: auto !important;
}

.st-retail-shop-v4 .st-v2-shop-layout {
  display: block !important;
}

.st-retail-shop-v4
.st-v2-shop-layout__sidebar-space {
  display: none !important;
}

.st-retail-shop-v4
.st-v2-shop-results {
  width: 100% !important;
}

.st-retail-shop-v4
.st-v2-shop-results__head {
  margin: 0 0 28px !important;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
}

.st-retail-shop-v4
.st-v2-product-grid {
  width: 100% !important;
  display: grid !important;
  grid-template-columns:
    repeat(3, minmax(0, 1fr)) !important;
  gap:
    clamp(18px, 2vw, 26px) !important;
  align-items: start !important;
}


/* ======================================================================
   FILTERS V4
   ====================================================================== */

.st-filter-v4 {
  position: relative;
  z-index: 10;
  margin-bottom: 38px;
}

.st-filter-v4__search {
  width: 100%;
  min-height: 62px;

  display: grid;
  grid-template-columns:
    22px minmax(0, 1fr) auto auto;
  align-items: center;
  gap: 13px;

  padding: 7px 8px 7px 20px;

  border:
    1px solid
    var(--st-v4-line);

  border-radius: 20px;

  background:
    var(--st-v4-soft);

  transition:
    border-color 160ms ease,
    background 160ms ease;
}

.st-filter-v4__search:focus-within {
  border-color:
    rgba(0, 0, 0, 0.16);

  background: #fff;
}

.st-filter-v4__search > svg {
  width: 18px;
  height: 18px;
  color: #8c8c91;
}

.st-filter-v4__search input {
  width: 100%;
  min-width: 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: var(--st-v4-text);

  font: inherit;
  font-size: 14px;
}

.st-filter-v4__search input::placeholder {
  color: #909095;
}

.st-filter-v4__clear-search {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;

  background: transparent;
  color: #777;

  cursor: pointer;
}

.st-filter-v4__clear-search svg {
  width: 15px;
  height: 15px;
}

.st-filter-v4__search-button {
  min-width: 118px;
  min-height: 48px;

  padding: 0 24px;

  border: 0;
  border-radius: 15px;

  background: var(--st-v4-mustard);
  color: #111;

  font-size: 13px;
  font-weight: 650;

  cursor: pointer;

  transition:
    transform 160ms ease,
    filter 160ms ease;
}

@media (hover:hover) {
  .st-filter-v4__search-button:hover {
    filter: brightness(.97);
    transform: translateY(-1px);
  }
}

.st-filter-v4__bar {
  margin-top: 16px;
  padding-bottom: 18px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  border-bottom:
    1px solid
    var(--st-v4-line);
}

.st-filter-v4__filters {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.st-filter-v4__select,
.st-filter-v4__sort {
  position: relative;

  height: 44px;

  display: flex;
  align-items: center;

  border:
    1px solid
    var(--st-v4-line);

  border-radius: 999px;

  background: #fff;

  overflow: hidden;
}

.st-filter-v4__select > span {
  position: absolute;
  left: 16px;
  z-index: 1;

  color: var(--st-v4-text);

  font-size: 13px;
  font-weight: 560;

  pointer-events: none;
}

.st-filter-v4__select select {
  appearance: none;

  min-width: 126px;
  height: 100%;

  padding:
    0 40px
    0 16px;

  border: 0;
  outline: 0;

  background: transparent;
  color: transparent;

  cursor: pointer;
}

.st-filter-v4__select svg,
.st-filter-v4__sort svg {
  position: absolute;
  right: 14px;

  width: 14px;
  height: 14px;

  pointer-events: none;
}

.st-filter-v4__pill {
  height: 44px;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 0 16px;

  border:
    1px solid
    var(--st-v4-line);

  border-radius: 999px;

  background: #fff;
  color: var(--st-v4-text);

  font-size: 13px;
  font-weight: 560;

  cursor: pointer;
}

.st-filter-v4__pill > svg {
  width: 14px;
  height: 14px;
}

.st-filter-v4__pill.is-active {
  background: var(--st-v4-black);
  border-color: var(--st-v4-black);
  color: #fff;
}

.st-filter-v4__stock-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--st-v4-green);
}

.st-filter-v4__sort {
  min-width: 170px;
  background: var(--st-v4-soft);
  border-color: transparent;
}

.st-filter-v4__sort > span {
  padding-left: 16px;

  color: #8b8b90;

  font-size: 12px;

  pointer-events: none;
}

.st-filter-v4__sort select {
  appearance: none;

  flex: 1;
  height: 100%;

  padding:
    0 38px
    0 8px;

  border: 0;
  outline: 0;

  background: transparent;
  color: var(--st-v4-text);

  font-size: 13px;
  font-weight: 590;

  cursor: pointer;
}

.st-filter-v4__price-wrap {
  position: relative;
}

.st-filter-v4__price-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;

  border: 0;
  background: transparent;
}

.st-filter-v4__price-popover {
  position: absolute;
  z-index: 30;

  top: calc(100% + 12px);
  left: 0;

  width: min(360px, calc(100vw - 32px));

  padding: 22px;

  border:
    1px solid
    var(--st-v4-line);

  border-radius: 22px;

  background:
    rgba(255, 255, 255, .98);

  box-shadow:
    0 24px 60px
    rgba(0, 0, 0, .13);
}

.st-filter-v4__price-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  padding-bottom: 18px;

  border-bottom:
    1px solid
    var(--st-v4-line);
}

.st-filter-v4__price-title small,
.st-filter-v4__price-title strong {
  display: block;
}

.st-filter-v4__price-title small {
  margin-bottom: 5px;

  color: var(--st-v4-muted);

  font-size: 11px;
}

.st-filter-v4__price-title strong {
  font-size: 20px;
  letter-spacing: -.025em;
}

.st-filter-v4__price-title > button {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;

  background: var(--st-v4-soft);

  cursor: pointer;
}

.st-filter-v4__price-title svg {
  width: 15px;
  height: 15px;
}

.st-filter-v4__price-fields {
  padding: 18px 0;

  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.st-filter-v4__price-fields label > span {
  display: block;

  margin: 0 0 7px;

  color: var(--st-v4-muted);

  font-size: 11px;
}

.st-filter-v4__price-fields label > div {
  min-height: 48px;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 0 13px;

  border:
    1px solid
    var(--st-v4-line);

  border-radius: 13px;

  background: var(--st-v4-soft-2);
}

.st-filter-v4__price-fields input {
  width: 100%;
  min-width: 0;

  border: 0;
  outline: 0;

  background: transparent;

  font: inherit;
  font-weight: 600;
}

.st-filter-v4__price-range {
  color: var(--st-v4-muted);

  font-size: 11px;
}

.st-filter-v4__price-actions {
  margin-top: 18px;

  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.st-filter-v4__price-actions button {
  min-height: 44px;

  border: 0;
  border-radius: 12px;

  background: var(--st-v4-soft);

  font: inherit;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;
}

.st-filter-v4__price-actions button:last-child {
  background: var(--st-v4-mustard);
  color: #111;
}

.st-filter-v4__mobile-label {
  display: none;
}


/* ======================================================================
   PRODUCT PAGE V4
   ====================================================================== */

.st-product-v4 {
  min-height: 100vh;

  background: #fff;
  color: var(--st-v4-text);
}

.st-product-v4__shell {
  width:
    min(
      calc(100% - 48px),
      1240px
    );

  margin: 0 auto;

  padding:
    34px 0
    110px;
}

.st-product-v4__breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 54px;

  color: #8a8a90;

  font-size: 12px;
}

.st-product-v4__breadcrumb a,
.st-product-v4__breadcrumb strong {
  color: inherit;
  font-weight: 500;
  text-decoration: none;
}

.st-product-v4__masthead {
  display: grid;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(240px, .5fr);

  align-items: end;

  gap:
    clamp(36px, 7vw, 110px);

  padding-bottom:
    clamp(42px, 5vw, 70px);

  border-bottom:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__eyebrow {
  display: block;

  margin-bottom: 18px;

  color: var(--st-v4-muted);

  font-size: 13px;
}

.st-product-v4__masthead h1 {
  max-width: 820px;

  margin: 0;

  font-size:
    clamp(
      54px,
      7vw,
      104px
    );

  line-height: .91;

  font-weight: 630;

  letter-spacing: -.07em;
}

.st-product-v4__masthead-copy > p {
  max-width: 720px;

  margin:
    30px 0 0;

  color: #6f6f74;

  font-size:
    clamp(15px, 1.5vw, 18px);

  line-height: 1.58;
}

.st-product-v4__masthead-commerce {
  padding-bottom: 5px;
}

.st-product-v4__availability {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  color: #6e6e73;

  font-size: 12px;
  font-weight: 560;
}

.st-product-v4__availability i {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #aaa;
}

.st-product-v4__availability.is-available i {
  background: var(--st-v4-green);
}

.st-product-v4__masthead-price {
  margin-top: 25px;

  display: flex;
  align-items: baseline;
  gap: 12px;
}

.st-product-v4__masthead-price strong {
  font-size:
    clamp(28px, 3vw, 42px);

  line-height: 1;

  font-weight: 600;

  letter-spacing: -.04em;
}

.st-product-v4__masthead-price del {
  color: #909095;

  font-size: 15px;
}

.st-product-v4__masthead-commerce > small {
  display: block;

  margin-top: 18px;

  color: #9a9a9f;

  font-size: 10px;
}

.st-product-v4__visual {
  padding:
    clamp(46px, 6vw, 86px)
    0
    clamp(62px, 8vw, 108px);
}

/* Make whatever gallery implementation is currently active behave
   like one large premium visual stage instead of the old left column. */
.st-product-v4__visual > * {
  width: 100% !important;
  max-width: none !important;
}

.st-product-v4__visual
:where(
  .st-gallery-v3,
  .st-pdp17-gallery
) {
  width: 100% !important;

  border: 0 !important;
  border-radius: 34px !important;

  background: var(--st-v4-soft) !important;

  box-shadow: none !important;
}

.st-product-v4__visual
:where(
  .st-gallery-v3__stage,
  .st-pdp17-gallery__stage
) {
  min-height:
    clamp(
      560px,
      67vw,
      790px
    ) !important;

  border: 0 !important;

  background: var(--st-v4-soft) !important;
}

.st-product-v4__commerce {
  padding:
    clamp(62px, 7vw, 96px)
    0;

  border-top:
    1px solid
    var(--st-v4-line);

  border-bottom:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__commerce-heading {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(240px, 380px);

  align-items: end;

  gap: 40px;

  margin-bottom:
    46px;
}

.st-product-v4__commerce-heading span,
.st-product-v4__information-heading span,
.st-product-v4__identity > span,
.st-product-v4__overview > span,
.st-product-v4__specs > span {
  color: var(--st-v4-muted);

  font-size: 12px;
}

.st-product-v4__commerce-heading h2,
.st-product-v4__information-heading h2 {
  margin:
    8px 0 0;

  max-width: 760px;

  font-size:
    clamp(
      40px,
      5vw,
      70px
    );

  line-height: .98;

  font-weight: 610;

  letter-spacing: -.055em;
}

.st-product-v4__commerce-heading p {
  margin: 0;

  color: #747479;

  font-size: 14px;
  line-height: 1.55;
}

.st-product-v4__commerce-layout {
  display: grid;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(280px, .5fr);

  align-items: start;

  gap:
    clamp(28px, 5vw, 68px);
}

.st-product-v4__purchase {
  min-width: 0;
}

/* Flatten the purchase component into this architecture regardless
   of the temporary class namespace it currently carries. */
.st-product-v4__purchase > section {
  width: 100% !important;

  margin: 0 !important;

  border: 0 !important;

  border-radius: 0 !important;

  background: transparent !important;

  box-shadow: none !important;
}

.st-product-v4__purchase > section > header {
  padding:
    0 0 20px !important;

  border-bottom:
    1px solid
    var(--st-v4-line) !important;

  background: transparent !important;
}

.st-product-v4__identity {
  position: sticky;
  top: 105px;

  padding: 28px;

  border-radius: 24px;

  background: var(--st-v4-soft);
}

.st-product-v4__identity dl {
  margin:
    24px 0 0;
}

.st-product-v4__identity dl > div {
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  border-top:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__identity dt {
  color: var(--st-v4-muted);

  font-size: 12px;
}

.st-product-v4__identity dd {
  margin: 0;

  font-size: 13px;
  font-weight: 600;

  text-align: right;
}

.st-product-v4__information {
  padding:
    clamp(76px, 9vw, 126px)
    0;
}

.st-product-v4__information-heading {
  margin-bottom:
    56px;
}

.st-product-v4__information-layout {
  display: grid;

  grid-template-columns:
    minmax(0, .8fr)
    minmax(0, 1.2fr);

  gap:
    clamp(48px, 8vw, 120px);
}

.st-product-v4__overview,
.st-product-v4__specs {
  padding: 0;

  border: 0;
  background: transparent;
}

.st-product-v4__overview h3,
.st-product-v4__specs h3 {
  margin:
    10px 0 0;

  font-size:
    clamp(
      28px,
      3vw,
      40px
    );

  line-height: 1;

  font-weight: 570;

  letter-spacing: -.045em;
}

.st-product-v4__overview > p {
  margin:
    28px 0 0;

  color: #717176;

  font-size: 16px;
  line-height: 1.7;
}

.st-product-v4__specs dl {
  margin:
    26px 0 0;
}

.st-product-v4__specs dl > div {
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;

  border-top:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__specs dt {
  color: #8a8a90;

  font-size: 12px;

  text-transform: capitalize;
}

.st-product-v4__specs dd {
  margin: 0;

  color: var(--st-v4-text);

  font-size: 13px;
  font-weight: 600;

  text-align: right;
}

.st-product-v4__services {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top:
    1px solid
    var(--st-v4-line);

  border-bottom:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__services > a,
.st-product-v4__services > div {
  min-width: 0;

  padding:
    30px 28px;

  display: grid;

  grid-template-columns:
    24px minmax(0, 1fr) 18px;

  align-items: start;

  gap: 15px;

  color: inherit;
  text-decoration: none;
}

.st-product-v4__services > * + * {
  border-left:
    1px solid
    var(--st-v4-line);
}

.st-product-v4__services svg {
  width: 19px;
  height: 19px;
}

.st-product-v4__services span,
.st-product-v4__services strong,
.st-product-v4__services p {
  display: block;
}

.st-product-v4__services span {
  margin-bottom: 5px;

  color: var(--st-v4-muted);

  font-size: 11px;
}

.st-product-v4__services strong {
  font-size: 15px;
  font-weight: 600;
}

.st-product-v4__services p {
  margin:
    9px 0 0;

  color: #77777c;

  font-size: 12px;
  line-height: 1.5;
}

.st-product-v4__related {
  padding-top:
    clamp(82px, 9vw, 130px);
}

.st-product-v4__related > header {
  margin-bottom: 34px;

  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
}

.st-product-v4__related header span {
  color: var(--st-v4-muted);

  font-size: 12px;
}

.st-product-v4__related h2 {
  margin:
    8px 0 0;

  font-size:
    clamp(
      38px,
      5vw,
      64px
    );

  line-height: 1;

  font-weight: 610;

  letter-spacing: -.055em;
}

.st-product-v4__related header > a {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  color: var(--st-v4-text);

  font-size: 13px;
  font-weight: 600;

  text-decoration: none;
}

.st-product-v4__related header svg {
  width: 15px;
  height: 15px;
}

.st-product-v4__related-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px;
}


/* ======================================================================
   RESPONSIVE
   ====================================================================== */

@media (max-width: 1040px) {
  .st-retail-shop-v4
  .st-v2-product-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;
  }

  .st-product-v4__masthead {
    grid-template-columns:
      minmax(0, 1fr)
      230px;
  }

  .st-product-v4__commerce-layout {
    grid-template-columns:
      minmax(0, 1fr)
      280px;
  }

  .st-product-v4__information-layout {
    gap: 54px;
  }
}

@media (max-width: 820px) {
  .st-filter-v4__bar {
    align-items: flex-start;
    flex-direction: column;
  }

  .st-filter-v4__sort {
    width: 100%;
  }

  .st-product-v4__masthead,
  .st-product-v4__commerce-heading,
  .st-product-v4__commerce-layout,
  .st-product-v4__information-layout {
    grid-template-columns: 1fr;
  }

  .st-product-v4__masthead-commerce {
    padding-top: 10px;
  }

  .st-product-v4__identity {
    position: static;
  }

  .st-product-v4__services {
    grid-template-columns: 1fr;
  }

  .st-product-v4__services > * + * {
    border-left: 0;

    border-top:
      1px solid
      var(--st-v4-line);
  }

  .st-product-v4__related-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .st-retail-shop-v4 .st-v2-container,
  .st-product-v4__shell {
    width:
      calc(100% - 28px) !important;
  }

  .st-retail-shop-v4
  .st-v2-product-grid {
    grid-template-columns:
      1fr !important;
  }

  .st-filter-v4__search {
    grid-template-columns:
      19px minmax(0, 1fr) auto;

    padding-left: 15px;
  }

  .st-filter-v4__search-button {
    min-width: 82px;

    padding:
      0 16px;
  }

  .st-filter-v4__clear-search {
    display: none;
  }

  .st-filter-v4__filters {
    width: 100%;
  }

  .st-filter-v4__select,
  .st-filter-v4__pill {
    flex:
      1 1
      calc(50% - 5px);

    min-width: 0;
  }

  .st-filter-v4__select select {
    width: 100%;
    min-width: 0;
  }

  .st-filter-v4__price-wrap {
    flex:
      1 1
      calc(50% - 5px);
  }

  .st-filter-v4__price-wrap
  .st-filter-v4__pill {
    width: 100%;
  }

  .st-product-v4__shell {
    padding-top: 24px;
  }

  .st-product-v4__breadcrumb {
    margin-bottom: 38px;
  }

  .st-product-v4__masthead h1 {
    font-size:
      clamp(
        46px,
        16vw,
        68px
      );
  }

  .st-product-v4__visual {
    padding:
      38px 0
      64px;
  }

  .st-product-v4__visual
  :where(
    .st-gallery-v3__stage,
    .st-pdp17-gallery__stage
  ) {
    min-height:
      460px !important;
  }

  .st-product-v4__commerce {
    padding:
      58px 0;
  }

  .st-product-v4__information {
    padding:
      72px 0;
  }

  .st-product-v4__related-grid {
    grid-template-columns: 1fr;
  }
}


/* STEREOPHONIE V5 SIMPLE PRODUCT
   ====================================================================== */

/*
   GLOBAL INTERACTION RESET
   No decorative page transitions / loading animations.
*/

html {
  scroll-behavior: auto !important;
}

html,
body {
  scroll-behavior: auto !important;
}

*,
*::before,
*::after {
  transition-property: none !important;
  transition-duration: 0s !important;
  transition-delay: 0s !important;

  animation-name: none !important;
  animation-duration: 0s !important;
  animation-delay: 0s !important;

  scroll-behavior: auto !important;
}


/*
   TEXT SELECTION
*/

::selection {
  background: #f6b43a;
  color: #171719;
}

::-moz-selection {
  background: #f6b43a;
  color: #171719;
}


/* ----------------------------------------------------------------------
   PRODUCT PAGE
   ---------------------------------------------------------------------- */

.st-product-v5 {
  min-height: 100vh;

  background: #fff;
  color: #1d1d1f;
}

.st-product-v5__shell {
  width:
    min(
      calc(100% - 48px),
      1160px
    );

  margin-inline: auto;

  padding:
    36px 0
    110px;
}


/* Breadcrumb */

.st-product-v5__breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 58px;

  color: #8a8a8f;

  font-size: 12px;
}

.st-product-v5__breadcrumb a,
.st-product-v5__breadcrumb strong {
  color: inherit;

  font-weight: 500;

  text-decoration: none;
}


/* Product title */

.st-product-v5__intro {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 48px;

  padding-bottom: 38px;

  border-bottom:
    1px solid
    rgba(0, 0, 0, .08);
}

.st-product-v5__category {
  display: block;

  margin-bottom: 12px;

  color: #85858a;

  font-size: 13px;
}

.st-product-v5__intro h1 {
  margin: 0;

  color: #1d1d1f;

  font-size:
    clamp(
      44px,
      6vw,
      76px
    );

  line-height: .98;

  font-weight: 620;

  letter-spacing: -.055em;
}

.st-product-v5__intro-meta {
  flex: 0 0 auto;

  display: flex;
  flex-direction: column;
  align-items: flex-end;

  gap: 12px;
}

.st-product-v5__price {
  display: flex;
  align-items: baseline;
  gap: 10px;
}

.st-product-v5__price strong {
  font-size:
    clamp(
      24px,
      2.8vw,
      34px
    );

  font-weight: 600;

  letter-spacing: -.035em;
}

.st-product-v5__price del {
  color: #929297;

  font-size: 14px;
}

.st-product-v5__availability {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  color: #77777c;

  font-size: 12px;
}

.st-product-v5__availability i {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #aaa;
}

.st-product-v5__availability.is-available i {
  background: #f6b43a;
}


/* Gallery */

.st-product-v5__gallery {
  padding:
    46px 0
    68px;
}

.st-product-v5__gallery > * {
  width: 100% !important;
}

.st-product-v5__gallery
:where(
  .st-gallery-v3,
  .st-pdp17-gallery
) {
  width: 100% !important;

  overflow: hidden !important;

  border: 0 !important;
  border-radius: 30px !important;

  background: #f5f5f7 !important;

  box-shadow: none !important;
}

.st-product-v5__gallery
:where(
  .st-gallery-v3__stage,
  .st-pdp17-gallery__stage
) {
  min-height:
    clamp(
      520px,
      57vw,
      700px
    ) !important;

  border: 0 !important;

  background: #f5f5f7 !important;
}


/* Purchase section */

.st-product-v5__buy {
  width:
    min(
      100%,
      900px
    );

  margin-inline: auto;

  padding:
    70px 0;

  border-top:
    1px solid
    rgba(0, 0, 0, .08);
}

.st-product-v5__buy-heading {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 28px;
}

.st-product-v5__buy-heading span {
  display: block;

  margin-bottom: 7px;

  color: #89898e;

  font-size: 12px;
}

.st-product-v5__buy-heading h2 {
  margin: 0;

  color: #1d1d1f;

  font-size:
    clamp(
      30px,
      4vw,
      46px
    );

  line-height: 1;

  font-weight: 590;

  letter-spacing: -.045em;
}

.st-product-v5__buy-heading small {
  color: #9b9ba0;

  font-size: 10px;
}


/*
   Flatten current purchase component.
*/

.st-product-v5__buy > section {
  width: 100% !important;

  margin: 0 !important;

  padding: 0 !important;

  border: 0 !important;

  border-radius: 0 !important;

  background: transparent !important;

  box-shadow: none !important;
}

.st-product-v5__buy
> section
> header {
  min-height: 0 !important;

  padding:
    14px 0 !important;

  border-top:
    1px solid
    rgba(0, 0, 0, .08) !important;

  border-bottom:
    1px solid
    rgba(0, 0, 0, .08) !important;

  background: transparent !important;
}


/* Product information */

.st-product-v5__details {
  display: grid;

  grid-template-columns:
    minmax(0, .85fr)
    minmax(0, 1.15fr);

  gap:
    clamp(
      60px,
      10vw,
      130px
    );

  padding:
    90px 0;

  border-top:
    1px solid
    rgba(0, 0, 0, .08);
}

.st-product-v5__details
> div
> span {
  display: block;

  margin-bottom: 10px;

  color: #8a8a8f;

  font-size: 12px;
}

.st-product-v5__details h2 {
  margin: 0;

  color: #1d1d1f;

  font-size:
    clamp(
      28px,
      3.5vw,
      42px
    );

  line-height: 1;

  font-weight: 570;

  letter-spacing: -.04em;
}

.st-product-v5__description > p {
  max-width: 470px;

  margin:
    26px 0 0;

  color: #6e6e73;

  font-size: 15px;
  line-height: 1.7;
}

.st-product-v5__basic-info {
  margin:
    34px 0 0;
}

.st-product-v5__basic-info > div,
.st-product-v5__specifications dl > div {
  min-height: 49px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 24px;

  border-top:
    1px solid
    rgba(0, 0, 0, .075);
}

.st-product-v5__basic-info dt,
.st-product-v5__specifications dt {
  color: #8a8a8f;

  font-size: 12px;
}

.st-product-v5__basic-info dd,
.st-product-v5__specifications dd {
  margin: 0;

  color: #1d1d1f;

  font-size: 12px;
  font-weight: 600;

  text-align: right;
}

.st-product-v5__specifications dl {
  margin:
    28px 0 0;
}


/* Delivery / Returns / Secure */

.st-product-v5__services {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  border-top:
    1px solid
    rgba(0, 0, 0, .08);

  border-bottom:
    1px solid
    rgba(0, 0, 0, .08);
}

.st-product-v5__services > a,
.st-product-v5__services > div {
  min-height: 112px;

  display: grid;

  grid-template-columns:
    20px minmax(0, 1fr) 16px;

  align-items: center;

  gap: 14px;

  padding:
    24px;

  color: #1d1d1f;

  text-decoration: none;
}

.st-product-v5__services > * + * {
  border-left:
    1px solid
    rgba(0, 0, 0, .08);
}

.st-product-v5__services svg {
  width: 18px;
  height: 18px;
}

.st-product-v5__services strong,
.st-product-v5__services span {
  display: block;
}

.st-product-v5__services strong {
  margin-bottom: 5px;

  font-size: 14px;
  font-weight: 600;
}

.st-product-v5__services span {
  color: #85858a;

  font-size: 11px;
}


/* Related products */

.st-product-v5__related {
  padding-top:
    92px;
}

.st-product-v5__related > header {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 28px;
}

.st-product-v5__related header span {
  display: block;

  margin-bottom: 8px;

  color: #8a8a8f;

  font-size: 12px;
}

.st-product-v5__related h2 {
  margin: 0;

  font-size:
    clamp(
      30px,
      4vw,
      46px
    );

  line-height: 1;

  font-weight: 580;

  letter-spacing: -.045em;
}

.st-product-v5__related header > a {
  display: inline-flex;

  align-items: center;
  gap: 7px;

  color: #1d1d1f;

  font-size: 12px;
  font-weight: 600;

  text-decoration: none;
}

.st-product-v5__related header svg {
  width: 14px;
  height: 14px;
}

.st-product-v5__related-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 22px;
}


/* ----------------------------------------------------------------------
   RESPONSIVE
   ---------------------------------------------------------------------- */

@media (max-width: 820px) {
  .st-product-v5__intro {
    align-items: flex-start;
    flex-direction: column;

    gap: 24px;
  }

  .st-product-v5__intro-meta {
    align-items: flex-start;
  }

  .st-product-v5__details {
    grid-template-columns: 1fr;

    gap: 70px;
  }

  .st-product-v5__services {
    grid-template-columns: 1fr;
  }

  .st-product-v5__services > * + * {
    border-left: 0;

    border-top:
      1px solid
      rgba(0, 0, 0, .08);
  }

  .st-product-v5__related-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .st-product-v5__shell {
    width:
      calc(100% - 28px);
  }

  .st-product-v5__breadcrumb {
    margin-bottom: 40px;
  }

  .st-product-v5__intro h1 {
    font-size:
      clamp(
        42px,
        14vw,
        60px
      );
  }

  .st-product-v5__gallery {
    padding:
      34px 0
      54px;
  }

  .st-product-v5__gallery
  :where(
    .st-gallery-v3__stage,
    .st-pdp17-gallery__stage
  ) {
    min-height:
      430px !important;
  }

  .st-product-v5__buy {
    padding:
      54px 0;
  }

  .st-product-v5__buy-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .st-product-v5__details {
    padding:
      70px 0;
  }

  .st-product-v5__related-grid {
    grid-template-columns: 1fr;
  }
}



/* STEREOPHONIE V6 PRODUCT POLISH
   ====================================================================== */

:root {
  --st-mustard: #f6b43a;
  --st-black: #1d1d1f;
  --st-gray-1: #f5f5f7;
  --st-gray-2: #e8e8ed;
  --st-gray-3: #86868b;
}


/* ============================================================
   NO GREEN ON STOREFRONT
   ============================================================ */

.st3-product-page .is-ready,
.st-product-v5 .is-ready,
.st-product-v5 .is-available,
.st-product-v5 [class*="in-stock"],
.st-retail-shop .is-ready,
.st-retail-shop .is-available,
.st-retail-shop [class*="in-stock"] {
  color: var(--st-mustard) !important;
}

.st3-product-page .is-ready i,
.st-product-v5 .is-ready i,
.st-product-v5 .is-available i,
.st-retail-shop .is-ready i,
.st-retail-shop .is-available i {
  background: var(--st-mustard) !important;
}


/* Product heading availability */

.st-product-v5__availability.is-available {
  color: #5f6065 !important;
}

.st-product-v5__availability.is-available i {
  background:
    var(--st-mustard) !important;
}


/* ============================================================
   PRODUCT PAGE — REDUCE SCALE / IMPROVE RHYTHM
   ============================================================ */

.st-product-v5__shell {
  width:
    min(
      calc(100% - 48px),
      1120px
    ) !important;

  padding-top:
    28px !important;
}

.st-product-v5__breadcrumb {
  margin-bottom:
    42px !important;
}

.st-product-v5__intro {
  padding-bottom:
    30px !important;
}

.st-product-v5__intro h1 {
  font-size:
    clamp(
      42px,
      5vw,
      64px
    ) !important;
}


/*
  Gallery now feels like a product visual,
  not a giant billboard.
*/

.st-product-v5__gallery {
  padding:
    34px 0
    46px !important;
}

.st-product-v5__gallery
:where(
  .st-gallery-v3__stage,
  .st-pdp17-gallery__stage
) {
  min-height:
    clamp(
      430px,
      49vw,
      590px
    ) !important;

  max-height:
    590px !important;
}

.st-product-v5__gallery
:where(
  .st-gallery-v3__image,
  .st-pdp17-gallery__image
) {
  object-fit:
    contain !important;
}


/* ============================================================
   PURCHASE AREA
   ============================================================ */

.st-product-v5__buy {
  width:
    min(
      100%,
      780px
    ) !important;

  padding:
    48px 0
    66px !important;
}

.st-product-v5__buy-heading {
  margin-bottom:
    20px !important;
}

.st-product-v5__buy-heading h2 {
  font-size:
    clamp(
      27px,
      3vw,
      38px
    ) !important;
}


/* Main purchase module */

.st-purchase-v6 {
  width: 100%;

  display: flex;
  flex-direction: column;

  gap: 16px;
}


/* Variant chooser */

.st-purchase-v6__variants {
  padding-bottom:
    18px;

  border-bottom:
    1px solid
    rgba(0,0,0,.075);
}

.st-purchase-v6__label-row {
  margin-bottom:
    13px;
}

.st-purchase-v6__label-row span,
.st-purchase-v6__selection small,
.st-purchase-v6__quantity > span {
  display: block;

  color: #8a8a8f;

  font-size: 11px;

  line-height: 1.2;
}

.st-purchase-v6__label-row strong {
  display: block;

  margin-top: 4px;

  color: #1d1d1f;

  font-size: 14px;

  font-weight: 600;
}

.st-purchase-v6__variant-list {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;
}

.st-purchase-v6__variant-list button {
  min-height: 42px;

  display: inline-flex;
  align-items: center;

  gap: 9px;

  padding:
    0 16px;

  border:
    1px solid
    #d9d9de;

  border-radius:
    999px;

  background:
    #fff;

  color:
    #1d1d1f;

  font-size:
    12px;

  font-weight:
    550;

  cursor: pointer;
}

.st-purchase-v6__variant-list
button.is-active {
  border-color:
    var(--st-mustard);

  box-shadow:
    inset
    0 0 0 1px
    var(--st-mustard);
}

.st-purchase-v6__variant-list
button.is-unavailable {
  opacity: .42;
}

.st-purchase-v6__variant-list
button svg {
  width: 14px;
  height: 14px;
}


/* Selected */

.st-purchase-v6__selection {
  min-height:
    78px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding:
    17px 20px;

  border-radius:
    18px;

  background:
    #f5f5f7;
}

.st-purchase-v6__selection > div:first-child {
  min-width: 0;
}

.st-purchase-v6__selection
> div:first-child
> strong {
  display: block;

  margin-top:
    5px;

  color:
    #1d1d1f;

  font-size:
    15px;

  font-weight:
    650;
}

.st-purchase-v6__selection
> div:first-child
> span {
  display: block;

  margin-top:
    4px;

  color:
    #929297;

  font-size:
    10px;
}

.st-purchase-v6__selection-price {
  flex: 0 0 auto;

  text-align: right;
}

.st-purchase-v6__selection-price strong {
  display: block;

  font-size:
    20px;

  font-weight:
    650;

  letter-spacing:
    -.025em;
}

.st-purchase-v6__selection-price del {
  display: block;

  margin-top:
    3px;

  color:
    #9a9aa0;

  font-size:
    11px;
}


/* Status */

.st-purchase-v6__status {
  min-height:
    50px;

  display: flex;
  align-items: center;

  gap: 11px;

  padding:
    11px 15px;

  border:
    1px solid
    rgba(0,0,0,.06);

  border-radius:
    14px;

  background:
    #fafafa;
}

.st-purchase-v6__status > i {
  width:
    7px;

  height:
    7px;

  flex:
    0 0 auto;

  border-radius:
    50%;

  background:
    var(--st-mustard) !important;
}

.st-purchase-v6__status strong {
  display: block;

  color:
    #1d1d1f !important;

  font-size:
    11px;

  font-weight:
    700;
}

.st-purchase-v6__status span {
  display: block;

  margin-top:
    2px;

  color:
    #8a8a8f;

  font-size:
    10px;
}


/* Quantity + CTA row */

.st-purchase-v6__commerce {
  display: grid;

  grid-template-columns:
    150px
    minmax(0, 1fr);

  align-items: end;

  gap: 14px;

  padding-top:
    6px;
}

.st-purchase-v6__quantity {
  min-width: 0;
}

.st-purchase-v6__stepper {
  width:
    118px;

  height:
    44px;

  margin-top:
    7px;

  display: grid;

  grid-template-columns:
    36px 1fr 36px;

  align-items: center;

  overflow: hidden;

  border:
    1px solid
    #dedee3;

  border-radius:
    999px;

  background:
    #fff;
}

.st-purchase-v6__stepper button {
  width:
    36px;

  height:
    42px;

  display: flex;
  align-items: center;
  justify-content: center;

  border:
    0;

  background:
    transparent;

  color:
    #1d1d1f;

  cursor: pointer;
}

.st-purchase-v6__stepper
button:disabled {
  opacity: .28;
}

.st-purchase-v6__stepper svg {
  width:
    13px;

  height:
    13px;
}

.st-purchase-v6__stepper strong {
  text-align: center;

  color:
    #1d1d1f;

  font-size:
    14px;

  font-weight:
    650;
}

.st-purchase-v6__quantity
> small {
  display: block;

  margin-top:
    5px;

  color:
    #9a9aa0;

  font-size:
    9px;
}


/* Buttons */

.st-purchase-v6__primary-actions {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap:
    9px;
}

.st-purchase-v6__cart,
.st-purchase-v6__buy,
.st-purchase-v6__notify,
.st-purchase-v6__disabled,
.st-purchase-v6__save {
  min-height:
    48px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap:
    9px;

  border:
    0;

  border-radius:
    999px;

  font-size:
    12px;

  font-weight:
    620;

  cursor:
    pointer;
}

.st-purchase-v6__cart {
  background:
    var(--st-mustard);

  color:
    #171719;
}

.st-purchase-v6__buy {
  background:
    #1d1d1f;

  color:
    #fff;
}

.st-purchase-v6__notify {
  width: 100%;

  background:
    var(--st-mustard);

  color:
    #171719;
}

.st-purchase-v6__disabled {
  width: 100%;

  background:
    #ededf0;

  color:
    #88888d;

  cursor:
    not-allowed;
}

.st-purchase-v6__save {
  width: 100%;

  min-height:
    44px;

  border:
    1px solid
    #dcdce1;

  background:
    #fff;

  color:
    #1d1d1f;
}

.st-purchase-v6__save.is-active {
  border-color:
    var(--st-mustard);

  background:
    #fffaf0;
}

.st-purchase-v6__cart svg,
.st-purchase-v6__buy svg,
.st-purchase-v6__notify svg,
.st-purchase-v6__disabled svg,
.st-purchase-v6__save svg {
  width:
    16px;

  height:
    16px;

  stroke-width:
    1.8;
}


/* Messages */

.st-purchase-v6__message {
  display: flex;
  align-items: center;

  gap: 8px;

  min-height:
    42px;

  padding:
    9px 13px;

  border-radius:
    12px;

  background:
    #f5f5f7;

  color:
    #505056;

  font-size:
    11px;
}

.st-purchase-v6__message.is-success {
  border-left:
    3px solid
    var(--st-mustard);
}

.st-purchase-v6__message svg {
  width:
    15px;

  height:
    15px;
}


/* ============================================================
   DETAILS
   ============================================================ */

.st-product-v5__details {
  gap:
    clamp(
      50px,
      8vw,
      95px
    ) !important;

  padding:
    72px 0 !important;
}

.st-product-v5__details h2 {
  font-size:
    clamp(
      27px,
      3vw,
      36px
    ) !important;
}

.st-product-v5__description > p {
  font-size:
    14px !important;

  line-height:
    1.65 !important;
}


/* ============================================================
   SERVICE BAR
   ============================================================ */

.st-product-v5__services
> a,
.st-product-v5__services
> div {
  min-height:
    94px !important;

  padding:
    20px !important;
}


/* ============================================================
   MODAL
   ============================================================ */

.st-purchase-v6-modal {
  position:
    fixed;

  inset:
    0;

  z-index:
    10000;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    24px;

  background:
    rgba(0,0,0,.25);

  backdrop-filter:
    blur(12px);
}

.st-purchase-v6-modal__window {
  width:
    min(
      100%,
      440px
    );

  overflow:
    hidden;

  border-radius:
    24px;

  background:
    #fff;

  box-shadow:
    0 30px 90px
    rgba(0,0,0,.18);
}

.st-purchase-v6-modal__window
> header {
  min-height:
    58px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  padding:
    0 20px;

  border-bottom:
    1px solid
    rgba(0,0,0,.07);
}

.st-purchase-v6-modal__window
> header > div {
  display:
    flex;

  align-items:
    center;

  gap:
    9px;
}

.st-purchase-v6-modal__window
> header svg {
  width:
    16px;

  height:
    16px;
}

.st-purchase-v6-modal__window
> header button {
  width:
    34px;

  height:
    34px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border:
    0;

  border-radius:
    50%;

  background:
    #f5f5f7;
}

.st-purchase-v6-modal__body {
  padding:
    28px;
}

.st-purchase-v6-modal__body
> span {
  color:
    #8a8a8f;

  font-size:
    11px;
}

.st-purchase-v6-modal__body h2 {
  margin:
    7px 0
    11px;

  color:
    #1d1d1f;

  font-size:
    30px;

  line-height:
    1;

  font-weight:
    600;

  letter-spacing:
    -.04em;
}

.st-purchase-v6-modal__body p {
  margin:
    0 0
    20px;

  color:
    #77777c;

  font-size:
    13px;

  line-height:
    1.55;
}

.st-purchase-v6-modal__body input {
  width:
    100%;

  height:
    48px;

  padding:
    0 15px;

  border:
    1px solid
    #dcdce1;

  border-radius:
    13px;

  outline:
    none;

  font:
    inherit;
}

.st-purchase-v6-modal__body
input:focus {
  border-color:
    var(--st-mustard);

  box-shadow:
    0 0 0 3px
    rgba(246,180,58,.16);
}

.st-purchase-v6-modal__body
> button {
  width:
    100%;

  min-height:
    48px;

  margin-top:
    12px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    8px;

  border:
    0;

  border-radius:
    999px;

  background:
    var(--st-mustard);

  color:
    #171719;

  font-weight:
    650;
}

.st-purchase-v6-modal__error {
  display:
    block;

  margin-top:
    8px;

  color:
    #bf3f3f;

  font-size:
    11px;
}


/* ============================================================
   SAVE / BOOKMARK ICON THROUGHOUT STOREFRONT
   ============================================================ */

.st3-header button svg,
.st3-header a svg,
.st-retail-shop button svg,
.st-retail-shop a svg {
  stroke-width:
    1.8;
}


/* ============================================================
   MUSTARD SELECTION
   ============================================================ */

::selection {
  background:
    var(--st-mustard) !important;

  color:
    #171719 !important;
}

::-moz-selection {
  background:
    var(--st-mustard) !important;

  color:
    #171719 !important;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 760px) {

  .st-purchase-v6__commerce {
    grid-template-columns:
      1fr;
  }

  .st-purchase-v6__quantity {
    display:
      flex;

    align-items:
      center;

    gap:
      10px;
  }

  .st-purchase-v6__quantity
  > span {
    margin-right:
      auto;
  }

  .st-purchase-v6__quantity
  > small {
    margin:
      0;
  }

  .st-purchase-v6__stepper {
    margin:
      0;
  }

}


@media (max-width: 560px) {

  .st-product-v5__gallery
  :where(
    .st-gallery-v3__stage,
    .st-pdp17-gallery__stage
  ) {
    min-height:
      380px !important;
  }

  .st-purchase-v6__selection {
    align-items:
      flex-start;

    flex-direction:
      column;

    gap:
      10px;
  }

  .st-purchase-v6__selection-price {
    text-align:
      left;
  }

  .st-purchase-v6__primary-actions {
    grid-template-columns:
      1fr;
  }

  .st-product-v5__buy-heading {
    gap:
      10px !important;
  }

}

/* ========================================================================
   STEREOPHONIE V3 — FINAL RETAIL POLISH 2026-08-19
   This block intentionally lives at the END of the stylesheet.
   ======================================================================== */

:root {
  --st-mustard: #f5b335;
  --st-mustard-dark: #a86b00;
  --st-ink: #1d1d1f;
  --st-muted: #86868b;
  --st-surface: #f5f5f7;
  --st-line: rgba(29, 29, 31, .10);
}


/* ------------------------------------------------------------------------
   Text selection
   ------------------------------------------------------------------------ */

::selection {
  background: var(--st-mustard);
  color: #111;
}

::-moz-selection {
  background: var(--st-mustard);
  color: #111;
}


/* ------------------------------------------------------------------------
   Public storefront availability
   NO green status indicators.
   ------------------------------------------------------------------------ */

.st3-shop-page .is-ready,
.st3-shop-page .is-available,
.st-retail-shop .is-ready,
.st-retail-shop .is-available,
.st-retail-card__footer > span.is-available,
.st-retail-qv__availability.is-available,
.st3-product-page .is-ready,
.st3-product-page .is-available,
.st-product-v3 .is-ready,
.st-product-v3 .is-available,
.st-product-v4 .is-ready,
.st-product-v4 .is-available,
.st-product-v5 .is-ready,
.st-product-v5 .is-available,
.st-purchase-v3__status.is-ready,
.st-purchase-v4__status.is-ready,
.st-purchase-v5__status.is-ready {
  color: var(--st-ink) !important;
}

.st3-shop-page .is-ready i,
.st3-shop-page .is-available i,
.st-retail-shop .is-ready i,
.st-retail-shop .is-available i,
.st-retail-card__footer > span.is-available::before,
.st-retail-qv__availability.is-available i,
.st3-product-page .is-ready i,
.st3-product-page .is-available i,
.st-product-v3 .is-ready i,
.st-product-v3 .is-available i,
.st-product-v4 .is-ready i,
.st-product-v4 .is-available i,
.st-product-v5 .is-ready i,
.st-product-v5 .is-available i,
.st-purchase-v3__status.is-ready > i,
.st-purchase-v4__status.is-ready > i,
.st-purchase-v5__status.is-ready > i {
  background: var(--st-mustard) !important;
  border-color: var(--st-mustard) !important;
  color: var(--st-mustard) !important;
}


/* ------------------------------------------------------------------------
   PRODUCT PAGE — clean retail rhythm
   ------------------------------------------------------------------------ */

.st-product-v5,
.st-product-v4,
.st-product-v3 {
  background: #fff !important;
  color: var(--st-ink);
}

.st-product-v5__shell,
.st-product-v4__shell,
.st-product-v3__shell {
  width: min(calc(100% - 48px), 1180px) !important;
  margin-inline: auto !important;
}


/* ------------------------------------------------------------------------
   PURCHASE MODULE
   ------------------------------------------------------------------------ */

/*
   Neutralise leftover arcade/panel decoration.
*/
.st-product-v5 [class*="purchase"],
.st-product-v4 [class*="purchase"],
.st-product-v3 [class*="purchase"] {
  box-shadow: none;
}


/*
   Quantity control:
   compact, visually equal to the main action buttons.
*/
.st-purchase-v3__quantity,
.st-purchase-v4__quantity,
.st-purchase-v5__quantity {
  min-width: 0 !important;
  margin: 0 !important;
}

.st-purchase-v3__quantity > span:not(:first-child),
.st-purchase-v4__quantity > span:not(:first-child),
.st-purchase-v5__quantity > span:not(:first-child) {
  display: none !important;
}

.st-purchase-v3__stepper,
.st-purchase-v4__stepper,
.st-purchase-v5__stepper {
  height: 48px !important;
  min-height: 48px !important;
  width: 100% !important;
  min-width: 0 !important;

  display: grid !important;
  grid-template-columns: 42px minmax(42px, 1fr) 42px !important;
  align-items: center !important;

  border: 1px solid var(--st-line) !important;
  border-radius: 999px !important;

  background: #fff !important;

  overflow: hidden !important;
}

.st-purchase-v3__stepper button,
.st-purchase-v4__stepper button,
.st-purchase-v5__stepper button,
.st-purchase-v3__stepper strong,
.st-purchase-v4__stepper strong,
.st-purchase-v5__stepper strong {
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  margin: 0 !important;
  padding: 0 !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  box-shadow: none !important;
}

.st-purchase-v3__stepper strong,
.st-purchase-v4__stepper strong,
.st-purchase-v5__stepper strong {
  font-size: 15px !important;
  font-weight: 600 !important;
  line-height: 1 !important;
}


/*
   Ensure no stock ceiling text is exposed.
*/
.st-purchase-v3__quantity [class*="max"],
.st-purchase-v4__quantity [class*="max"],
.st-purchase-v5__quantity [class*="max"],
.st-purchase-v3 [data-max-quantity],
.st-purchase-v4 [data-max-quantity],
.st-purchase-v5 [data-max-quantity] {
  display: none !important;
}


/*
   Main purchase row.

   Desktop:
   [ quantity ] [ Add to bag ] [ Buy now ]

   All three controls share the same 48px height and baseline.
*/
.st-purchase-v3__actions,
.st-purchase-v4__actions,
.st-purchase-v5__actions {
  display: grid !important;
  grid-template-columns:
    minmax(128px, .42fr)
    minmax(220px, 1fr)
    minmax(220px, 1fr) !important;

  align-items: end !important;
  gap: 10px !important;

  width: 100% !important;
}


/*
   In case the current JSX keeps the quantity immediately before
   the actions container, make their visual rhythm identical.
*/
.st-purchase-v3__quantity,
.st-purchase-v4__quantity,
.st-purchase-v5__quantity,
.st-purchase-v3__cart,
.st-purchase-v4__cart,
.st-purchase-v5__cart,
.st-purchase-v3__buy,
.st-purchase-v4__buy,
.st-purchase-v5__buy {
  min-height: 48px !important;
}


/*
   Main CTAs.
*/
.st-purchase-v3__cart,
.st-purchase-v4__cart,
.st-purchase-v5__cart,
.st-purchase-v3__buy,
.st-purchase-v4__buy,
.st-purchase-v5__buy {
  height: 48px !important;

  border-radius: 999px !important;

  font-size: 13px !important;
  font-weight: 600 !important;
  letter-spacing: 0 !important;
  text-transform: none !important;

  box-shadow: none !important;
}

.st-purchase-v3__cart,
.st-purchase-v4__cart,
.st-purchase-v5__cart {
  background: var(--st-mustard) !important;
  color: #111 !important;
}

.st-purchase-v3__buy,
.st-purchase-v4__buy,
.st-purchase-v5__buy {
  background: var(--st-ink) !important;
  color: #fff !important;
}


/*
   Save button: quieter than the primary purchase CTAs.
*/
.st-purchase-v3__wishlist,
.st-purchase-v4__wishlist,
.st-purchase-v5__wishlist {
  width: 100% !important;
  min-height: 46px !important;

  margin-top: 10px !important;

  border: 1px solid var(--st-line) !important;
  border-radius: 999px !important;

  background: #fff !important;
  color: var(--st-ink) !important;

  box-shadow: none !important;

  font-size: 13px !important;
  font-weight: 550 !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

.st-purchase-v3__wishlist.is-active,
.st-purchase-v4__wishlist.is-active,
.st-purchase-v5__wishlist.is-active {
  border-color: rgba(245, 179, 53, .65) !important;
  background: rgba(245, 179, 53, .09) !important;
  color: var(--st-ink) !important;
}


/* ------------------------------------------------------------------------
   Bookmark icon styling — header + store
   ------------------------------------------------------------------------ */

.st3-header a[href="/wishlist"] svg,
.st-v3-header a[href="/wishlist"] svg,
header a[href="/wishlist"] svg {
  fill: none !important;
  stroke: currentColor !important;
}

.st-retail-card__wishlist svg,
.st-retail-qv__save svg,
.st-purchase-v3__wishlist svg,
.st-purchase-v4__wishlist svg,
.st-purchase-v5__wishlist svg {
  fill: none;
  stroke: currentColor;
}


/* ------------------------------------------------------------------------
   Responsive purchase alignment
   ------------------------------------------------------------------------ */

@media (max-width: 820px) {
  .st-purchase-v3__actions,
  .st-purchase-v4__actions,
  .st-purchase-v5__actions {
    grid-template-columns: 1fr 1fr !important;
  }

  .st-purchase-v3__quantity,
  .st-purchase-v4__quantity,
  .st-purchase-v5__quantity {
    grid-column: 1 / -1;
    max-width: 150px !important;
  }
}

@media (max-width: 560px) {
  .st-product-v5__shell,
  .st-product-v4__shell,
  .st-product-v3__shell {
    width: min(calc(100% - 28px), 1180px) !important;
  }

  .st-purchase-v3__actions,
  .st-purchase-v4__actions,
  .st-purchase-v5__actions {
    grid-template-columns: 1fr !important;
    gap: 9px !important;
  }

  .st-purchase-v3__quantity,
  .st-purchase-v4__quantity,
  .st-purchase-v5__quantity {
    grid-column: auto;
    max-width: 145px !important;
  }
}

/* ========================================================================
   STEREOPHONIE V3 — MUSTARD UI POLISH — 2026-08-19
   Final public storefront override.
   ======================================================================== */

/* ========================================================================
   STEREOPHONIE V3 — MUSTARD UI POLISH — 2026-08-19
   Final public storefront override.
   ======================================================================== */

:root {
  --st-mustard: #fdb73e;
  --st-mustard-soft: rgba(253, 183, 62, .14);
  --st-mustard-glow: rgba(253, 183, 62, .34);
  --st-ink: #1d1d1f;
}


/* ------------------------------------------------------------------------
   A. NO GREEN AVAILABILITY LANGUAGE
   ------------------------------------------------------------------------ */

/*
 * SHOP PRODUCT CARDS
 */
.st-retail-card__footer > span.is-available,
.st-retail-card__availability.is-available,
.st-retail-qv__availability.is-available,
.st-retail-qv__availability.is-available strong,
.st-retail-qv__availability.is-available span {
  color: #a86600 !important;
}

.st-retail-card__footer > span.is-available::before,
.st-retail-card__availability.is-available::before,
.st-retail-card__availability.is-available i,
.st-retail-qv__availability.is-available::before,
.st-retail-qv__availability.is-available i {
  background: var(--st-mustard) !important;
  border-color: var(--st-mustard) !important;
  box-shadow: 0 0 0 4px var(--st-mustard-soft) !important;
}


/*
 * PRODUCT PAGE
 */
.st-product-v3__availability.is-available,
.st-product-v4__availability.is-available,
.st-product-v5__availability.is-available,
.st-purchase-v3__status.is-ready,
.st-purchase-v3__status.is-ready strong,
.st-purchase-v3__status.is-ready span,
.st3-product-page .is-ready {
  color: #a86600 !important;
}

.st-product-v3__availability.is-available i,
.st-product-v4__availability.is-available i,
.st-product-v5__availability.is-available i,
.st-purchase-v3__status.is-ready > i,
.st3-product-page .is-ready > i {
  background: var(--st-mustard) !important;
  border-color: var(--st-mustard) !important;
  box-shadow: 0 0 0 4px var(--st-mustard-soft) !important;
}


/*
 * FILTER / IN-STOCK PILL
 */
.st-retail-shop button.is-active [class*="stock"],
.st-retail-shop [class*="stock"].is-active,
.st-retail-shop [class*="availability"].is-active {
  color: var(--st-ink) !important;
}

.st-retail-shop button.is-active [class*="stock"]::before,
.st-retail-shop [class*="stock"].is-active::before,
.st-retail-shop [class*="availability"].is-active::before {
  background: var(--st-mustard) !important;
}


/* Broad final safeguard:
   public availability dots inside the V3 storefront may never be green.
 */
.st-retail-shop .is-available i,
.st-retail-shop .is-ready i,
.st3-product-page .is-available i,
.st3-product-page .is-ready i,
.st-product-v5 .is-available i,
.st-product-v5 .is-ready i {
  background: var(--st-mustard) !important;
}


/* ------------------------------------------------------------------------
   B. NEW BADGE — PREMIUM BREATHING MUSTARD GLOW
   ------------------------------------------------------------------------ */

.st-retail-card__badge--new,
.st-retail-card__badges > span:first-child {
  position: relative !important;
  isolation: isolate;
  overflow: visible !important;

  border: 1px solid rgba(253, 183, 62, .28) !important;
  background: rgba(255, 255, 255, .96) !important;
  color: var(--st-ink) !important;

  box-shadow:
    0 5px 18px rgba(0, 0, 0, .045),
    0 0 0 0 rgba(253, 183, 62, 0) !important;

  animation:
    st-new-badge-breathe
    2.8s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}

.st-retail-card__badge--new::after,
.st-retail-card__badges > span:first-child::after {
  content: "";
  position: absolute;
  z-index: -1;

  inset: -7px;

  border-radius: inherit;

  background:
    radial-gradient(
      circle at center,
      rgba(253, 183, 62, .28) 0%,
      rgba(253, 183, 62, .11) 42%,
      rgba(253, 183, 62, 0) 72%
    );

  opacity: .36;
  transform: scale(.94);
  pointer-events: none;

  animation:
    st-new-badge-aura
    2.8s
    cubic-bezier(.4, 0, .2, 1)
    infinite;
}

@keyframes st-new-badge-breathe {
  0%,
  100% {
    box-shadow:
      0 5px 18px rgba(0, 0, 0, .045),
      0 0 0 0 rgba(253, 183, 62, 0);
  }

  50% {
    box-shadow:
      0 6px 20px rgba(0, 0, 0, .05),
      0 0 0 7px rgba(253, 183, 62, .105);
  }
}

@keyframes st-new-badge-aura {
  0%,
  100% {
    opacity: .22;
    transform: scale(.92);
  }

  50% {
    opacity: .72;
    transform: scale(1.06);
  }
}


/*
 * Respect accessibility settings.
 */
@media (prefers-reduced-motion: reduce) {
  .st-retail-card__badge--new,
  .st-retail-card__badges > span:first-child,
  .st-retail-card__badge--new::after,
  .st-retail-card__badges > span:first-child::after {
    animation: none !important;
  }
}


/* ------------------------------------------------------------------------
   C. CART SUCCESS NOTIFICATION — MUSTARD, NEVER GREEN
   ------------------------------------------------------------------------ */

/*
 * Covers the current cart feedback architectures and protects against
 * archived success rules appearing later in component styles.
 */
:is(
  .st-cart-toast,
  .st-cart-message,
  .st-cart-notification,
  .st-cart-drawer__message,
  .st-cart-drawer__notice,
  .st-cart-success,
  .cart-toast,
  .cart-notification
).is-success,
:is(
  .st-cart-toast,
  .st-cart-message,
  .st-cart-notification,
  .st-cart-drawer__message,
  .st-cart-drawer__notice,
  .st-cart-success,
  .cart-toast,
  .cart-notification
)[data-type="success"],
[data-cart-toast][data-type="success"],
[data-cart-toast].is-success {
  border-color: rgba(253, 183, 62, .42) !important;
  background: #fff8e9 !important;
  color: var(--st-ink) !important;

  box-shadow:
    0 14px 38px rgba(0, 0, 0, .10),
    0 0 0 1px rgba(253, 183, 62, .08) !important;
}

:is(
  .st-cart-toast,
  .st-cart-message,
  .st-cart-notification,
  .st-cart-drawer__message,
  .st-cart-drawer__notice,
  .st-cart-success,
  .cart-toast,
  .cart-notification
).is-success svg,
:is(
  .st-cart-toast,
  .st-cart-message,
  .st-cart-notification,
  .st-cart-drawer__message,
  .st-cart-drawer__notice,
  .st-cart-success,
  .cart-toast,
  .cart-notification
)[data-type="success"] svg,
[data-cart-toast].is-success svg,
[data-cart-toast][data-type="success"] svg {
  color: #b77908 !important;
  stroke: currentColor !important;
}

:is(
  .st-cart-toast,
  .st-cart-message,
  .st-cart-notification,
  .st-cart-drawer__message,
  .st-cart-drawer__notice,
  .st-cart-success,
  .cart-toast,
  .cart-notification
).is-success i,
[data-cart-toast].is-success i {
  background: var(--st-mustard) !important;
}


/*
 * Generic success feedback used inside storefront purchase/cart surfaces.
 */
.st3-product-page .is-success,
.st-retail-shop .is-success {
  --success-color: #b77908 !important;
}

.st3-product-page .is-success svg,
.st-retail-shop .is-success svg {
  color: #b77908 !important;
}


/* ------------------------------------------------------------------------
   D. HEADER BOOKMARK — SAME OPTICAL LANGUAGE AS SEARCH / ACCOUNT / BAG
   ------------------------------------------------------------------------ */

.st3-header a[href="/wishlist"],
.st3-header button[aria-label*="wishlist" i],
.st3-header button[aria-label*="saved" i],
.st3-header button[aria-label*="save" i],
.st-v3-header a[href="/wishlist"],
.st-v3-header button[aria-label*="wishlist" i] {
  line-height: 0 !important;
}


/*
 * The bookmark now uses exactly the same optical box as nearby header icons.
 * We do NOT give it its own circle, background, or border.
 */
.st3-header a[href="/wishlist"] svg,
.st3-header button[aria-label*="wishlist" i] svg,
.st3-header button[aria-label*="saved" i] svg,
.st3-header button[aria-label*="save" i] svg,
.st-v3-header a[href="/wishlist"] svg,
.st-v3-header button[aria-label*="wishlist" i] svg {
  width: 20px !important;
  height: 20px !important;

  display: block !important;

  fill: none !important;
  stroke: currentColor !important;
  stroke-width: 1.75 !important;

  transform: none !important;
}


/*
 * Ensure a saved state still looks refined rather than becoming a large
 * filled shape in the navigation.
 */
.st3-header a[href="/wishlist"].is-active svg,
.st-v3-header a[href="/wishlist"].is-active svg {
  fill: rgba(253, 183, 62, .18) !important;
  stroke: #a86600 !important;
}


/* ------------------------------------------------------------------------
   E. MUSTARD TEXT SELECTION — KEEP FINAL
   ------------------------------------------------------------------------ */

::selection {
  background: var(--st-mustard) !important;
  color: #111 !important;
}

::-moz-selection {
  background: var(--st-mustard) !important;
  color: #111 !important;
}


/* ========================================================================
   HEADER BOOKMARK OPTICAL NORMALIZATION — 2026-08-19
   ======================================================================== */

/*
 * Wishlist/save uses the same visual language as search, account and bag.
 * No bubble, no filled background, no independent sizing.
 */
:is(
  .st3-header,
  .st-v3-header,
  header
) a[href="/wishlist"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  color: #1d1d1f !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;

  line-height: 0 !important;
}

:is(
  .st3-header,
  .st-v3-header,
  header
) a[href="/wishlist"] svg {
  width: 20px !important;
  height: 20px !important;

  display: block !important;

  fill: none !important;
  stroke: currentColor !important;
  stroke-width: 1.8 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;

  transform: none !important;
  filter: none !important;
}

/*
 * Do not make the navigation icon visually heavier when the wishlist
 * contains products. The header stays clean and consistent.
 */
:is(
  .st3-header,
  .st-v3-header,
  header
) a[href="/wishlist"].is-active svg {
  fill: none !important;
  stroke: currentColor !important;
}



/* ========================================================================
   FINAL HEADER SAVE ICON — HARD OVERRIDE
   ======================================================================== */

/*
 * This icon deliberately has its own data attribute so old Heart,
 * Bookmark, wishlist and archived-header CSS cannot change its geometry.
 */

a[href="/wishlist"] [data-st-header-save],
button [data-st-header-save] {
  width: 22px !important;
  height: 22px !important;

  min-width: 22px !important;
  min-height: 22px !important;

  display: block !important;

  overflow: visible !important;

  color: currentColor !important;

  fill: none !important;

  stroke: currentColor !important;
  stroke-width: 1.55 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;

  opacity: 1 !important;

  transform: none !important;
  scale: 1 !important;

  filter: none !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

a[href="/wishlist"] [data-st-header-save] path,
button [data-st-header-save] path {
  fill: none !important;

  stroke: currentColor !important;
  stroke-width: 1.55 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;

  vector-effect: non-scaling-stroke;
}


/*
 * Header wishlist link itself must behave like the Search,
 * Account and Bag icon controls — not like a special pill/button.
 */
header a[href="/wishlist"],
.st3-header a[href="/wishlist"],
.st-v3-header a[href="/wishlist"],
.st-v2-header a[href="/wishlist"] {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 0 !important;
  margin: 0 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;

  color: #1d1d1f !important;

  box-shadow: none !important;

  transform: none !important;
}


/*
 * Saving products must NOT turn the navigation icon into
 * a heavy filled bookmark.
 */
header a[href="/wishlist"].is-active [data-st-header-save],
header a[href="/wishlist"][aria-current="page"] [data-st-header-save],
.st3-header a[href="/wishlist"].is-active [data-st-header-save] {
  fill: none !important;
}

header a[href="/wishlist"].is-active [data-st-header-save] path,
header a[href="/wishlist"][aria-current="page"] [data-st-header-save] path,
.st3-header a[href="/wishlist"].is-active [data-st-header-save] path {
  fill: none !important;
  stroke: currentColor !important;
}


/*
 * Optical hover stays subtle, same family as neighboring navigation icons.
 */
@media (hover: hover) {
  header a[href="/wishlist"]:hover,
  .st3-header a[href="/wishlist"]:hover,
  .st-v3-header a[href="/wishlist"]:hover {
    color: #000 !important;
    opacity: .68 !important;
  }
}



/* ========================================================================
   STEREOPHONIE — HEADER ICON SYSTEM FINAL
   2026-08-19
   Search / Wishlist / Account / Bag share one exact icon system.
   ======================================================================== */

.st3-header__actions {
  display: flex !important;
  align-items: center !important;
  gap: 4px !important;
}

.st3-header__actions .st3-header__icon {
  width: 36px !important;
  height: 36px !important;

  padding: 0 !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  border: 0 !important;
  border-radius: 50% !important;

  background: transparent !important;

  color: #1d1d1f !important;

  line-height: 0 !important;
}

/*
 * ONE SVG specification for all four icons.
 *
 * Search
 * Wishlist
 * Account
 * Bag
 */
.st3-header__actions .st3-header__icon > svg {
  display: block !important;

  width: 20px !important;
  height: 20px !important;

  flex: 0 0 20px !important;

  overflow: visible !important;

  fill: none !important;

  stroke: currentColor !important;
  stroke-width: 1.7 !important;

  stroke-linecap: round !important;
  stroke-linejoin: round !important;

  vector-effect: non-scaling-stroke;
}

/*
 * The wishlist icon is now a completely new SVG.
 * Prevent any archived wishlist/fill styling from changing it.
 */
.st3-header__actions
a[href="/wishlist"]
svg,
.st3-header__actions
a[href="/wishlist"]
svg * {
  fill: none !important;
  stroke: currentColor !important;
}

.st3-header__actions
a[href="/wishlist"] {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

/*
 * Keep the interactions understated.
 * No special animation is applied to the wishlist.
 */
@media (hover: hover) {
  .st3-header__actions
  .st3-header__icon:hover {
    background: rgba(0, 0, 0, 0.045) !important;
  }
}


/* ========================================================================
   SHOP — IN STOCK FILTER DOT FINAL
   ======================================================================== */

/*
 * Default/off state:
 * mustard dot on white pill.
 */
button[data-stock-filter="true"] {
  --st-stock-dot: #f6b536;
}

/*
 * Selected state:
 * black pill, green dot as requested.
 */
button[data-stock-filter="true"][data-stock-active="true"] {
  --st-stock-dot: #2ccf66;
}

/*
 * Cover the actual dot regardless of whether the existing component uses
 * i, a dot/led/status class, or the older filter indicator class.
 */
button[data-stock-filter="true"] i,
button[data-stock-filter="true"] [class*="dot"],
button[data-stock-filter="true"] [class*="led"],
button[data-stock-filter="true"] [class*="status"]::before {
  background: var(--st-stock-dot) !important;
  border-color: var(--st-stock-dot) !important;
}

/*
 * If the filter's indicator is generated using ::before,
 * this keeps that indicator synchronized too.
 */
button[data-stock-filter="true"]::before {
  border-color: var(--st-stock-dot) !important;
}


/* ========================================================================
   STOREFRONT AVAILABILITY
   Product availability itself remains mustard, never green.
   ======================================================================== */

.st-retail-card__footer > span.is-available,
.st-retail-qv__availability.is-available,
.st-product-v3__availability.is-available,
.st-product-v5__availability.is-available,
.st3-product-page .is-ready {
  color: #a86b00 !important;
}

.st-retail-qv__availability.is-available i,
.st-product-v3__availability.is-available i,
.st-product-v5__availability.is-available i,
.st3-product-page .is-ready i {
  background: #f6b536 !important;
}


/* Mustard text selection throughout storefront */
::selection {
  background: #f6b536 !important;
  color: #111 !important;
}

::-moz-selection {
  background: #f6b536 !important;
  color: #111 !important;
}

/* === EXACT HEADER + STOCK FILTER FIX 2026-08-19 === */

/*
 * HEADER ICON SYSTEM
 * Search / Wishlist / Account / Bag deliberately share
 * exactly the same canvas, stroke weight and charcoal tone.
 */

.st3-header__actions .st3-header__icon {
  color: #353538 !important;
}

.st3-header__actions .st3-header__icon > svg {
  display: block !important;

  width: 20px !important;
  height: 20px !important;

  min-width: 20px !important;
  min-height: 20px !important;

  max-width: 20px !important;
  max-height: 20px !important;

  overflow: visible !important;

  color: inherit !important;

  fill: none !important;
  stroke: currentColor !important;

  stroke-width: 1.55 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;

  opacity: .92 !important;

  transform: none !important;
}


/*
 * The wishlist is intentionally not allowed to inherit any
 * historical filled-bookmark styling.
 */

.st3-header__actions
.st3-header__icon
svg[data-st3-wishlist-icon] {
  fill: none !important;
  stroke: currentColor !important;

  opacity: .92 !important;
}

.st3-header__actions
.st3-header__icon
svg[data-st3-wishlist-icon] path {
  fill: none !important;
  stroke: currentColor !important;

  stroke-width: 1.55 !important;
  stroke-linecap: round !important;
  stroke-linejoin: round !important;
}


/*
 * Keep hover restrained and consistent with the minimalist header.
 */

@media (hover: hover) {
  .st3-header__actions .st3-header__icon:hover {
    color: #111113 !important;
  }
}


/*
 * ========================================================
 * REAL V4 IN-STOCK FILTER
 * ========================================================
 *
 * Confirmed JSX:
 *   .st-filter-v4__pill
 *   .st-filter-v4__stock-dot
 *
 * Both OFF and ON states use mustard.
 * The selected pill itself remains black.
 */

.st-filter-v4__pill
.st-filter-v4__stock-dot {
  width: 6px !important;
  height: 6px !important;

  flex: 0 0 6px !important;

  border: 0 !important;
  border-radius: 999px !important;

  background: #f5b335 !important;

  box-shadow:
    0 0 0 3px rgba(245, 179, 53, .11) !important;

  opacity: 1 !important;
}


/* Inactive */

.st-filter-v4__pill:not(.is-active) {
  background: #fff !important;
  color: #1d1d1f !important;
}

.st-filter-v4__pill:not(.is-active)
.st-filter-v4__stock-dot {
  background: #f5b335 !important;

  box-shadow:
    0 0 0 3px rgba(245, 179, 53, .10) !important;
}


/* Active */

.st-filter-v4__pill.is-active {
  background: #1d1d1f !important;
  border-color: #1d1d1f !important;
  color: #fff !important;
}

.st-filter-v4__pill.is-active
.st-filter-v4__stock-dot {
  background: #f5b335 !important;

  box-shadow:
    0 0 0 3px rgba(245, 179, 53, .16) !important;
}


/*
 * Kill any historical green rule with equal or lower specificity.
 */

.st-retail-shop
.st-filter-v4__pill
.st-filter-v4__stock-dot,

.st3-shop-page
.st-filter-v4__pill
.st-filter-v4__stock-dot,

body
.st-filter-v4__pill
.st-filter-v4__stock-dot {
  background: #f5b335 !important;
}


/*
 * No animations required for this control.
 * Keeps filtering crisp and avoids the laggy arcade feel.
 */

.st-filter-v4__pill,
.st-filter-v4__pill *,
.st-filter-v4__stock-dot {
  transition:
    background-color 120ms ease,
    border-color 120ms ease,
    color 120ms ease !important;
}

/* === STEREOPHONIE MICROINTERACTION POLISH 2026-08-19 === */

/* =========================================================
   1. HEADER — ROUND WISHLIST HOVER
   ========================================================= */

/*
 * The active desktop wishlist link is known to be:
 *
 *   .st3-header__actions
 *   a[href="/wishlist"]
 *
 * We explicitly neutralize any historical square hover rule.
 */

.st3-header__actions
a.st3-header__icon[href="/wishlist"] {
  position: relative !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;

  border-radius: 999px !important;

  background: transparent !important;

  overflow: hidden !important;

  isolation: isolate !important;
}


/*
 * Keep exactly the same circular interaction canvas
 * used by the other utility icons.
 */

.st3-header__actions
a.st3-header__icon[href="/wishlist"]::before {
  content: "" !important;

  position: absolute !important;
  inset: 0 !important;

  border-radius: inherit !important;

  background: transparent !important;

  pointer-events: none !important;

  z-index: -1 !important;
}


@media (hover: hover) {

  .st3-header__actions
  a.st3-header__icon[href="/wishlist"]:hover {
    border-radius: 999px !important;

    background:
      rgba(29, 29, 31, .055) !important;
  }

  .st3-header__actions
  a.st3-header__icon[href="/wishlist"]:hover::before {
    background:
      rgba(29, 29, 31, .055) !important;
  }

}


/*
 * Keyboard accessibility gets the same visual language.
 */

.st3-header__actions
a.st3-header__icon[href="/wishlist"]:focus-visible {
  border-radius: 999px !important;

  outline:
    2px solid
    rgba(245, 179, 53, .7) !important;

  outline-offset:
    2px !important;

  background:
    rgba(29, 29, 31, .055) !important;
}


/* =========================================================
   2. NEW PRODUCT BADGE — MUSTARD BREATHING HALO
   ========================================================= */

/*
 * Retail cards currently place status labels inside:
 *
 *   .st-retail-card__badges
 *
 * A subtle halo is applied to the product badge itself.
 */

.st-retail-card__badges > * {
  position: relative !important;

  isolation: isolate !important;
}


/*
 * Warm mustard halo behind the badge.
 */

.st-retail-card__badges > *::before {
  content: "" !important;

  position: absolute !important;

  inset: -7px !important;

  border-radius: 999px !important;

  background:
    rgba(245, 179, 53, .13) !important;

  filter:
    blur(7px) !important;

  opacity:
    .34 !important;

  transform:
    scale(.92) !important;

  pointer-events:
    none !important;

  z-index:
    -1 !important;

  animation:
    st-v3-new-badge-breathe
    2.8s
    ease-in-out
    infinite !important;
}


.st-retail-card__badges > * {
  box-shadow:
    0 6px 20px
    rgba(245, 179, 53, .055) !important;

  animation:
    st-v3-new-badge-soft-shadow
    2.8s
    ease-in-out
    infinite !important;
}


@keyframes st-v3-new-badge-breathe {

  0%,
  100% {
    opacity: .22;

    transform:
      scale(.91);
  }

  50% {
    opacity: .72;

    transform:
      scale(1.11);
  }

}


@keyframes st-v3-new-badge-soft-shadow {

  0%,
  100% {
    box-shadow:
      0 5px 17px
      rgba(245, 179, 53, .045);
  }

  50% {
    box-shadow:
      0 7px 25px
      rgba(245, 179, 53, .18);
  }

}


/* =========================================================
   3. AI ASSISTANT — BREATHING MUSTARD HALO
   ========================================================= */

/*
 * These selectors deliberately target launcher-style
 * assistant controls only.
 *
 * They cover the V3 assistant namespace while avoiding
 * content inside an opened assistant conversation.
 */

:is(
  [class*="st3"][class*="assistant"][class*="launcher"],
  [class*="st3"][class*="assistant"][class*="trigger"],
  [class*="st3"][class*="assistant"][class*="button"],
  [class*="v3"][class*="assistant"][class*="launcher"],
  [class*="v3"][class*="assistant"][class*="trigger"],
  [class*="assistant"][class*="floating"]
) {
  position: fixed;

  isolation: isolate;

  animation:
    st-v3-assistant-float
    3.8s
    ease-in-out
    infinite !important;
}


/*
 * Breathing outer halo.
 */

:is(
  [class*="st3"][class*="assistant"][class*="launcher"],
  [class*="st3"][class*="assistant"][class*="trigger"],
  [class*="st3"][class*="assistant"][class*="button"],
  [class*="v3"][class*="assistant"][class*="launcher"],
  [class*="v3"][class*="assistant"][class*="trigger"],
  [class*="assistant"][class*="floating"]
)::before {
  content: "";

  position: absolute;

  inset: -18px;

  border-radius: 999px;

  background:
    radial-gradient(
      circle,
      rgba(245, 179, 53, .24) 0%,
      rgba(245, 179, 53, .13) 36%,
      rgba(245, 179, 53, .05) 58%,
      rgba(245, 179, 53, 0) 76%
    );

  filter:
    blur(5px);

  opacity:
    .42;

  transform:
    scale(.92);

  z-index:
    -1;

  pointer-events:
    none;

  animation:
    st-v3-assistant-breathe
    2.9s
    ease-in-out
    infinite !important;
}


/*
 * A second softer ring gives the launcher the layered
 * glow visible in the design without becoming neon.
 */

:is(
  [class*="st3"][class*="assistant"][class*="launcher"],
  [class*="st3"][class*="assistant"][class*="trigger"],
  [class*="st3"][class*="assistant"][class*="button"],
  [class*="v3"][class*="assistant"][class*="launcher"],
  [class*="v3"][class*="assistant"][class*="trigger"],
  [class*="assistant"][class*="floating"]
)::after {
  content: "";

  position: absolute;

  inset: -8px;

  border:
    1px solid
    rgba(245, 179, 53, .17);

  border-radius:
    999px;

  opacity:
    .44;

  transform:
    scale(.96);

  z-index:
    -1;

  pointer-events:
    none;

  animation:
    st-v3-assistant-ring
    2.9s
    ease-in-out
    infinite !important;
}


@keyframes st-v3-assistant-breathe {

  0%,
  100% {
    opacity:
      .28;

    transform:
      scale(.88);
  }

  50% {
    opacity:
      .8;

    transform:
      scale(1.14);
  }

}


@keyframes st-v3-assistant-ring {

  0%,
  100% {
    opacity:
      .26;

    transform:
      scale(.94);
  }

  50% {
    opacity:
      .68;

    transform:
      scale(1.09);
  }

}


/*
 * Very restrained vertical movement.
 *
 * Only ~4px total travel so it attracts the eye
 * without looking like a gaming UI.
 */

@keyframes st-v3-assistant-float {

  0%,
  100% {
    translate:
      0 0;
  }

  50% {
    translate:
      0 -4px;
  }

}


/* =========================================================
   4. REDUCED MOTION
   ========================================================= */

/*
 * Respect macOS / browser reduced-motion preference.
 */

@media (prefers-reduced-motion: reduce) {

  .st-retail-card__badges > *,
  .st-retail-card__badges > *::before,

  :is(
    [class*="st3"][class*="assistant"][class*="launcher"],
    [class*="st3"][class*="assistant"][class*="trigger"],
    [class*="st3"][class*="assistant"][class*="button"],
    [class*="v3"][class*="assistant"][class*="launcher"],
    [class*="v3"][class*="assistant"][class*="trigger"],
    [class*="assistant"][class*="floating"]
  ),

  :is(
    [class*="st3"][class*="assistant"][class*="launcher"],
    [class*="st3"][class*="assistant"][class*="trigger"],
    [class*="st3"][class*="assistant"][class*="button"],
    [class*="v3"][class*="assistant"][class*="launcher"],
    [class*="v3"][class*="assistant"][class*="trigger"],
    [class*="assistant"][class*="floating"]
  )::before,

  :is(
    [class*="st3"][class*="assistant"][class*="launcher"],
    [class*="st3"][class*="assistant"][class*="trigger"],
    [class*="st3"][class*="assistant"][class*="button"],
    [class*="v3"][class*="assistant"][class*="launcher"],
    [class*="v3"][class*="assistant"][class*="trigger"],
    [class*="assistant"][class*="floating"]
  )::after {
    animation:
      none !important;

    translate:
      none !important;

    transform:
      none !important;
  }

}


/* === ST V3 BREATHING MICROINTERACTIONS START === */

/*
 * Premium mustard micro-interactions.
 *
 * IMPORTANT:
 * - No route/page transition animation is introduced here.
 * - No loading-screen animation is introduced here.
 * - Only the NEW product badge and AI assistant launcher are animated.
 */

@property --st-glow-strength {
  syntax: "<number>";
  inherits: false;
  initial-value: 0;
}

@keyframes stMustardBadgeBreath {
  0%,
  100% {
    box-shadow:
      0 0 0 0 rgba(253, 183, 62, 0),
      0 4px 14px rgba(0, 0, 0, 0.025);
  }

  45% {
    box-shadow:
      0 0 0 7px rgba(253, 183, 62, 0.075),
      0 0 22px 6px rgba(253, 183, 62, 0.15),
      0 5px 16px rgba(0, 0, 0, 0.035);
  }

  58% {
    box-shadow:
      0 0 0 9px rgba(253, 183, 62, 0.045),
      0 0 30px 9px rgba(253, 183, 62, 0.105),
      0 5px 16px rgba(0, 0, 0, 0.035);
  }
}

@keyframes stAssistantMustardBreath {
  0%,
  100% {
    box-shadow:
      0 0 0 0 rgba(253, 183, 62, 0),
      0 8px 26px rgba(0, 0, 0, 0.08);
  }

  42% {
    box-shadow:
      0 0 0 11px rgba(253, 183, 62, 0.065),
      0 0 34px 12px rgba(253, 183, 62, 0.16),
      0 10px 30px rgba(0, 0, 0, 0.09);
  }

  60% {
    box-shadow:
      0 0 0 15px rgba(253, 183, 62, 0.03),
      0 0 44px 15px rgba(253, 183, 62, 0.095),
      0 10px 30px rgba(0, 0, 0, 0.085);
  }
}

@keyframes stAssistantGentleFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -6px, 0);
  }
}


/* -------------------------------------------------------
   NEW PRODUCT BADGE
   ------------------------------------------------------- */

/*
 * Covers the active retail-card badge naming already used by
 * the current V3 storefront, while also catching previous badge
 * namespaces if one survives elsewhere.
 */
:is(
  .st-retail-card__badges > span,
  .st-retail-card__badge,
  .st-v2-product__badge,
  .st-card17__badge
) {
  will-change: box-shadow;
}

/*
 * We only animate badges whose visible meaning is NEW/new-drop.
 * Current card implementation normally exposes New as the first
 * retail badge. These selectors deliberately avoid animating
 * unrelated pricing or availability pills.
 */
.st-retail-card__badges > span:first-child,
.st-retail-card [data-new-badge="true"],
.st-retail-card .is-new,
.st-retail-card .is-new-drop {
  border-color: rgba(253, 183, 62, 0.44) !important;
  background: rgba(255, 255, 255, 0.97) !important;

  animation:
    stMustardBadgeBreath 2.9s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  transform: translateZ(0);
}


/* -------------------------------------------------------
   AI ASSISTANT LAUNCHER
   ------------------------------------------------------- */

/*
 * Target several likely active V3 assistant launcher roots.
 * :is() keeps the rule harmless when a selector is absent.
 */
:is(
  .st3-assistant__launcher,
  .st3-assistant-launcher,
  .st3-shopping-assistant__launcher,
  .st3-shopping-assistant__trigger,
  .v3-shopping-assistant__launcher,
  .v3-shopping-assistant__trigger,
  [data-st3-assistant-launcher],
  [data-assistant-launcher]
) {
  will-change: transform, box-shadow;

  animation:
    stAssistantMustardBreath 3.15s
      cubic-bezier(.4, 0, .2, 1)
      infinite,
    stAssistantGentleFloat 3.9s
      ease-in-out
      infinite !important;

  transform: translate3d(0, 0, 0);
}


/*
 * If the assistant launcher has an outer visual ring separate
 * from the clickable button, make that ring participate in the
 * breathing effect without adding extra movement.
 */
:is(
  .st3-assistant__launcher-ring,
  .st3-shopping-assistant__ring,
  .v3-shopping-assistant__ring,
  [data-st3-assistant-ring]
) {
  animation:
    stAssistantMustardBreath 3.15s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


/* -------------------------------------------------------
   ACCESSIBILITY
   ------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .st-retail-card__badges > span:first-child,
  .st-retail-card [data-new-badge="true"],
  .st-retail-card .is-new,
  .st-retail-card .is-new-drop,
  :is(
    .st3-assistant__launcher,
    .st3-assistant-launcher,
    .st3-shopping-assistant__launcher,
    .st3-shopping-assistant__trigger,
    .v3-shopping-assistant__launcher,
    .v3-shopping-assistant__trigger,
    [data-st3-assistant-launcher],
    [data-assistant-launcher],
    .st3-assistant__launcher-ring,
    .st3-shopping-assistant__ring,
    .v3-shopping-assistant__ring,
    [data-st3-assistant-ring]
  ) {
    animation: none !important;
  }
}

/* === ST V3 BREATHING MICROINTERACTIONS END === */


/* =========================================================
   STEREOPHONIE V3 — EXACT BREATHING INTERACTIONS
   2026-08-19
   ========================================================= */

/*
 * Only these two UI elements animate:
 *
 * 1. Genuine NEW product badge.
 * 2. Genuine V3 AI launcher: .st3-ai-launcher
 *
 * No route transitions.
 * No page-entry transitions.
 * No loading animation.
 */


/* =========================================================
   NEW PRODUCT BADGE
   ========================================================= */

.st-retail-card
.st-retail-card__badges
> span.st-retail-card__badge--new {
  position: relative !important;
  z-index: 1 !important;
  isolation: isolate !important;

  border: 1px solid rgba(245, 179, 53, 0.48) !important;
  background: rgba(255, 255, 255, 0.98) !important;

  /*
   * Explicit final animation.
   *
   * The selector is intentionally more specific than the
   * older reduced-motion / legacy rules already in this file.
   */
  animation-disabled-old:
    stExactNewBadgeBreath 2.45s
    cubic-bezier(.45, 0, .2, 1)
    infinite !important;

  will-change:
    box-shadow,
    transform !important;
}


/*
 * Additional soft halo.
 * It expands and fades independently from the badge itself,
 * making the breathing clearly visible rather than static.
 */
.st-retail-card
.st-retail-card__badges
> span.st-retail-card__badge--new::after {
  content: "" !important;

  position: absolute !important;

  inset: -5px !important;

  border-radius: 999px !important;

  background:
    rgba(245, 179, 53, 0.13) !important;

  box-shadow:
    0 0 0 1px rgba(245, 179, 53, 0.08),
    0 0 22px rgba(245, 179, 53, 0.10) !important;

  opacity: 0 !important;

  transform:
    scale(.86) !important;

  z-index: -1 !important;

  pointer-events: none !important;

  animation:
    stExactNewBadgeAura 2.45s
    cubic-bezier(.45, 0, .2, 1)
    infinite !important;
}


@keyframes stExactNewBadgeBreath {
  0%,
  100% {
    transform: scale(1);

    box-shadow:
      0 5px 16px rgba(0, 0, 0, 0.035),
      0 0 0 0 rgba(245, 179, 53, 0);
  }

  45% {
    transform: scale(1.025);

    box-shadow:
      0 6px 18px rgba(0, 0, 0, 0.035),
      0 0 0 7px rgba(245, 179, 53, 0.10),
      0 0 24px rgba(245, 179, 53, 0.18);
  }

  58% {
    transform: scale(1.03);

    box-shadow:
      0 6px 19px rgba(0, 0, 0, 0.04),
      0 0 0 10px rgba(245, 179, 53, 0.055),
      0 0 34px rgba(245, 179, 53, 0.15);
  }
}


@keyframes stExactNewBadgeAura {
  0%,
  100% {
    opacity: 0;
    transform: scale(.84);
  }

  42% {
    opacity: .58;
    transform: scale(1.08);
  }

  60% {
    opacity: .22;
    transform: scale(1.22);
  }
}


/* =========================================================
   REAL AI ASSISTANT LAUNCHER
   Actual source:
   components/stereophonie-v3/assistant/
   v3-shopping-assistant.tsx
   className = st3-ai-launcher
   ========================================================= */

button.st3-ai-launcher {
  /*
   * `translate` is used instead of transform so existing
   * launcher transform/layout behavior remains untouched.
   */
  translate: 0 0 !important;

  will-change:
    translate,
    box-shadow !important;

  animation-disabled-old:
    stExactAssistantBreath 2.7s
      cubic-bezier(.42, 0, .22, 1)
      infinite,
    stExactAssistantFloat 3.9s
      ease-in-out
      infinite !important;
}


/*
 * When the assistant is open, stop the attention-seeking
 * vertical movement. The launcher can still retain a subtle
 * warm aura while being used.
 */
button.st3-ai-launcher.st3-ai-launcher--open {
  animation:
    stExactAssistantOpenBreath 3.4s
    ease-in-out
    infinite !important;

  translate: 0 0 !important;
}


@keyframes stExactAssistantBreath {
  0%,
  100% {
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.08),
      0 0 0 0 rgba(245, 179, 53, 0),
      0 0 0 rgba(245, 179, 53, 0);
  }

  42% {
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.09),
      0 0 0 11px rgba(245, 179, 53, 0.075),
      0 0 38px 12px rgba(245, 179, 53, 0.14);
  }

  58% {
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.09),
      0 0 0 17px rgba(245, 179, 53, 0.032),
      0 0 54px 18px rgba(245, 179, 53, 0.10);
  }
}


@keyframes stExactAssistantFloat {
  0%,
  100% {
    translate: 0 0;
  }

  50% {
    translate: 0 -6px;
  }
}


@keyframes stExactAssistantOpenBreath {
  0%,
  100% {
    box-shadow:
      0 8px 26px rgba(0, 0, 0, 0.08),
      0 0 0 0 rgba(245, 179, 53, 0);
  }

  50% {
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.08),
      0 0 0 7px rgba(245, 179, 53, 0.045);
  }
}


/* =========================================================
   FORCE EXACT ANIMATIONS ABOVE LEGACY REDUCED-MOTION RULES
   ========================================================= */

/*
 * Your existing stylesheet contains earlier rules that turn
 * badge animations off under prefers-reduced-motion.
 *
 * Because you explicitly requested these two attention cues,
 * these final selectors remain authoritative.
 */
@media (prefers-reduced-motion: reduce) {

  .st-retail-card
  .st-retail-card__badges
  > span.st-retail-card__badge--new {
    animation:
      stExactNewBadgeBreath 2.45s
      cubic-bezier(.45, 0, .2, 1)
      infinite !important;
  }

  .st-retail-card
  .st-retail-card__badges
  > span.st-retail-card__badge--new::after {
    animation:
      stExactNewBadgeAura 2.45s
      cubic-bezier(.45, 0, .2, 1)
      infinite !important;
  }

  button.st3-ai-launcher:not(.st3-ai-launcher--open) {
    animation:
      stExactAssistantBreath 2.7s
        cubic-bezier(.42, 0, .22, 1)
        infinite,
      stExactAssistantFloat 3.9s
        ease-in-out
        infinite !important;
  }

  button.st3-ai-launcher.st3-ai-launcher--open {
    animation:
      stExactAssistantOpenBreath 3.4s
      ease-in-out
      infinite !important;
  }
}

/* =========================================================
   END EXACT BREATHING INTERACTIONS
   ========================================================= */



/* === ST REAL PULSE START === */

/* =========================================================
   REAL AI LAUNCHER MOTION
   ========================================================= */

.st3-ai-launcher {
  position: fixed !important;
  overflow: visible !important;
  isolation: isolate !important;

  /*
   * The button itself only floats.
   * Glow is animated independently by physical child layers.
   */
  animation:
    stRealAssistantFloat 3.2s
    ease-in-out
    infinite !important;

  will-change: transform !important;
}


/*
 * Open assistant stays still so it does not distract while
 * the customer is interacting with the panel.
 */
.st3-ai-launcher.st3-ai-launcher--open {
  animation: none !important;
  transform: translate3d(0, 0, 0) !important;
}


/* Real physical glow layers */
.st3-ai-launcher__pulse {
  position: absolute !important;
  pointer-events: none !important;

  border-radius: 999px !important;

  left: -10px !important;
  right: -10px !important;
  top: -10px !important;
  bottom: -10px !important;

  z-index: -1 !important;

  opacity: 0 !important;

  transform: scale(.82) !important;

  background:
    rgba(245, 179, 53, .22) !important;

  filter:
    blur(10px) !important;

  will-change:
    transform,
    opacity,
    filter !important;
}


.st3-ai-launcher__pulse--outer {
  left: -22px !important;
  right: -22px !important;
  top: -22px !important;
  bottom: -22px !important;

  background:
    rgba(245, 179, 53, .16) !important;

  filter:
    blur(18px) !important;

  animation:
    stRealAssistantGlowOuter 2.5s
    cubic-bezier(.42, 0, .2, 1)
    infinite !important;
}


.st3-ai-launcher__pulse--inner {
  animation:
    stRealAssistantGlowInner 2.5s
    cubic-bezier(.42, 0, .2, 1)
    infinite !important;
}


/*
 * The actual vertical attention motion.
 */
@keyframes stRealAssistantFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -8px, 0);
  }
}


/*
 * Outer halo:
 * closed -> opens widely -> fades -> closes.
 */
@keyframes stRealAssistantGlowOuter {
  0% {
    opacity: 0;
    transform: scale(.72);
  }

  18% {
    opacity: .20;
  }

  45% {
    opacity: .72;
    transform: scale(1.08);
  }

  62% {
    opacity: .36;
    transform: scale(1.24);
  }

  82% {
    opacity: .10;
  }

  100% {
    opacity: 0;
    transform: scale(.72);
  }
}


/*
 * Inner glow follows the same breathing cycle but more tightly.
 */
@keyframes stRealAssistantGlowInner {
  0%,
  100% {
    opacity: .05;
    transform: scale(.88);
  }

  46% {
    opacity: .92;
    transform: scale(1.08);
  }

  64% {
    opacity: .40;
    transform: scale(1.16);
  }
}


/* =========================================================
   REAL NEW BADGE BREATHING
   ========================================================= */

.st-retail-card__badge--new {
  position: relative !important;
  overflow: visible !important;
  isolation: isolate !important;

  border:
    1px solid rgba(245, 179, 53, .52) !important;

  background:
    #ffffff !important;
}


.st-retail-card__badge--new > b {
  position: relative !important;
  z-index: 2 !important;

  font: inherit !important;
  font-weight: inherit !important;
}


.st-retail-card__new-pulse {
  position: absolute !important;

  inset: -7px !important;

  border-radius: 999px !important;

  pointer-events: none !important;

  z-index: -1 !important;

  opacity: 0;

  transform: scale(.74);

  background:
    rgba(245, 179, 53, .28);

  filter:
    blur(8px);

  animation:
    stRealNewBadgeGlow 2.35s
    cubic-bezier(.42, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity !important;
}


@keyframes stRealNewBadgeGlow {
  0% {
    opacity: 0;
    transform: scale(.72);
  }

  20% {
    opacity: .18;
  }

  46% {
    opacity: .90;
    transform: scale(1.10);
  }

  62% {
    opacity: .42;
    transform: scale(1.28);
  }

  84% {
    opacity: .08;
  }

  100% {
    opacity: 0;
    transform: scale(.72);
  }
}


/*
 * Small secondary glow on the badge body.
 */
.st-retail-card__badge--new {
  animation:
    stRealNewBadgeBody 2.35s
    ease-in-out
    infinite !important;
}


@keyframes stRealNewBadgeBody {
  0%,
  100% {
    box-shadow:
      0 4px 14px rgba(0,0,0,.03),
      0 0 0 rgba(245,179,53,0);
  }

  48% {
    box-shadow:
      0 5px 15px rgba(0,0,0,.035),
      0 0 19px rgba(245,179,53,.22);
  }
}


/* =========================================================
   IMPORTANT:
   keep these two intentional microanimations active even if
   old archived CSS contains reduced-motion overrides.
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .st3-ai-launcher:not(.st3-ai-launcher--open) {
    animation:
      stRealAssistantFloat 3.2s
      ease-in-out
      infinite !important;
  }

  .st3-ai-launcher__pulse--outer {
    animation:
      stRealAssistantGlowOuter 2.5s
      cubic-bezier(.42, 0, .2, 1)
      infinite !important;
  }

  .st3-ai-launcher__pulse--inner {
    animation:
      stRealAssistantGlowInner 2.5s
      cubic-bezier(.42, 0, .2, 1)
      infinite !important;
  }

  .st-retail-card__new-pulse {
    animation:
      stRealNewBadgeGlow 2.35s
      cubic-bezier(.42, 0, .2, 1)
      infinite !important;
  }

  .st-retail-card__badge--new {
    animation:
      stRealNewBadgeBody 2.35s
      ease-in-out
      infinite !important;
  }
}

/* === ST REAL PULSE END === */

/* =========================================================
   STEREOPHONIE — AI ASSISTANT
   MATCH NEW BADGE BREATHING GLOW
   ========================================================= */

/*
 * The NEW badge glow is the visual reference.
 * This gives the AI launcher the exact same breathing rhythm,
 * adapted only for the launcher's larger dimensions.
 */

.st3-ai-launcher {
  overflow: visible !important;
  isolation: isolate !important;

  /*
   * Only vertical movement belongs on the launcher itself.
   * Glow layers animate independently.
   */
  animation:
    stAIExactFloat 3.4s ease-in-out infinite !important;

  will-change: transform !important;
}


/* -----------------------------------------
   OUTER BREATHING LIGHT
   ----------------------------------------- */

.st3-ai-launcher__pulse--outer {
  position: absolute !important;

  inset: -12px !important;

  border-radius: inherit !important;

  pointer-events: none !important;

  z-index: -2 !important;

  background:
    rgba(245, 179, 53, .28) !important;

  filter:
    blur(8px) !important;

  opacity: 0;

  transform: scale(.72);

  animation:
    stAIExactBadgeBreath 2.35s
    cubic-bezier(.42, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity !important;
}


/* -----------------------------------------
   INNER WARM LIGHT
   ----------------------------------------- */

.st3-ai-launcher__pulse--inner {
  position: absolute !important;

  inset: -5px !important;

  border-radius: inherit !important;

  pointer-events: none !important;

  z-index: -1 !important;

  background:
    rgba(245, 179, 53, .20) !important;

  filter:
    blur(6px) !important;

  opacity: 0;

  transform: scale(.82);

  animation:
    stAIExactInnerBreath 2.35s
    cubic-bezier(.42, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity !important;
}


/* =========================================================
   SAME BREATHING CHARACTER AS NEW BADGE
   ========================================================= */

@keyframes stAIExactBadgeBreath {

  0% {
    opacity: 0;
    transform: scale(.72);
  }

  20% {
    opacity: .18;
  }

  46% {
    opacity: .90;
    transform: scale(1.10);
  }

  62% {
    opacity: .42;
    transform: scale(1.28);
  }

  84% {
    opacity: .08;
  }

  100% {
    opacity: 0;
    transform: scale(.72);
  }
}


@keyframes stAIExactInnerBreath {

  0% {
    opacity: .04;
    transform: scale(.84);
  }

  20% {
    opacity: .14;
  }

  46% {
    opacity: .62;
    transform: scale(1.04);
  }

  62% {
    opacity: .28;
    transform: scale(1.13);
  }

  84% {
    opacity: .06;
  }

  100% {
    opacity: .04;
    transform: scale(.84);
  }
}


/* =========================================================
   GENTLE ATTENTION FLOAT
   ========================================================= */

@keyframes stAIExactFloat {

  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -7px, 0);
  }
}


/*
 * When the assistant is OPEN:
 * stop the floating movement.
 *
 * The user is already interacting with it,
 * so it should become calm.
 */

.st3-ai-launcher.st3-ai-launcher--open {
  animation: none !important;
  transform: translate3d(0, 0, 0) !important;
}


/*
 * Keep the launcher content above both glow layers.
 */

.st3-ai-launcher__icon,
.st3-ai-launcher__label {
  position: relative !important;
  z-index: 2 !important;
}


