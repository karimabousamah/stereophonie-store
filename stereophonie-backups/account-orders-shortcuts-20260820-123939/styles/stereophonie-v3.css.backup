/* ========================================================================
   STEREOPHONIE — FINAL REAL AI LAUNCHER ANIMATION
   IMPORTANT:
   This targets the ACTUAL JSX element:
       <button className="st3-ai-launcher">
   No imaginary pulse child elements are required.
   ======================================================================== */


/* ------------------------------------------------------------------------
   AI launcher itself
   ------------------------------------------------------------------------ */

button.st3-ai-launcher {
  overflow: visible !important;

  /*
   * This animation contains BOTH:
   * 1. the vertical floating
   * 2. the breathing mustard glow
   *
   * Keeping them in one animation prevents transform animations
   * from overriding one another.
   */
  animation:
    stereophonieAiLauncherRealBreath 2.8s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    box-shadow !important;

  transform-origin:
    center center !important;
}


/* ------------------------------------------------------------------------
   The actual breathing animation
   ------------------------------------------------------------------------ */

@keyframes stereophonieAiLauncherRealBreath {

  0%,
  100% {
    transform:
      translate3d(0, 0, 0) !important;

    box-shadow:
      0 8px 26px rgba(0, 0, 0, .10),
      0 0 0 0 rgba(253, 183, 62, 0),
      0 0 0 0 rgba(253, 183, 62, 0) !important;
  }


  18% {
    transform:
      translate3d(0, -2px, 0) !important;

    box-shadow:
      0 10px 28px rgba(0, 0, 0, .10),
      0 0 0 4px rgba(253, 183, 62, .08),
      0 0 16px 3px rgba(253, 183, 62, .10) !important;
  }


  46% {
    transform:
      translate3d(0, -7px, 0) !important;

    box-shadow:
      0 13px 32px rgba(0, 0, 0, .11),
      0 0 0 10px rgba(253, 183, 62, .15),
      0 0 30px 11px rgba(253, 183, 62, .23),
      0 0 52px 17px rgba(253, 183, 62, .12) !important;
  }


  62% {
    transform:
      translate3d(0, -6px, 0) !important;

    box-shadow:
      0 12px 31px rgba(0, 0, 0, .105),
      0 0 0 14px rgba(253, 183, 62, .07),
      0 0 38px 16px rgba(253, 183, 62, .15),
      0 0 58px 22px rgba(253, 183, 62, .07) !important;
  }


  82% {
    transform:
      translate3d(0, -2px, 0) !important;

    box-shadow:
      0 9px 27px rgba(0, 0, 0, .10),
      0 0 0 5px rgba(253, 183, 62, .035),
      0 0 19px 7px rgba(253, 183, 62, .07) !important;
  }
}


/* ------------------------------------------------------------------------
   Additional halo directly attached to the REAL button.
   This makes the light visibly expand outward rather than merely
   changing the button shadow.
   ------------------------------------------------------------------------ */

button.st3-ai-launcher::before {
  content: "" !important;

  position:
    absolute !important;

  inset:
    -10px !important;

  border-radius:
    999px !important;

  pointer-events:
    none !important;

  z-index:
    -1 !important;

  background:
    rgba(253, 183, 62, .20) !important;

  filter:
    blur(10px) !important;

  opacity:
    0 !important;

  transform:
    scale(.82) !important;

  animation:
    stereophonieAiRealHalo 2.8s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  will-change:
    opacity,
    transform !important;
}


@keyframes stereophonieAiRealHalo {

  0%,
  100% {
    opacity:
      0 !important;

    transform:
      scale(.82) !important;
  }


  20% {
    opacity:
      .18 !important;

    transform:
      scale(.91) !important;
  }


  46% {
    opacity:
      .92 !important;

    transform:
      scale(1.08) !important;
  }


  64% {
    opacity:
      .38 !important;

    transform:
      scale(1.22) !important;
  }


  84% {
    opacity:
      .08 !important;

    transform:
      scale(1.30) !important;
  }
}


/* ------------------------------------------------------------------------
   Second softer outer breathing layer
   ------------------------------------------------------------------------ */

button.st3-ai-launcher::after {
  content:
    "" !important;

  position:
    absolute !important;

  inset:
    -18px !important;

  border-radius:
    999px !important;

  pointer-events:
    none !important;

  z-index:
    -2 !important;

  border:
    1px solid rgba(253, 183, 62, .12) !important;

  box-shadow:
    0 0 22px rgba(253, 183, 62, .08) !important;

  opacity:
    0 !important;

  transform:
    scale(.76) !important;

  animation:
    stereophonieAiRealOuterHalo 2.8s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


@keyframes stereophonieAiRealOuterHalo {

  0%,
  100% {
    opacity:
      0 !important;

    transform:
      scale(.78) !important;
  }


  43% {
    opacity:
      .58 !important;

    transform:
      scale(1.02) !important;
  }


  68% {
    opacity:
      .18 !important;

    transform:
      scale(1.20) !important;
  }


  86% {
    opacity:
      0 !important;

    transform:
      scale(1.30) !important;
  }
}


/* ------------------------------------------------------------------------
   Keep icon + text visually above breathing light
   ------------------------------------------------------------------------ */

button.st3-ai-launcher > * {
  position:
    relative !important;

  z-index:
    2 !important;
}


/* ------------------------------------------------------------------------
   Once assistant is opened, stop attention-seeking movement.
   ------------------------------------------------------------------------ */

button.st3-ai-launcher.st3-ai-launcher--open {
  animation:
    none !important;

  transform:
    translate3d(0, 0, 0) !important;

  box-shadow:
    0 8px 26px rgba(0, 0, 0, .10) !important;
}


button.st3-ai-launcher.st3-ai-launcher--open::before,
button.st3-ai-launcher.st3-ai-launcher--open::after {
  animation:
    none !important;

  opacity:
    0 !important;
}


/* ========================================================================
   END REAL AI LAUNCHER ANIMATION
   ======================================================================== */



/* ======================================================================
   STEREOPHONIE — FINAL AI ASSISTANT LAUNCHER
   ONE CLEAN CIRCLE + REAL MUSTARD BREATHING GLOW
   ====================================================================== */


/* ----------------------------------------------------------------------
   1. REMOVE ALL OLD ARTIFICIAL RINGS
   ---------------------------------------------------------------------- */

button.st3-ai-launcher::before,
button.st3-ai-launcher::after {
  content: none !important;
  display: none !important;
  animation: none !important;
  box-shadow: none !important;
  border: 0 !important;
  background: transparent !important;
}


/* ----------------------------------------------------------------------
   2. REMOVE THE INNER WHITE / DOUBLE CIRCLE
   ---------------------------------------------------------------------- */

button.st3-ai-launcher .st3-ai-launcher__icon {
  display: grid !important;
  place-items: center !important;

  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;

  padding: 0 !important;
  margin: 0 !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;

  box-shadow: none !important;

  outline: none !important;

  transform: none !important;
}


/*
 * Robot itself stays crisp and centered.
 */
button.st3-ai-launcher .st3-ai-launcher__icon svg {
  width: 25px !important;
  height: 25px !important;

  display: block !important;

  color: #1d1d1f !important;

  stroke: currentColor !important;
}


/* ----------------------------------------------------------------------
   3. ONE CLEAN MAIN BUTTON
   ---------------------------------------------------------------------- */

button.st3-ai-launcher {
  /*
   * Keep its existing fixed screen position.
   * We only normalize the visual button.
   */

  width: 58px !important;
  height: 58px !important;

  min-width: 58px !important;
  min-height: 58px !important;

  padding: 0 !important;

  border-radius: 999px !important;

  border:
    1px solid rgba(29, 29, 31, .10) !important;

  background:
    rgba(255, 255, 255, .98) !important;

  display: grid !important;
  place-items: center !important;

  overflow: visible !important;

  isolation: isolate !important;

  /*
   * TWO animations:
   *
   * 1. visible mustard breathing
   * 2. very small vertical floating
   *
   * Neither creates another circle.
   */
  animation:
    stAiRealMustardBreathing 2.65s
      cubic-bezier(.4, 0, .2, 1)
      infinite,
    stAiRealFloat 3.5s
      ease-in-out
      infinite !important;

  will-change:
    transform,
    box-shadow !important;
}


/* ----------------------------------------------------------------------
   4. ACTUAL BREATHING LIGHT
   ----------------------------------------------------------------------

   The important part:

   0%   = essentially no mustard
   45%  = glow begins opening
   58%  = strongest breathing point
   76%  = glow retreats
   100% = back to almost nothing

   This is intentionally similar to the successful NEW badge effect.
   ---------------------------------------------------------------------- */

@keyframes stAiRealMustardBreathing {

  0%,
  100% {
    box-shadow:
      0 7px 22px rgba(0, 0, 0, .075),

      0 0 0 0
      rgba(253, 183, 62, 0),

      0 0 0 0
      rgba(253, 183, 62, 0) !important;
  }


  22% {
    box-shadow:
      0 8px 24px rgba(0, 0, 0, .08),

      0 0 0 4px
      rgba(253, 183, 62, .055),

      0 0 16px 4px
      rgba(253, 183, 62, .055) !important;
  }


  46% {
    box-shadow:
      0 9px 25px rgba(0, 0, 0, .08),

      0 0 0 9px
      rgba(253, 183, 62, .095),

      0 0 27px 9px
      rgba(253, 183, 62, .13) !important;
  }


  58% {
    box-shadow:
      0 10px 27px rgba(0, 0, 0, .085),

      0 0 0 14px
      rgba(253, 183, 62, .10),

      0 0 35px 14px
      rgba(253, 183, 62, .18),

      0 0 52px 20px
      rgba(253, 183, 62, .08) !important;
  }


  74% {
    box-shadow:
      0 9px 25px rgba(0, 0, 0, .08),

      0 0 0 9px
      rgba(253, 183, 62, .045),

      0 0 25px 10px
      rgba(253, 183, 62, .075) !important;
  }


  88% {
    box-shadow:
      0 8px 23px rgba(0, 0, 0, .075),

      0 0 0 3px
      rgba(253, 183, 62, .015),

      0 0 10px 4px
      rgba(253, 183, 62, .025) !important;
  }
}


/* ----------------------------------------------------------------------
   5. GENTLE UP / DOWN MOVEMENT
   ---------------------------------------------------------------------- */

@keyframes stAiRealFloat {

  0%,
  100% {
    transform:
      translate3d(0, 0, 0);
  }

  50% {
    transform:
      translate3d(0, -6px, 0);
  }
}


/* ----------------------------------------------------------------------
   6. KEEP LABEL FROM CREATING ANOTHER VISUAL LAYER
   ---------------------------------------------------------------------- */

button.st3-ai-launcher .st3-ai-launcher__label {
  /*
   * Preserve whatever responsive behavior the launcher already has,
   * but don't let the label create shadows/rings.
   */
  box-shadow: none !important;
}


/* ----------------------------------------------------------------------
   7. HOVER — CLEAN, NOT GAMING-LIKE
   ---------------------------------------------------------------------- */

button.st3-ai-launcher:hover {
  border-color:
    rgba(253, 183, 62, .34) !important;
}


/* ----------------------------------------------------------------------
   8. WHEN ASSISTANT IS OPEN
   ----------------------------------------------------------------------

   Once the customer has already opened it, attraction animation stops.
   ---------------------------------------------------------------------- */

button.st3-ai-launcher.st3-ai-launcher--open {
  animation: none !important;

  transform:
    translate3d(0, 0, 0) !important;

  box-shadow:
    0 7px 22px
    rgba(0, 0, 0, .075) !important;
}


/* ----------------------------------------------------------------------
   9. DO NOT LET OLD CHILD ANIMATIONS CREATE STATIC HALOS
   ---------------------------------------------------------------------- */

button.st3-ai-launcher *,
button.st3-ai-launcher *::before,
button.st3-ai-launcher *::after {
  text-shadow: none !important;
}


/* ======================================================================
   END — FINAL AI ASSISTANT LAUNCHER
   ====================================================================== */



/* ======================================================================
   STEREOPHONIE
   AI ASSISTANT — PERFECT CENTER + REAL MUSTARD BREATH
   ====================================================================== */


/* ----------------------------------------------------------------------
   MAIN BUTTON
   ---------------------------------------------------------------------- */

button.st3-ai-launcher {
  position: fixed !important;

  width: 58px !important;
  height: 58px !important;
  min-width: 58px !important;
  min-height: 58px !important;

  padding: 0 !important;

  border-radius: 50% !important;

  border:
    1px solid rgba(29, 29, 31, 0.10) !important;

  background:
    #ffffff !important;

  overflow: visible !important;

  isolation: isolate !important;

  display: block !important;

  /*
   * Main subtle physical shadow.
   * The mustard breathing comes from ::before below.
   */
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.07) !important;

  animation:
    stAiButtonFloatFinal
    3.8s
    ease-in-out
    infinite !important;

  will-change:
    transform !important;
}


/* ----------------------------------------------------------------------
   PERFECT ROBOT CENTERING
   ----------------------------------------------------------------------

   We do not rely on flex alignment or surrounding text.
   The icon gets the full 58x58 button canvas and is centered
   mathematically using absolute positioning.
   ---------------------------------------------------------------------- */

button.st3-ai-launcher .st3-ai-launcher__icon {
  position: absolute !important;

  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  display: grid !important;
  place-items: center !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;

  box-shadow: none !important;

  line-height: 0 !important;

  transform: none !important;
}


/*
 * Keep the actual robot itself centered.
 */
button.st3-ai-launcher .st3-ai-launcher__icon > svg {
  position: static !important;

  display: block !important;

  width: 26px !important;
  height: 26px !important;

  margin: 0 !important;

  transform:
    translate3d(0, 0, 0) !important;

  color:
    #1d1d1f !important;

  overflow: visible !important;
}


/* ----------------------------------------------------------------------
   PREVENT LABEL FROM PUSHING ICON
   ---------------------------------------------------------------------- */

button.st3-ai-launcher .st3-ai-launcher__label {
  position: absolute !important;

  /*
   * The current compact launcher is icon-only visually.
   * Prevent this text element from affecting centering.
   */
  pointer-events: none !important;
}


/* ----------------------------------------------------------------------
   REMOVE OLD SECONDARY CIRCLE
   ---------------------------------------------------------------------- */

button.st3-ai-launcher .st3-ai-launcher__icon::before,
button.st3-ai-launcher .st3-ai-launcher__icon::after {
  content: none !important;

  display: none !important;

  border: 0 !important;

  background: none !important;

  box-shadow: none !important;
}


/* ----------------------------------------------------------------------
   REAL BREATHING MUSTARD LIGHT
   ----------------------------------------------------------------------

   This is NOT a ring.

   It is a blurred radial field behind the button.

   The field:
     - starts almost invisible
     - grows outward
     - becomes brighter
     - slowly retreats
     - almost disappears
     - repeats
   ---------------------------------------------------------------------- */

button.st3-ai-launcher::before {
  content: "" !important;

  display: block !important;

  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 92px !important;
  height: 92px !important;

  border-radius: 50% !important;

  pointer-events: none !important;

  z-index: -1 !important;

  background:
    radial-gradient(
      circle,
      rgba(253, 183, 62, 0.38) 0%,
      rgba(253, 183, 62, 0.23) 28%,
      rgba(253, 183, 62, 0.10) 48%,
      rgba(253, 183, 62, 0.035) 63%,
      rgba(253, 183, 62, 0) 76%
    ) !important;

  filter:
    blur(7px) !important;

  opacity: 0.10;

  transform:
    translate(-50%, -50%)
    scale(0.72);

  transform-origin:
    center center !important;

  animation:
    stAiMustardBreathFinal
    2.75s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity !important;
}


/*
 * Absolutely no second outlined ring.
 */
button.st3-ai-launcher::after {
  content: none !important;
  display: none !important;
}


/* ----------------------------------------------------------------------
   BREATHING CYCLE
   ---------------------------------------------------------------------- */

@keyframes stAiMustardBreathFinal {

  0%,
  100% {
    opacity: 0.04;

    transform:
      translate(-50%, -50%)
      scale(0.68);
  }


  18% {
    opacity: 0.16;

    transform:
      translate(-50%, -50%)
      scale(0.78);
  }


  42% {
    opacity: 0.52;

    transform:
      translate(-50%, -50%)
      scale(1.00);
  }


  55% {
    opacity: 0.92;

    transform:
      translate(-50%, -50%)
      scale(1.22);
  }


  68% {
    opacity: 0.54;

    transform:
      translate(-50%, -50%)
      scale(1.08);
  }


  86% {
    opacity: 0.12;

    transform:
      translate(-50%, -50%)
      scale(0.78);
  }
}


/* ----------------------------------------------------------------------
   VERY GENTLE FLOAT
   ---------------------------------------------------------------------- */

@keyframes stAiButtonFloatFinal {

  0%,
  100% {
    transform:
      translate3d(0, 0, 0);
  }


  50% {
    transform:
      translate3d(0, -5px, 0);
  }
}


/* ----------------------------------------------------------------------
   HOVER
   ----------------------------------------------------------------------

   Keep it refined.
   No violent enlargement.
   ---------------------------------------------------------------------- */

button.st3-ai-launcher:hover {
  border-color:
    rgba(253, 183, 62, 0.34) !important;
}


/* ----------------------------------------------------------------------
   OPEN ASSISTANT
   ----------------------------------------------------------------------

   Once clicked, attraction animation is no longer necessary.
   ---------------------------------------------------------------------- */

button.st3-ai-launcher.st3-ai-launcher--open {
  animation: none !important;

  transform:
    translate3d(0, 0, 0) !important;
}


button.st3-ai-launcher.st3-ai-launcher--open::before {
  animation: none !important;

  opacity: 0.10 !important;

  transform:
    translate(-50%, -50%)
    scale(0.78) !important;
}


/* ======================================================================
   END AI ASSISTANT FINAL BREATH
   ====================================================================== */



/* =====================================================================
   STEREOPHONIE — AI ASSISTANT ALWAYS-ON BREATHING
   FINAL OVERRIDE
   =====================================================================

   IMPORTANT:
   The mustard breathing effect must run while the launcher is IDLE.
   Hovering is NOT required.
   ===================================================================== */


/* ---------------------------------------------------------------------
   IDLE LAUNCHER — ALWAYS MOVING
   --------------------------------------------------------------------- */

.st3-ai-launcher:not(.st3-ai-launcher--open) {
  animation:
    stAiAlwaysFloat 3.8s ease-in-out infinite !important;

  overflow: visible !important;

  isolation: isolate !important;

  will-change: transform !important;
}


/* ---------------------------------------------------------------------
   ALWAYS-ON MUSTARD GLOW

   This pseudo-element exists and animates even when:
   - mouse is nowhere near the button
   - button is not focused
   - button is not active

   It is intentionally independent of :hover.
   --------------------------------------------------------------------- */

.st3-ai-launcher:not(.st3-ai-launcher--open)::before {
  content: "" !important;

  display: block !important;

  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  width: 100px !important;
  height: 100px !important;

  border-radius: 999px !important;

  pointer-events: none !important;

  z-index: -1 !important;

  background:
    radial-gradient(
      circle,
      rgba(253, 183, 62, 0.42) 0%,
      rgba(253, 183, 62, 0.26) 24%,
      rgba(253, 183, 62, 0.13) 43%,
      rgba(253, 183, 62, 0.055) 60%,
      rgba(253, 183, 62, 0) 76%
    ) !important;

  filter: blur(8px) !important;

  opacity: 0.08 !important;

  transform:
    translate(-50%, -50%)
    scale(0.70) !important;

  transform-origin: center !important;

  animation:
    stAiAlwaysBreathe 2.7s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-play-state: running !important;

  will-change:
    opacity,
    transform !important;
}


/* ---------------------------------------------------------------------
   REMOVE ANY OLD HOVER-ONLY GLOW DEPENDENCY
   --------------------------------------------------------------------- */

.st3-ai-launcher:hover::before,
.st3-ai-launcher:focus::before,
.st3-ai-launcher:focus-visible::before,
.st3-ai-launcher:active::before {
  animation:
    stAiAlwaysBreathe 2.7s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-play-state: running !important;
}


/*
 * Hover should not suddenly create a different halo.
 * The same breathing animation simply keeps running.
 */
.st3-ai-launcher:hover {
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.07) !important;
}


/* ---------------------------------------------------------------------
   NO DOUBLE CIRCLE
   --------------------------------------------------------------------- */

.st3-ai-launcher:not(.st3-ai-launcher--open)::after {
  content: none !important;
  display: none !important;
}


/* ---------------------------------------------------------------------
   REAL BREATHING CYCLE
   --------------------------------------------------------------------- */

@keyframes stAiAlwaysBreathe {

  0%,
  100% {
    opacity: 0.05;

    transform:
      translate(-50%, -50%)
      scale(0.68);
  }

  20% {
    opacity: 0.18;

    transform:
      translate(-50%, -50%)
      scale(0.80);
  }

  45% {
    opacity: 0.58;

    transform:
      translate(-50%, -50%)
      scale(1.04);
  }

  56% {
    opacity: 1;

    transform:
      translate(-50%, -50%)
      scale(1.24);
  }

  68% {
    opacity: 0.58;

    transform:
      translate(-50%, -50%)
      scale(1.06);
  }

  86% {
    opacity: 0.14;

    transform:
      translate(-50%, -50%)
      scale(0.78);
  }
}


/* ---------------------------------------------------------------------
   GENTLE ATTENTION FLOAT
   --------------------------------------------------------------------- */

@keyframes stAiAlwaysFloat {

  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -5px, 0);
  }
}


/* ---------------------------------------------------------------------
   WHEN ASSISTANT IS OPEN

   Stop attraction animation because the user already interacted.
   --------------------------------------------------------------------- */

.st3-ai-launcher.st3-ai-launcher--open {
  animation: none !important;

  transform: translate3d(0, 0, 0) !important;
}

.st3-ai-launcher.st3-ai-launcher--open::before {
  animation: none !important;

  opacity: 0.06 !important;

  transform:
    translate(-50%, -50%)
    scale(0.72) !important;
}


/* =====================================================================
   END — AI ASSISTANT ALWAYS-ON BREATHING
   ===================================================================== */



/* =========================================================
   STEREOPHONIE V3
   REAL AI LAUNCHER — FINAL BREATHING SYSTEM
   Targets the ACTUAL active JSX:
   .st3-ai-launcher
   .st3-ai-launcher__pulse--outer
   .st3-ai-launcher__pulse--inner
   ========================================================= */


/* ---------------------------------------------------------
   1. LAUNCHER FOUNDATION
   --------------------------------------------------------- */

.st3-ai-launcher {
  /*
   * Keep the actual button visually clean.
   * The light comes from the two dedicated pulse layers.
   */
  isolation: isolate !important;
  overflow: visible !important;

  /*
   * Important:
   * do NOT use transform for floating because older hover
   * rules may also use transform.
   *
   * `translate` can animate independently.
   */
  translate: 0 0;

  animation:
    st3RealAiFloat 3.8s
    cubic-bezier(.45, 0, .55, 1)
    infinite !important;
}


/*
 * The floating effect must continue even when the mouse
 * is NOT over the launcher.
 */
.st3-ai-launcher:not(:hover),
.st3-ai-launcher:hover,
.st3-ai-launcher:focus-visible {
  animation:
    st3RealAiFloat 3.8s
    cubic-bezier(.45, 0, .55, 1)
    infinite !important;
}


/*
 * Stop old ::before / ::after systems from creating
 * the ugly double-circle appearance.
 */
.st3-ai-launcher::before,
.st3-ai-launcher::after {
  content: none !important;
  display: none !important;
}


/* ---------------------------------------------------------
   2. REAL MUSTARD BREATHING LIGHT
   --------------------------------------------------------- */

.st3-ai-launcher__pulse {
  position: absolute !important;

  display: block !important;

  left: 50% !important;
  top: 50% !important;

  width: 100% !important;
  height: 100% !important;

  border-radius: 999px !important;

  pointer-events: none !important;

  /*
   * Pulse layers must sit BEHIND the white launcher.
   */
  z-index: -1 !important;

  opacity: 1;

  transform-origin: center center !important;

  will-change:
    transform,
    opacity,
    filter !important;
}


/*
 * LARGE soft breathing aura.
 *
 * This is the visible mustard cloud that expands,
 * becomes bright, then returns to almost invisible.
 */
.st3-ai-launcher__pulse--outer {
  background:
    radial-gradient(
      circle,
      rgba(245, 179, 53, .32) 0%,
      rgba(245, 179, 53, .20) 28%,
      rgba(245, 179, 53, .09) 54%,
      rgba(245, 179, 53, 0) 76%
    ) !important;

  filter:
    blur(10px) !important;

  animation:
    st3RealAiOuterBreath 2.85s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


/*
 * SMALLER, brighter aura close to the button.
 *
 * Slightly delayed from the outer pulse so the glow
 * feels organic instead of blinking.
 */
.st3-ai-launcher__pulse--inner {
  background:
    radial-gradient(
      circle,
      rgba(253, 183, 62, .36) 0%,
      rgba(253, 183, 62, .19) 40%,
      rgba(253, 183, 62, .045) 65%,
      rgba(253, 183, 62, 0) 80%
    ) !important;

  filter:
    blur(5px) !important;

  animation:
    st3RealAiInnerBreath 2.85s
    .12s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


/* ---------------------------------------------------------
   3. CLEAN SINGLE WHITE CIRCLE
   --------------------------------------------------------- */

.st3-ai-launcher__icon {
  /*
   * One single clean white launcher surface.
   */
  position: relative !important;

  z-index: 3 !important;

  display: grid !important;

  place-items: center !important;

  margin: 0 !important;

  border-radius: 999px !important;

  background: #fff !important;

  box-shadow:
    0 0 0 1px rgba(20, 20, 22, .08),
    0 8px 24px rgba(20, 20, 22, .09) !important;
}


/*
 * Keep robot perfectly centered.
 */
.st3-ai-launcher__icon > svg {
  display: block !important;

  margin: 0 !important;

  position: static !important;

  transform: none !important;
}


/* ---------------------------------------------------------
   4. BREATHING KEYFRAMES
   --------------------------------------------------------- */

@keyframes st3RealAiOuterBreath {
  0%,
  100% {
    opacity: .08;

    transform:
      translate(-50%, -50%)
      scale(.82);
  }

  18% {
    opacity: .20;
  }

  48% {
    opacity: .95;

    transform:
      translate(-50%, -50%)
      scale(1.66);
  }

  67% {
    opacity: .50;

    transform:
      translate(-50%, -50%)
      scale(1.34);
  }
}


@keyframes st3RealAiInnerBreath {
  0%,
  100% {
    opacity: .10;

    transform:
      translate(-50%, -50%)
      scale(.90);
  }

  45% {
    opacity: .88;

    transform:
      translate(-50%, -50%)
      scale(1.36);
  }

  72% {
    opacity: .32;

    transform:
      translate(-50%, -50%)
      scale(1.13);
  }
}


/* ---------------------------------------------------------
   5. VERY GENTLE UP / DOWN MOTION
   --------------------------------------------------------- */

@keyframes st3RealAiFloat {
  0%,
  100% {
    translate: 0 0;
  }

  50% {
    translate: 0 -5px;
  }
}


/* ---------------------------------------------------------
   6. HOVER
   Keep glow alive — hover should NOT be required.
   --------------------------------------------------------- */

.st3-ai-launcher:hover
.st3-ai-launcher__pulse--outer {
  animation:
    st3RealAiOuterBreath 2.85s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


.st3-ai-launcher:hover
.st3-ai-launcher__pulse--inner {
  animation:
    st3RealAiInnerBreath 2.85s
    .12s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


/* ---------------------------------------------------------
   7. OPEN STATE
   Once assistant is open, calm down the launcher.
   --------------------------------------------------------- */

.st3-ai-launcher--open {
  animation: none !important;

  translate: 0 0 !important;
}


.st3-ai-launcher--open
.st3-ai-launcher__pulse {
  animation: none !important;

  opacity: 0 !important;
}


/* ---------------------------------------------------------
   8. ACCESSIBILITY
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .st3-ai-launcher,
  .st3-ai-launcher__pulse--outer,
  .st3-ai-launcher__pulse--inner {
    animation: none !important;
  }

  .st3-ai-launcher {
    translate: 0 0 !important;
  }

  .st3-ai-launcher__pulse {
    opacity: .18 !important;
  }
}


/* =========================================================
   END — REAL AI LAUNCHER BREATHING SYSTEM
   ========================================================= */




/* ========================================================================
   STEREOPHONIE V3 — PREMIUM INTERACTION LAYER
   2026-08-19

   Goals:
   - smooth micro-interactions only
   - NO route transition
   - NO loading transition
   - NO layout-changing hover transforms
   - permanent AI breathing from first paint
   - compact shop-page top spacing
   ======================================================================== */


/* ------------------------------------------------------------------------
   1. GLOBAL STOREFRONT INTERACTION TIMING
   ------------------------------------------------------------------------ */

:root {
  --st-v3-ease:
    cubic-bezier(.22, .61, .36, 1);

  --st-v3-fast:
    160ms;

  --st-v3-medium:
    260ms;

  --st-v3-slow:
    360ms;

  --st-v3-mustard:
    #f5b335;

  --st-v3-mustard-soft:
    rgba(245, 179, 53, .18);

  --st-v3-charcoal:
    #1d1d1f;
}


/*
 * Smooth only actual interactive storefront elements.
 * No page entrance animation is being introduced.
 */
:is(
  .st3-header,
  .st-retail-shop,
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-ai-panel,
  .st3-ai-launcher
)
:is(
  button,
  a,
  input,
  select
) {
  -webkit-tap-highlight-color:
    transparent;

  transition:
    background-color var(--st-v3-medium) var(--st-v3-ease),
    border-color var(--st-v3-medium) var(--st-v3-ease),
    color var(--st-v3-medium) var(--st-v3-ease),
    box-shadow var(--st-v3-medium) var(--st-v3-ease),
    opacity var(--st-v3-medium) var(--st-v3-ease) !important;
}


/*
 * Press feedback should be restrained.
 * We intentionally do NOT translate elements.
 */
:is(
  .st-retail-shop,
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-ai-panel
)
button:active {
  filter:
    brightness(.975);
}


/* ------------------------------------------------------------------------
   2. PRODUCT PAGE — VIEW LARGER MUST NEVER MOVE
   ------------------------------------------------------------------------ */

/*
 * The product-gallery enlarge control previously inherited transform
 * rules from archived interaction layers. Hard reset its geometry.
 */
:is(
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-product-page
)
:is(
  .st-pdp17-gallery__fullscreen,
  [class*="gallery"][class*="fullscreen"],
  [class*="gallery"][class*="larger"],
  button[aria-label^="Expand"],
  button[aria-label*="product image"]
) {
  translate:
    none !important;

  transform:
    none !important;

  scale:
    1 !important;

  margin:
    0 !important;

  transition:
    background-color 220ms var(--st-v3-ease),
    border-color 220ms var(--st-v3-ease),
    color 220ms var(--st-v3-ease),
    box-shadow 220ms var(--st-v3-ease),
    opacity 220ms var(--st-v3-ease) !important;
}


:is(
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-product-page
)
:is(
  .st-pdp17-gallery__fullscreen,
  [class*="gallery"][class*="fullscreen"],
  [class*="gallery"][class*="larger"],
  button[aria-label^="Expand"],
  button[aria-label*="product image"]
):is(
  :hover,
  :focus-visible,
  :active
) {
  translate:
    none !important;

  transform:
    none !important;

  scale:
    1 !important;
}


/*
 * Hover may become slightly lighter but stays physically stationary.
 */
:is(
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-product-page
)
button[aria-label^="Expand"]:hover {
  box-shadow:
    0 8px 24px
    rgba(0, 0, 0, .10) !important;
}


/* ------------------------------------------------------------------------
   3. HEADER — SMOOTH INTERACTIONS
   ------------------------------------------------------------------------ */

.st3-header__nav-item,
.st3-header__icon {
  transition:
    color 180ms var(--st-v3-ease),
    background-color 180ms var(--st-v3-ease),
    opacity 180ms var(--st-v3-ease),
    box-shadow 180ms var(--st-v3-ease) !important;
}


/*
 * Icon hover circles should appear softly rather than instantly.
 */
.st3-header__icon {
  border-radius:
    999px !important;
}


.st3-header__icon:hover,
.st3-header__icon:focus-visible {
  border-radius:
    999px !important;

  background:
    rgba(29, 29, 31, .055) !important;
}


/*
 * Mega-menu outer shell.
 * Covers active V3 naming plus older V3 namespaces that can still
 * exist in the compiled stylesheet.
 */
:is(
  .st3-mega,
  .st3-mega-menu,
  .st3-header__mega,
  .st3-header__panel,
  .st3-header__dropdown
) {
  transform-origin:
    top center;

  transition:
    opacity 220ms var(--st-v3-ease),
    transform 260ms var(--st-v3-ease),
    visibility 220ms var(--st-v3-ease) !important;
}


/*
 * When the component exposes any normal open-state naming,
 * use a gentle settle instead of an abrupt pop.
 */
:is(
  .st3-mega,
  .st3-mega-menu,
  .st3-header__mega,
  .st3-header__panel,
  .st3-header__dropdown
):is(
  .is-open,
  .is-active,
  .st3-mega--open,
  .st3-header__mega--open,
  .st3-header__panel--open
) {
  opacity:
    1;

  transform:
    translate3d(0, 0, 0);
}


/*
 * Smooth menu content swapping between Phones / Smart Watches /
 * categories instead of making the content visually snap.
 */
:is(
  .st3-mega__primary,
  .st3-mega__secondary,
  .st3-mega__content,
  .st3-mega__primary-links,
  .st3-mega__secondary-links
) {
  transition:
    opacity 220ms var(--st-v3-ease),
    transform 260ms var(--st-v3-ease) !important;
}


.st3-mega :is(
  a,
  button
) {
  transition:
    color 180ms var(--st-v3-ease),
    background-color 180ms var(--st-v3-ease),
    opacity 180ms var(--st-v3-ease),
    padding-left 220ms var(--st-v3-ease) !important;
}


/* ------------------------------------------------------------------------
   4. SHOP — REMOVE EXCESSIVE TOP WHITE SPACE
   ------------------------------------------------------------------------ */

/*
 * The screenshot shows too much vertical breathing room between the
 * sticky header and "Shop all products".
 */
.st-retail-shop {
  padding-top:
    0 !important;
}


.st-retail-shop .st-v2-shop-body {
  padding-top:
    clamp(42px, 4.25vw, 66px) !important;
}


.st-retail-shop .st-v2-container {
  padding-top:
    0 !important;
}


.st-retail-shop :is(
  .st-v2-shop-results__head,
  .st-v2-shop-heading,
  .st-retail-shop__heading
) {
  margin-top:
    0 !important;
}


/*
 * In case an old hero wrapper is still occupying empty height,
 * ensure it cannot reserve invisible space.
 */
.st-retail-shop :is(
  .st3-shop-hero,
  .st-v2-shop-hero,
  .st3-shop-intro
) {
  display:
    none !important;

  height:
    0 !important;

  min-height:
    0 !important;

  margin:
    0 !important;

  padding:
    0 !important;
}


/* ------------------------------------------------------------------------
   5. SHOP FILTERS — SMOOTH STATE CHANGE
   ------------------------------------------------------------------------ */

.st-filter-v4__pill {
  will-change:
    background-color,
    border-color,
    color;

  transition:
    background-color 240ms var(--st-v3-ease),
    border-color 240ms var(--st-v3-ease),
    color 240ms var(--st-v3-ease),
    box-shadow 240ms var(--st-v3-ease) !important;
}


.st-filter-v4__stock-dot {
  background:
    var(--st-v3-mustard) !important;

  box-shadow:
    0 0 0 3px
    rgba(245, 179, 53, .09);

  transition:
    background-color 240ms var(--st-v3-ease),
    box-shadow 240ms var(--st-v3-ease),
    opacity 240ms var(--st-v3-ease) !important;
}


.st-filter-v4__pill.is-active {
  background:
    #1d1d1f !important;

  border-color:
    #1d1d1f !important;

  color:
    #fff !important;

  box-shadow:
    0 8px 22px
    rgba(0, 0, 0, .075);
}


.st-filter-v4__pill.is-active
.st-filter-v4__stock-dot {
  background:
    var(--st-v3-mustard) !important;

  box-shadow:
    0 0 0 4px
    rgba(245, 179, 53, .12) !important;
}


/*
 * Search / sort / selector controls.
 */
:is(
  .st-filter-v4__search,
  .st-filter-v4__pill,
  .st-filter-v4__sort,
  .st-filter-v4__dropdown,
  .st-filter-v4__panel
) {
  transition:
    background-color 240ms var(--st-v3-ease),
    border-color 240ms var(--st-v3-ease),
    color 240ms var(--st-v3-ease),
    box-shadow 240ms var(--st-v3-ease),
    opacity 240ms var(--st-v3-ease) !important;
}


/* ------------------------------------------------------------------------
   6. PRODUCT CARD — PREMIUM IMAGE CROSSFADE
   ------------------------------------------------------------------------ */

.st-retail-card__image {
  backface-visibility:
    hidden;

  transform:
    translateZ(0);

  transition:
    opacity 420ms var(--st-v3-ease),
    filter 420ms var(--st-v3-ease) !important;
}


.st-retail-card__image--primary {
  opacity:
    1;
}


.st-retail-card__image--secondary {
  opacity:
    0;
}


/*
 * Crossfade. No hard replacement.
 */
.st-retail-card:hover
.st-retail-card__image--primary {
  opacity:
    0;
}


.st-retail-card:hover
.st-retail-card__image--secondary {
  opacity:
    1;
}


/*
 * Product-card controls also get a refined response.
 */
.st-retail-card :is(
  button,
  a
) {
  transition:
    background-color 220ms var(--st-v3-ease),
    border-color 220ms var(--st-v3-ease),
    color 220ms var(--st-v3-ease),
    box-shadow 220ms var(--st-v3-ease),
    opacity 220ms var(--st-v3-ease) !important;
}


/* ------------------------------------------------------------------------
   7. AI ASSISTANT — START BREATHING FROM FIRST PAINT
   ------------------------------------------------------------------------ */

/*
 * Critical:
 *
 * The launcher already contains:
 *
 * .st3-ai-launcher__pulse--outer
 * .st3-ai-launcher__pulse--inner
 *
 * Use those real DOM elements rather than pseudo-elements or hover state.
 */

.st3-ai-launcher {
  position:
    fixed !important;

  overflow:
    visible !important;

  isolation:
    isolate !important;

  /*
   * translate is animated instead of transform so previous transform
   * hover rules cannot cancel the floating loop.
   */
  animation:
    st3AiPermanentFloat
    3.7s
    ease-in-out
    infinite !important;

  animation-delay:
    0s !important;

  animation-play-state:
    running !important;

  will-change:
    translate;

  transition:
    border-color 220ms var(--st-v3-ease),
    box-shadow 220ms var(--st-v3-ease),
    background-color 220ms var(--st-v3-ease) !important;
}


/*
 * Hover must NOT be responsible for starting the animation.
 */
.st3-ai-launcher:hover,
.st3-ai-launcher:focus-visible,
.st3-ai-launcher:active,
.st3-ai-launcher--open {
  animation:
    st3AiPermanentFloat
    3.7s
    ease-in-out
    infinite !important;

  animation-delay:
    0s !important;

  animation-play-state:
    running !important;
}


/*
 * Remove old generated rings that previously caused double circles.
 */
.st3-ai-launcher::before,
.st3-ai-launcher::after {
  content:
    none !important;

  display:
    none !important;

  animation:
    none !important;
}


/*
 * REAL outer breathing light.
 */
.st3-ai-launcher__pulse--outer {
  display:
    block !important;

  visibility:
    visible !important;

  position:
    absolute !important;

  inset:
    -17px !important;

  border:
    0 !important;

  border-radius:
    999px !important;

  background:
    rgba(245, 179, 53, .13) !important;

  opacity:
    .18;

  filter:
    blur(10px) !important;

  pointer-events:
    none !important;

  z-index:
    -2 !important;

  transform-origin:
    center !important;

  animation:
    st3AiPermanentOuterBreath
    2.65s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-delay:
    0s !important;

  animation-play-state:
    running !important;

  will-change:
    transform,
    opacity,
    filter;
}


/*
 * REAL inner mustard halo.
 */
.st3-ai-launcher__pulse--inner {
  display:
    block !important;

  visibility:
    visible !important;

  position:
    absolute !important;

  inset:
    -8px !important;

  border:
    1px solid
    rgba(245, 179, 53, .16) !important;

  border-radius:
    999px !important;

  background:
    rgba(245, 179, 53, .055) !important;

  opacity:
    .20;

  pointer-events:
    none !important;

  z-index:
    -1 !important;

  transform-origin:
    center !important;

  animation:
    st3AiPermanentInnerBreath
    2.65s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-delay:
    0s !important;

  animation-play-state:
    running !important;

  will-change:
    transform,
    opacity;
}


/*
 * Prevent any old :hover selector from replacing the pulse animation.
 */
.st3-ai-launcher:hover
.st3-ai-launcher__pulse--outer,
.st3-ai-launcher:focus-visible
.st3-ai-launcher__pulse--outer,
.st3-ai-launcher:active
.st3-ai-launcher__pulse--outer,
.st3-ai-launcher--open
.st3-ai-launcher__pulse--outer {
  animation:
    st3AiPermanentOuterBreath
    2.65s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-play-state:
    running !important;
}


.st3-ai-launcher:hover
.st3-ai-launcher__pulse--inner,
.st3-ai-launcher:focus-visible
.st3-ai-launcher__pulse--inner,
.st3-ai-launcher:active
.st3-ai-launcher__pulse--inner,
.st3-ai-launcher--open
.st3-ai-launcher__pulse--inner {
  animation:
    st3AiPermanentInnerBreath
    2.65s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-play-state:
    running !important;
}


/*
 * Bot stays exactly centered.
 */
.st3-ai-launcher__icon {
  display:
    grid !important;

  place-items:
    center !important;

  position:
    relative !important;

  inset:
    auto !important;

  margin:
    0 !important;

  transform:
    none !important;
}


.st3-ai-launcher__icon svg {
  display:
    block !important;

  margin:
    auto !important;

  transform:
    none !important;
}


/*
 * Stronger but still premium breathing.
 */
@keyframes st3AiPermanentOuterBreath {

  0%,
  100% {
    opacity:
      .13;

    transform:
      scale(.82);

    filter:
      blur(9px);
  }

  48% {
    opacity:
      .64;

    transform:
      scale(1.25);

    filter:
      blur(14px);
  }

  62% {
    opacity:
      .46;

    transform:
      scale(1.15);

    filter:
      blur(12px);
  }
}


@keyframes st3AiPermanentInnerBreath {

  0%,
  100% {
    opacity:
      .18;

    transform:
      scale(.91);
  }

  48% {
    opacity:
      .58;

    transform:
      scale(1.12);
  }

  62% {
    opacity:
      .42;

    transform:
      scale(1.07);
  }
}


@keyframes st3AiPermanentFloat {

  0%,
  100% {
    translate:
      0 0;
  }

  50% {
    translate:
      0 -5px;
  }
}


/* ------------------------------------------------------------------------
   8. KEEP NEW-BADGE BREATHING THAT ALREADY LOOKS GOOD
   ------------------------------------------------------------------------ */

.st-retail-card__badges > span:first-child {
  animation:
    stMustardBadgeBreath
    2.9s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  animation-play-state:
    running !important;
}


/* ------------------------------------------------------------------------
   9. BUTTON HOVER POLISH
   ------------------------------------------------------------------------ */

/*
 * Smooth hover without moving content around.
 */
:is(
  .st-retail-shop,
  .st-product-v3,
  .st-product-v4,
  .st-product-v5,
  .st3-ai-panel
)
:is(
  button,
  a
):hover {
  transition-duration:
    180ms !important;
}


/*
 * Do not allow old rules to translate normal CTA buttons on hover.
 */
:is(
  .st-purchase-v3,
  .st-purchase-v4,
  .st-purchase-v5
)
:is(
  button,
  a
):hover {
  translate:
    none !important;
}


/* ------------------------------------------------------------------------
   10. SAFARI / GPU COMPOSITING
   ------------------------------------------------------------------------ */

:is(
  .st-retail-card__image,
  .st-filter-v4__pill,
  .st3-ai-launcher,
  .st3-ai-launcher__pulse
) {
  -webkit-backface-visibility:
    hidden;

  backface-visibility:
    hidden;
}


/* ========================================================================
   END PREMIUM INTERACTION LAYER
   ======================================================================== */

/* === ST ACTIVE INTERACTION REPAIR 20260819 START === */

/*
 * This block intentionally appears at the very END of the active stylesheet.
 * It targets the CURRENT storefront architecture explicitly.
 *
 * It does not introduce route/loading transitions.
 */

:root {
  --st-active-mustard: #f5b335;
  --st-active-mustard-strong: #f1aa21;
  --st-active-black: #1d1d1f;
  --st-active-gray: #6e6e73;
  --st-active-line: rgba(29, 29, 31, .10);
  --st-active-ease: cubic-bezier(.22, .61, .36, 1);
}


/* =========================================================
   1. WISHLIST / SUCCESS NOTIFICATIONS — MUSTARD
   ========================================================= */

.st-wishlist-toast,
.wishlist-toast,
.wishlist-notification,
.st-wishlist-notification,
.st3-wishlist-toast,
.st3-toast--success,
[data-wishlist-toast],
[data-st-wishlist-toast] {
  background: #fff8e8 !important;
  border-color: rgba(245, 179, 53, .42) !important;
  color: #6f4b00 !important;

  box-shadow:
    0 12px 34px rgba(29, 29, 31, .08),
    0 0 0 1px rgba(245, 179, 53, .08) !important;
}

.st-wishlist-toast,
.wishlist-toast,
.wishlist-notification,
.st-wishlist-notification,
.st3-wishlist-toast,
.st3-toast--success,
[data-wishlist-toast],
[data-st-wishlist-toast] svg {
  color: #c58100 !important;
  stroke: currentColor !important;
}

.st-wishlist-toast,
.wishlist-toast,
.wishlist-notification,
.st-wishlist-notification,
.st3-wishlist-toast,
.st3-toast--success,
[data-wishlist-toast],
[data-st-wishlist-toast] :is(
  [class*="green"],
  [class*="emerald"]
) {
  color: #9d6700 !important;
}


/*
 * The screenshot shows a bottom-right role=status success card.
 * Restrict the fallback to fixed-position storefront status boxes.
 */
body > [role="status"][style*="position: fixed"],
body > [role="alert"][style*="position: fixed"] {
  --st-toast-mustard: #f5b335;
}


/* =========================================================
   2. VIEW LARGER — STATIONARY + RELIABLE
   ========================================================= */

[data-st-view-larger="true"] {
  transform: none !important;
  translate: none !important;
  scale: 1 !important;

  transition:
    background-color 180ms var(--st-active-ease),
    border-color 180ms var(--st-active-ease),
    color 180ms var(--st-active-ease),
    box-shadow 180ms var(--st-active-ease) !important;

  will-change: auto !important;
}

[data-st-view-larger="true"]:hover,
[data-st-view-larger="true"]:focus-visible,
[data-st-view-larger="true"]:active {
  transform: none !important;
  translate: none !important;
  scale: 1 !important;
}

[data-st-view-larger="true"]:hover {
  background: #2a2a2d !important;

  box-shadow:
    0 7px 20px rgba(0, 0, 0, .12) !important;
}


/*
 * Existing React portal is retained.
 * These rules ensure nothing archived can visually suppress it.
 */
[data-st-product-lightbox="true"] {
  position: fixed !important;
  inset: 0 !important;

  z-index: 2147483000 !important;

  display: grid !important;
  grid-template-rows: auto 1fr auto !important;

  width: 100vw !important;
  height: 100dvh !important;

  background:
    rgba(250, 250, 250, .985) !important;

  opacity: 1 !important;
  visibility: visible !important;

  overflow: hidden !important;

  animation:
    stActiveLightboxIn 220ms
    var(--st-active-ease)
    both !important;
}

[data-st-product-lightbox="true"] > header {
  position: relative !important;
  z-index: 3 !important;
}

[data-st-product-lightbox="true"] img {
  max-width: min(86vw, 1200px) !important;
  max-height: 78dvh !important;

  width: auto !important;
  height: auto !important;

  object-fit: contain !important;
}

@keyframes stActiveLightboxIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}


/* =========================================================
   3. AI ASSISTANT — ALWAYS BREATHING FROM FIRST PAINT
   ========================================================= */

/*
 * The data attributes are now attached DIRECTLY to the active JSX.
 * Archived class selectors can no longer prevent these rules
 * from targeting the correct element.
 */
button[data-st-ai-launcher="true"] {
  position: fixed !important;

  isolation: isolate !important;

  overflow: visible !important;

  background: transparent !important;

  transform: translate3d(0, 0, 0);

  animation:
    stActiveAiFloat 3.65s
    ease-in-out
    infinite !important;

  transition:
    filter 180ms var(--st-active-ease),
    border-color 180ms var(--st-active-ease) !important;

  will-change: transform !important;
}


/*
 * Kill generated circles only.
 * The REAL DOM pulse elements below are retained.
 */
button[data-st-ai-launcher="true"]::before,
button[data-st-ai-launcher="true"]::after {
  content: none !important;
  display: none !important;
}


/*
 * Critical:
 * the pulses are ABOVE the transparent button root,
 * but BELOW the clean white bot surface.
 *
 * This avoids the old negative-z-index problem where the glow
 * could disappear behind the page until the button was interacted with.
 */
button[data-st-ai-launcher="true"]
[data-st-ai-glow] {
  position: absolute !important;

  display: block !important;

  left: 50% !important;
  top: 50% !important;

  border-radius: 999px !important;

  pointer-events: none !important;

  transform-origin: center !important;

  z-index: 0 !important;

  opacity: 1;

  visibility: visible !important;
}


button[data-st-ai-launcher="true"]
[data-st-ai-glow="outer"] {
  width: 104px !important;
  height: 104px !important;

  margin-left: -52px !important;
  margin-top: -52px !important;

  background:
    radial-gradient(
      circle,
      rgba(245, 179, 53, .42) 0%,
      rgba(245, 179, 53, .26) 27%,
      rgba(245, 179, 53, .13) 48%,
      rgba(245, 179, 53, .045) 66%,
      rgba(245, 179, 53, 0) 78%
    ) !important;

  filter:
    blur(7px) !important;

  animation:
    stActiveAiOuterBreath 2.75s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity,
    filter !important;
}


button[data-st-ai-launcher="true"]
[data-st-ai-glow="inner"] {
  width: 82px !important;
  height: 82px !important;

  margin-left: -41px !important;
  margin-top: -41px !important;

  border:
    1px solid
    rgba(245, 179, 53, .16) !important;

  background:
    radial-gradient(
      circle,
      rgba(245, 179, 53, .22) 0%,
      rgba(245, 179, 53, .105) 47%,
      rgba(245, 179, 53, 0) 74%
    ) !important;

  filter:
    blur(2px) !important;

  animation:
    stActiveAiInnerBreath 2.75s
    .10s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;

  will-change:
    transform,
    opacity !important;
}


/*
 * Keep the ONE clean white clickable surface over the light.
 */
button[data-st-ai-launcher="true"]
.st3-ai-launcher__icon {
  position: relative !important;

  z-index: 3 !important;

  display: grid !important;
  place-items: center !important;

  margin: 0 !important;

  border-radius: 999px !important;

  background:
    rgba(255, 255, 255, .98) !important;

  box-shadow:
    0 7px 24px rgba(29, 29, 31, .08),
    0 0 0 1px rgba(29, 29, 31, .08) !important;
}

button[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::before,
button[data-st-ai-launcher="true"]
.st3-ai-launcher__icon::after {
  content: none !important;
  display: none !important;
}

button[data-st-ai-launcher="true"]
.st3-ai-launcher__icon svg {
  position: static !important;

  display: block !important;

  margin: 0 auto !important;

  transform: none !important;
}


/*
 * Hover does NOT start the glow.
 * It is already running before interaction.
 */
button[data-st-ai-launcher="true"]:hover
[data-st-ai-glow="outer"],
button[data-st-ai-launcher="true"]:focus-visible
[data-st-ai-glow="outer"],
button[data-st-ai-launcher="true"]:active
[data-st-ai-glow="outer"],
button[data-st-ai-launcher="true"].st3-ai-launcher--open
[data-st-ai-glow="outer"] {
  animation:
    stActiveAiOuterBreath 2.75s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


button[data-st-ai-launcher="true"]:hover
[data-st-ai-glow="inner"],
button[data-st-ai-launcher="true"]:focus-visible
[data-st-ai-glow="inner"],
button[data-st-ai-launcher="true"]:active
[data-st-ai-glow="inner"],
button[data-st-ai-launcher="true"].st3-ai-launcher--open
[data-st-ai-glow="inner"] {
  animation:
    stActiveAiInnerBreath 2.75s
    .10s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


button[data-st-ai-launcher="true"]:hover,
button[data-st-ai-launcher="true"]:focus-visible,
button[data-st-ai-launcher="true"]:active,
button[data-st-ai-launcher="true"].st3-ai-launcher--open {
  animation:
    stActiveAiFloat 3.65s
    ease-in-out
    infinite !important;
}


@keyframes stActiveAiOuterBreath {
  0%,
  100% {
    opacity: .20;
    transform: scale(.72);
    filter: blur(7px);
  }

  42% {
    opacity: .94;
    transform: scale(1.10);
    filter: blur(8px);
  }

  58% {
    opacity: .72;
    transform: scale(1.19);
    filter: blur(10px);
  }
}


@keyframes stActiveAiInnerBreath {
  0%,
  100% {
    opacity: .18;
    transform: scale(.86);
  }

  48% {
    opacity: .77;
    transform: scale(1.10);
  }

  64% {
    opacity: .46;
    transform: scale(1.17);
  }
}


@keyframes stActiveAiFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }

  50% {
    transform: translate3d(0, -5px, 0);
  }
}


/* =========================================================
   4. HEADER — PREMIUM OPEN/CLOSE
   ========================================================= */

.st3-header__nav-item,
.st3-header__icon {
  transition:
    color 180ms var(--st-active-ease),
    background-color 180ms var(--st-active-ease),
    border-color 180ms var(--st-active-ease),
    opacity 180ms var(--st-active-ease) !important;
}


/*
 * Real active mega-menu architecture from v3-header.tsx:
 * st3-mega + --open / --closing / --closed
 */
.st3-mega {
  transform-origin:
    50% 0 !important;

  transition:
    opacity 260ms var(--st-active-ease),
    transform 260ms var(--st-active-ease),
    visibility 260ms linear !important;

  will-change:
    opacity,
    transform !important;
}


.st3-mega--closed {
  opacity: 0 !important;

  transform:
    translate3d(0, -8px, 0)
    scaleY(.985) !important;

  visibility:
    hidden !important;

  pointer-events:
    none !important;
}


.st3-mega--closing {
  opacity: 0 !important;

  transform:
    translate3d(0, -5px, 0)
    scaleY(.99) !important;

  visibility:
    visible !important;

  pointer-events:
    none !important;
}


.st3-mega--open {
  opacity: 1 !important;

  transform:
    translate3d(0, 0, 0)
    scaleY(1) !important;

  visibility:
    visible !important;

  pointer-events:
    auto !important;
}


.st3-mega__inner--switch {
  transition:
    opacity 210ms var(--st-active-ease),
    transform 210ms var(--st-active-ease) !important;
}


.st3-mega :is(
  .st3-mega__primary-link,
  .st3-mega__secondary-link
) {
  transition:
    color 170ms var(--st-active-ease),
    opacity 170ms var(--st-active-ease),
    transform 170ms var(--st-active-ease) !important;
}


.st3-mega :is(
  .st3-mega__primary-link,
  .st3-mega__secondary-link
):hover {
  transform:
    translate3d(3px, 0, 0) !important;
}


.st3-header__scrim--v3 {
  transition:
    opacity 250ms var(--st-active-ease),
    visibility 250ms linear !important;
}


/* =========================================================
   5. BUTTON / CONTROL POLISH
   ========================================================= */

/*
 * No global transform on every button.
 * That previously caused View larger and other controls to jump.
 */
:is(
  .st3-header,
  .st-retail-shop,
  .st-product-v5,
  .st3-ai-panel
) :is(
  button,
  a,
  select,
  input
) {
  transition-duration: 180ms;
  transition-timing-function: var(--st-active-ease);
}


:is(
  .st-retail-shop,
  .st-product-v5,
  .st3-ai-panel
) button:not(
  [data-st-view-larger="true"]
):active {
  filter:
    brightness(.97);
}


/* =========================================================
   6. SHOP FILTER — SMOOTHER STATE
   ========================================================= */

.st-filter-v4__pill,
.st-filter-v4__search-button,
.st-filter-v4__select,
.st-filter-v4__sort {
  transition:
    background-color 210ms var(--st-active-ease),
    border-color 210ms var(--st-active-ease),
    color 210ms var(--st-active-ease),
    box-shadow 210ms var(--st-active-ease) !important;
}


.st-filter-v4__stock-dot {
  background:
    var(--st-active-mustard) !important;

  transition:
    background-color 180ms var(--st-active-ease),
    box-shadow 180ms var(--st-active-ease),
    transform 180ms var(--st-active-ease) !important;
}


.st-filter-v4__pill.is-active
.st-filter-v4__stock-dot {
  background:
    var(--st-active-mustard) !important;

  box-shadow:
    0 0 0 4px
    rgba(245, 179, 53, .11) !important;
}


/* =========================================================
   7. PRODUCT CARD — SMOOTH SECOND IMAGE
   ========================================================= */

.st-retail-card__image {
  transition:
    opacity 380ms var(--st-active-ease),
    filter 380ms var(--st-active-ease) !important;

  transform:
    none !important;
}


.st-retail-card__image--primary {
  opacity: 1;
}


.st-retail-card__image--secondary {
  opacity: 0;
}


.st-retail-card:hover
.st-retail-card__image--primary {
  opacity: 0 !important;
}


.st-retail-card:hover
.st-retail-card__image--secondary {
  opacity: 1 !important;
}


/*
 * Existing NEW badge glow remains.
 * Keep its successful breathing behavior.
 */
.st-retail-card__badge--new {
  animation:
    stMustardBadgeBreath
    2.9s
    cubic-bezier(.4, 0, .2, 1)
    infinite !important;
}


/* =========================================================
   8. SHOP TOP GAP — REDUCE USELESS WHITE SPACE
   ========================================================= */

.st-retail-shop-v4 {
  padding-top:
    0 !important;
}


.st-retail-shop-v4
.st-v2-shop-body {
  padding-top:
    clamp(34px, 4vw, 58px) !important;
}


.st-retail-shop-v4
.st-v2-container {
  margin-top:
    0 !important;
}


/*
 * Avoid inherited giant top spacers from archived shop versions.
 */
.st-retail-shop-v4 > :first-child,
.st-retail-shop-v4
.st-v2-shop-body > :first-child {
  margin-top:
    0 !important;
}


/* =========================================================
   9. STORE CONTENT ARRIVAL AFTER FILTER QUERY
   ========================================================= */

@keyframes stActiveCatalogRefresh {
  from {
    opacity: .72;
  }

  to {
    opacity: 1;
  }
}


.st-retail-shop-v4 :is(
  .st-v2-shop-grid,
  .st-retail-shop__grid,
  .st-v2-shop-results
) {
  animation:
    stActiveCatalogRefresh
    220ms
    var(--st-active-ease)
    both;
}


/* =========================================================
   10. ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .st3-mega,
  .st3-mega__inner--switch,
  .st-retail-card__image {
    transition-duration:
      1ms !important;
  }

  /*
   * Keep the assistant visually emphasized but remove travel
   * if the customer explicitly requests reduced motion.
   */
  button[data-st-ai-launcher="true"] {
    animation:
      none !important;
  }
}


/* === ST ACTIVE INTERACTION REPAIR 20260819 END === */

/* === ST FINAL PRODUCT LIGHTBOX START === */

/*
 * Authoritative fullscreen product-image viewer.
 *
 * This overrides previous archived gallery/lightbox styling
 * WITHOUT changing the normal product page gallery.
 */

[data-st-product-lightbox="true"] {
  position: fixed !important;
  inset: 0 !important;

  width: 100vw !important;
  height: 100dvh !important;
  max-width: none !important;
  max-height: none !important;

  z-index: 2147483000 !important;

  margin: 0 !important;
  padding: 0 !important;

  display: block !important;

  overflow: hidden !important;

  background:
    rgba(250, 250, 250, 0.985) !important;

  opacity: 1 !important;
  visibility: visible !important;

  color: #1d1d1f !important;

  isolation: isolate !important;

  animation:
    stFinalLightboxEnter
    220ms
    cubic-bezier(.22, .61, .36, 1)
    both !important;
}


/* ---------------------------------------------------------
   SCRIMS / OLD BACKDROPS
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]::before {
  content: none !important;
  display: none !important;
}


/* ---------------------------------------------------------
   RESET OLD LAYOUT CONSTRAINTS
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] * {
  box-sizing: border-box;
}


[data-st-product-lightbox="true"] > * {
  max-width: none;
}


/* ---------------------------------------------------------
   MAIN IMAGE
   --------------------------------------------------------- */

/*
 * The fullscreen product photo must NEVER exceed the viewport.
 * This is the most important fix for the screenshot you sent.
 */
[data-st-product-lightbox="true"] img {
  max-width: min(76vw, 1100px) !important;
  max-height: 72dvh !important;

  width: auto !important;
  height: auto !important;

  object-fit: contain !important;

  margin: 0 !important;

  transform: none !important;
  scale: 1 !important;

  user-select: none !important;

  filter:
    drop-shadow(
      0 24px 46px
      rgba(29, 29, 31, .09)
    ) !important;
}


/*
 * The largest/main visual sits dead center.
 */
[data-st-product-lightbox="true"]
:is(
  figure,
  [class*="stage"],
  [class*="visual"],
  [class*="main"],
  [class*="image-wrap"],
  [class*="imageWrap"]
) {
  position: absolute !important;

  inset: 76px 96px 118px !important;

  display: grid !important;
  place-items: center !important;

  width: auto !important;
  height: auto !important;

  padding: 0 !important;
  margin: 0 !important;

  background: transparent !important;

  overflow: visible !important;
}


/* If image is a direct child rather than wrapped. */
[data-st-product-lightbox="true"] > img {
  position: absolute !important;

  left: 50% !important;
  top: 50% !important;

  transform:
    translate(-50%, -50%) !important;
}


/* ---------------------------------------------------------
   HEADER / PRODUCT NAME
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
:is(
  header,
  [class*="topbar"],
  [class*="header"]
) {
  position: absolute !important;

  left: 32px !important;
  right: 32px !important;
  top: 24px !important;

  z-index: 20 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;

  min-height: 44px !important;

  margin: 0 !important;
  padding: 0 !important;

  border: 0 !important;

  background: transparent !important;
}


[data-st-product-lightbox="true"]
:is(
  header,
  [class*="topbar"],
  [class*="header"]
)
:is(
  h1,
  h2,
  h3,
  strong,
  p,
  span
) {
  margin: 0 !important;

  color: #1d1d1f !important;

  font-size: 13px !important;
  font-weight: 600 !important;
  line-height: 1.25 !important;

  letter-spacing: 0 !important;
}


/* ---------------------------------------------------------
   ALL LIGHTBOX BUTTONS
   --------------------------------------------------------- */

[data-st-product-lightbox="true"] button {
  position: relative;

  z-index: 30 !important;

  display: grid !important;
  place-items: center !important;

  width: 44px !important;
  height: 44px !important;

  min-width: 44px !important;
  min-height: 44px !important;

  padding: 0 !important;
  margin: 0 !important;

  border:
    1px solid
    rgba(29, 29, 31, .09) !important;

  border-radius: 999px !important;

  background:
    rgba(255, 255, 255, .92) !important;

  color: #1d1d1f !important;

  box-shadow:
    0 8px 24px
    rgba(29, 29, 31, .075) !important;

  backdrop-filter:
    blur(18px) saturate(130%) !important;

  -webkit-backdrop-filter:
    blur(18px) saturate(130%) !important;

  cursor: pointer !important;

  transform: none !important;
  translate: none !important;
  scale: 1 !important;

  transition:
    background-color 160ms cubic-bezier(.22,.61,.36,1),
    border-color 160ms cubic-bezier(.22,.61,.36,1),
    box-shadow 160ms cubic-bezier(.22,.61,.36,1),
    color 160ms cubic-bezier(.22,.61,.36,1) !important;
}


[data-st-product-lightbox="true"] button:hover {
  background:
    #ffffff !important;

  border-color:
    rgba(245, 179, 53, .42) !important;

  box-shadow:
    0 10px 30px
    rgba(29, 29, 31, .10),
    0 0 0 4px
    rgba(245, 179, 53, .07) !important;

  transform: none !important;
  translate: none !important;
  scale: 1 !important;
}


[data-st-product-lightbox="true"] button:active {
  filter: brightness(.97) !important;

  transform: none !important;
  translate: none !important;
}


/* SVG consistency */
[data-st-product-lightbox="true"] button svg {
  width: 18px !important;
  height: 18px !important;

  stroke-width: 1.7 !important;
}


/* ---------------------------------------------------------
   CLOSE BUTTON — TOP RIGHT
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="Close"],
  [aria-label*="close"]
) {
  position: absolute !important;

  top: 24px !important;
  right: 28px !important;

  left: auto !important;
  bottom: auto !important;
}


/* ---------------------------------------------------------
   PREVIOUS BUTTON — LEFT CENTER
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="Previous"],
  [aria-label*="previous"],
  [aria-label*="Prev"],
  [aria-label*="prev"]
) {
  position: absolute !important;

  left: 30px !important;
  top: 50% !important;

  right: auto !important;
  bottom: auto !important;

  transform:
    translateY(-50%) !important;
}


[data-st-product-lightbox="true"]
button:is(
  [aria-label*="Previous"],
  [aria-label*="previous"],
  [aria-label*="Prev"],
  [aria-label*="prev"]
):hover {
  transform:
    translateY(-50%) !important;
}


/* ---------------------------------------------------------
   NEXT BUTTON — RIGHT CENTER
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
button:is(
  [aria-label*="Next"],
  [aria-label*="next"]
) {
  position: absolute !important;

  right: 30px !important;
  top: 50% !important;

  left: auto !important;
  bottom: auto !important;

  transform:
    translateY(-50%) !important;
}


[data-st-product-lightbox="true"]
button:is(
  [aria-label*="Next"],
  [aria-label*="next"]
):hover {
  transform:
    translateY(-50%) !important;
}


/* ---------------------------------------------------------
   IMAGE COUNTER
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
:is(
  [class*="counter"],
  [class*="count"],
  [class*="pagination"],
  [data-image-count]
) {
  position: absolute !important;

  left: 30px !important;
  bottom: 28px !important;

  z-index: 30 !important;

  display: inline-flex !important;
  align-items: center !important;

  min-height: 34px !important;

  padding: 0 14px !important;

  border:
    1px solid
    rgba(29, 29, 31, .08) !important;

  border-radius: 999px !important;

  background:
    rgba(255, 255, 255, .90) !important;

  color: #1d1d1f !important;

  font-size: 12px !important;
  font-weight: 600 !important;

  box-shadow:
    0 6px 20px
    rgba(29, 29, 31, .06) !important;
}


/* ---------------------------------------------------------
   BOTTOM THUMBNAILS
   --------------------------------------------------------- */

[data-st-product-lightbox="true"]
:is(
  [class*="thumbs"],
  [class*="thumbnail-list"],
  [class*="thumbnails"]
) {
  position: absolute !important;

  left: 50% !important;
  bottom: 24px !important;

  z-index: 25 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  gap: 8px !important;

  width: auto !important;

  margin: 0 !important;
  padding: 7px !important;

  border:
    1px solid
    rgba(29, 29, 31, .07) !important;

  border-radius: 16px !important;

  background:
    rgba(255, 255, 255, .88) !important;

  box-shadow:
    0 9px 30px
    rgba(29, 29, 31, .065) !important;

  backdrop-filter:
    blur(18px) !important;

  transform:
    translateX(-50%) !important;
}


[data-st-product-lightbox="true"]
:is(
  [class*="thumb"],
  [class*="thumbnail"]
)
img {
  width: 48px !important;
  height: 48px !important;

  max-width: 48px !important;
  max-height: 48px !important;

  object-fit: contain !important;

  filter: none !important;
}


/* ---------------------------------------------------------
   CLEAN FULLSCREEN ANIMATION
   --------------------------------------------------------- */

@keyframes stFinalLightboxEnter {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}


/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 767px) {

  [data-st-product-lightbox="true"]
  :is(
    figure,
    [class*="stage"],
    [class*="visual"],
    [class*="main"],
    [class*="image-wrap"],
    [class*="imageWrap"]
  ) {
